---
interface Props { caption: string; headers: string[]; rows: string[][] }
const { caption, headers, rows } = Astro.props;
---
<div class="reference-table" role="region" aria-label={caption} tabindex="0">
  <table>
    <caption>{caption}</caption>
    <thead><tr>{headers.map((header) => <th scope="col">{header}</th>)}</tr></thead>
    <tbody>{rows.map((row) => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
  </table>
</div>
<style>
  .reference-table { margin: 28px 0; overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; }
  table { border-collapse: collapse; width: 100%; min-width: 530px; font-size: .78rem; line-height: 1.6; }
  caption { text-align: left; padding: 16px; color: var(--cyan); font-family: var(--mono); font-size: .7rem; }
  th, td { padding: 14px 16px; text-align: left; vertical-align: top; border-top: 1px solid var(--border); }
  th { color: var(--text); font-weight: 500; }
  thead th { background: var(--surface); }
  td { color: var(--muted); }
</style>
