---
import { SIGN, codes, districts, familyOf, place, factory } from './http-codes';
/** Roads leave the server at the centre and end at a district's edge. The lit one is the selected family's. */
const HUB = { x: 520, y: 330 };
const roads: Record<number, string> = {
  1: `M162 ${HUB.y} V240`,
  2: `M${HUB.x} ${HUB.y} V200`,
  3: `M${HUB.x} ${HUB.y} H780 Q820 ${HUB.y} 820 290 V250`,
  4: `M${HUB.x} ${HUB.y} L430 452`,
  5: `M${HUB.x} ${HUB.y} L640 400`,
};
const spoken = districts.map((district) => `${district.family}xx, ${district.name}, ${district.means}: ${codes.filter((code) => familyOf(code) === district.family).map((code) => `${code.code} ${code.phrase}`).join(', ')}.`).join(' ');
---
<svg class="city-map" data-city-map viewBox="0 0 1040 720" role="group" aria-labelledby="city-map-title city-map-desc">
  <title id="city-map-title">HTTP status codes as a city map</title>
  <desc id="city-map-desc">A request travels from the browser to the server at the centre. Roads lead from there to five districts, one for each first digit. {spoken} In The Factory, 502, 503 and 504 hang on the front office, which is the proxy, and 500 on the workshop behind it, which is the app.</desc>
  <g aria-hidden="true">
    <path class="city-river" d="M0 395 C160 340 300 440 520 392 S860 300 1040 350" />
    <path class="city-road is-main" d={`M104 ${HUB.y} H${HUB.x}`} />
    {districts.map((district) => <path class={`city-road is-f${district.family}`} d={roads[district.family]} />)}
    <rect class="city-you" x="22" y={HUB.y - 17} width="82" height="34" rx="17" />
    <text class="city-you-label" x="63" y={HUB.y + 4.5} text-anchor="middle">browser</text>
    <text class="city-road-label" x="330" y={HUB.y - 10} text-anchor="middle">a request</text>
    <circle class="city-hub" cx={HUB.x} cy={HUB.y} r="29" />
    <text class="city-hub-label" x={HUB.x} y={HUB.y + 4} text-anchor="middle">server</text>
    <text class="city-road-label" x={HUB.x + 40} y={HUB.y - 12}>picks one sign</text>
    <text class="city-road-label" x="172" y="290">notes on the way in</text>
  </g>
  {districts.map((district) => {
    const { x, y, w, h } = district.box;
    return <g class={`city-district is-f${district.family}`}>
      <rect class="city-ground" x={x} y={y} width={w} height={h} rx="14" />
      <text class="city-digit" x={x + 16} y={y + 31}>{district.family}xx</text>
      <text class="city-name" x={x + 70} y={y + 25}>{district.name}</text>
      <text class="city-means" x={x + 70} y={y + 42}>{district.means}</text>
      <path class="city-icon" d={district.icon} transform={`translate(${x + w - 50} ${y + 14})`} aria-hidden="true" />
      {district.family === 5 && <g aria-hidden="true">
        {[factory.office, factory.shop].map((block) => <>
          <rect class="city-block" x={block.x} y={block.y} width={block.w} height={block.h} rx="8" />
          <text class="city-block-label" x={block.x + 12} y={block.y + 20}>{block.label}</text>
          <text class="city-block-sub" x={block.x + 12} y={block.y + 35}>{block.sub}</text>
        </>)}
        <path class="city-handoff" d={`M${factory.office.x + factory.office.w + 6} ${factory.office.y + 110} H${factory.shop.x - 12}`} marker-end="url(#city-arrow)" />
        <text class="city-road-label" x={(factory.office.x + factory.office.w + factory.shop.x) / 2} y={factory.office.y + 100} text-anchor="middle">passes it on</text>
      </g>}
    </g>;
  })}
  <defs><marker id="city-arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path class="city-arrowhead" d="M1 1 L9 5 L1 9 Z" /></marker></defs>
  {codes.map((code, index) => {
    const at = place(code);
    return <a class={`city-sign is-f${familyOf(code)}`} href={`#code-${code.code}`} data-city-sign={index} aria-label={`${code.code} ${code.phrase}`}>
      <rect x={at.x} y={at.y} width={SIGN.w} height={SIGN.h} rx="6" />
      <path class="city-pin" d={`M${at.x} ${at.y + 15} V${at.y + 6} a6 6 0 0 1 6 -6 H${at.x + 15} Z`} />
      <text class="city-code-number" x={at.x + SIGN.w / 2} y={at.y + 20} text-anchor="middle">{code.code}</text>
      <text class="city-code-phrase" x={at.x + SIGN.w / 2} y={at.y + 35} text-anchor="middle" textLength={code.phrase.length > 19 ? SIGN.w - 14 : undefined} lengthAdjust="spacingAndGlyphs">{code.phrase}</text>
    </a>;
  })}
</svg>
