---
import { collections } from '../lib/catalog';
---

<section class="collection-nav shell" aria-labelledby="collections-heading">
  <div class="section-heading">
    <span>Browse by collection</span>
    <h2 id="collections-heading">Choose the system you’re tracing.</h2>
  </div>
  <div class="collection-grid">
    {Object.entries(collections).map(([slug, item], index) => (
      <a class={`collection-tile collection-${slug}`} href={`/${slug}`}>
        <span class="tile-index">0{index + 1}</span>
        <span class="tile-copy">
          <strong>{item.label}</strong>
          <small>{item.eyebrow}</small>
        </span>
        <span class="tile-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</section>
