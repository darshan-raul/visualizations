---
import { actors, flows, faults, type ActorId, type EdgeKind } from './api-server-data';
interface Props { mapId: string; depth?: 'foundation' | 'practitioner' | 'internals'; mode?: 'overview' | 'full'; caption?: string; }
const { mapId, depth = 'foundation', mode = 'full', caption = 'Clients, reconcilers and node agents coordinate through API state. Select one to isolate its relationship.' } = Astro.props;
const positions: Record<ActorId, [number, number]> = {
  client: [600, 76], endpoint: [600, 176], api: [600, 330], etcd: [600, 440],
  controller: [355, 330], scheduler: [845, 330], 'node-a': [355, 580], 'node-b': [845, 580],
  runtime: [600, 580], pod: [600, 680], proxy: [125, 650], csi: [125, 530], cloud: [125, 410],
  provider: [1075, 500], operator: [125, 290], webhook: [1075, 330], metrics: [1075, 90], aggregated: [1075, 210],
};
const baseline = new Set(['client:api:api','controller:api:watch','controller:api:api','scheduler:api:watch','scheduler:api:api','node-a:api:watch','node-a:api:status','api:etcd:store']);
const edgeMap = new Map<string, { from: ActorId; to: ActorId; kind: EdgeKind; label: string }>();
for (const step of [...flows.flatMap((flow) => flow.steps), ...faults.flatMap((fault) => fault.steps)]) {
  if (step.from === step.to) continue;
  const key = `${step.from}:${step.to}:${step.kind}`;
  if (!edgeMap.has(key)) edgeMap.set(key, { from: step.from, to: step.to, kind: step.kind, label: step.operation });
}
for (const [from,to,kind,label] of [
  ['client','api','api','Kubernetes API request'],['controller','api','watch','LIST/WATCH API state'],['controller','api','api','CREATE/PATCH API objects'],['scheduler','api','watch','WATCH unscheduled Pods'],['scheduler','api','api','BIND Pod via API'],['node-a','api','watch','WATCH assigned Pods'],['node-a','api','status','PATCH Pod/Node status'],['api','etcd','store','Persist durable API state'],
] as [ActorId,ActorId,EdgeKind,string][]) edgeMap.set(`${from}:${to}:${kind}`, { from,to,kind,label });
const edges = [...edgeMap.values()].map((edge) => {
  const [x1,y1] = positions[edge.from], [x2,y2] = positions[edge.to];
  const dx=x2-x1, dy=y2-y1, length=Math.hypot(dx,dy) || 1;
  const offset = edge.kind === 'watch' ? -15 : edge.kind === 'status' ? 15 : edge.kind === 'api' && edge.from === 'controller' ? 16 : 0;
  const midX=(x1+x2)/2 + (-dy/length)*offset, midY=(y1+y2)/2 + (dx/length)*offset;
  // Terminate at the node perimeter so arrowheads remain visible instead of
  // disappearing beneath cards. These dimensions match the full-map CSS.
  const port = (id: ActorId, x: number, y: number, tx: number, ty: number) => {
    const halfWidth = id === 'api' || id === 'client' ? 110 : 95;
    const vx = tx - x, vy = ty - y;
    const fraction = Math.min(halfWidth / (Math.abs(vx) || 1e-9), 38 / (Math.abs(vy) || 1e-9));
    return [x + vx * fraction, y + vy * fraction];
  };
  const [sx,sy] = port(edge.from,x1,y1,midX,midY);
  const [ex,ey] = port(edge.to,x2,y2,midX,midY);
  // The endpoint sits between clients and the API. Direct client/API paths
  // need their own lane rather than passing through that separate actor.
  if ((edge.from === 'client' && edge.to === 'api') || (edge.from === 'api' && edge.to === 'client')) {
    return { ...edge, key:`${edge.from}:${edge.to}:${edge.kind}`, path:`M 710 ${y1} H 740 V ${y2} H 710`, midX:740, midY:260, baseline:baseline.has(`${edge.from}:${edge.to}:${edge.kind}`) };
  }
  return { ...edge, key:`${edge.from}:${edge.to}:${edge.kind}`, path:`M ${sx} ${sy} Q ${midX} ${midY} ${ex} ${ey}`, midX, midY, baseline:baseline.has(`${edge.from}:${edge.to}:${edge.kind}`) };
});
const actorById = Object.fromEntries(actors.map((actor) => [actor.id, actor]));
const edgeTag = (kind: EdgeKind, from: ActorId) => kind === 'api' && from === 'scheduler' ? 'BIND' : kind === 'api' && from === 'controller' ? 'WRITE' : kind === 'store' ? 'PERSIST' : kind.toUpperCase();
const overviewPositions: Partial<Record<ActorId, [number, number]>> = {
  client:[135,210], api:[430,210], etcd:[430,342], controller:[755,82], scheduler:[755,210], 'node-a':[755,338],
};
const overviewLabels: Partial<Record<ActorId, [string, string]>> = {
  client:['kubectl · CI · GitOps','declare and inspect'], api:['kube-apiserver','shared API surface'], etcd:['etcd','durable backing state'],
  controller:['Controller manager','reconciliation loops'], scheduler:['Scheduler','records placement'], 'node-a':['Kubelets','execute assigned Pods'],
};
const overviewConnections: [ActorId,ActorId,EdgeKind,string][] = [
  ['client','api','api','API'],['controller','api','watch','WATCH'],['scheduler','api','watch','WATCH'],['node-a','api','status','STATUS'],['api','etcd','store','PERSIST'],
];
const overviewEdges = overviewConnections.map(([from,to,kind,label]) => {
  const [x1,y1] = overviewPositions[from]!, [x2,y2] = overviewPositions[to]!;
  return { from,to,kind,label,key:`${from}:${to}:${kind}`,path:`M ${x1} ${y1} L ${x2} ${y2}`,midX:(x1+x2)/2,midY:(y1+y2)/2 };
});
const overviewActors = (['client','api','etcd','controller','scheduler','node-a'] as ActorId[]).map((id) => actorById[id]);
---
<div class="api-map" data-api-map={mapId} data-depth={depth} data-map-mode={mode} role="group" aria-label="Canonical Kubernetes cluster topology">
  <div class="api-map-viewport" tabindex="0" aria-label="Pannable Kubernetes cluster map; scroll horizontally to inspect the full topology on narrow screens">
    {mode === 'overview' ? <div class="api-map-overview-wrap">
      <div class="api-map-overview-scene">
        <span class="api-map-zone zone-clients">API CLIENTS</span><span class="api-map-zone zone-state">SHARED STATE GATEWAY</span><span class="api-map-zone zone-actors">INDEPENDENT ACTORS</span>
        <svg class="api-map-overview-wires" viewBox="0 0 900 410" aria-hidden="true" focusable="false">
          <defs>{(['api','watch','status','store'] as EdgeKind[]).map((kind) => <marker id={`${mapId}-${kind}-arrow`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" class={`marker-${kind}`} /></marker>)}</defs>
          {overviewEdges.map((edge) => <path d={edge.path} class:list={['api-map-path',`kind-${edge.kind}`,'is-baseline']} data-map-path={edge.key} marker-end={`url(#${mapId}-${edge.kind}-arrow)`} />)}
        </svg>
        {overviewEdges.map((edge) => <button type="button" class:list={['api-map-edge',`kind-${edge.kind}`]} data-map-edge={edge.key} data-edge-from={edge.from} data-edge-to={edge.to} data-edge-kind={edge.kind} data-edge-label={edge.label} style={`--edge-x:${edge.midX}px;--edge-y:${edge.midY}px`} aria-label={`${actorById[edge.from]?.label} to ${actorById[edge.to]?.label}: ${edge.label}`}>{edge.label}</button>)}
        {overviewActors.map((actor) => <button type="button" class:list={['api-map-actor',`actor-${actor.id}`]} data-map-actor={actor.id} data-actor-tier={actor.tier} style={`--actor-x:${overviewPositions[actor.id]![0]}px;--actor-y:${overviewPositions[actor.id]![1]}px`} aria-pressed="false" title={actor.role}><span>{overviewLabels[actor.id]?.[0] ?? actor.label}</span><small>{overviewLabels[actor.id]?.[1] ?? actor.short}</small></button>)}
      </div>
      <div class="api-map-overview-status" aria-live="polite" data-map-current>Selected path: clients → kube-apiserver</div>
    </div> : <div class="api-map-full-wrap"><div class="api-map-scene">
        <div class="api-map-boundary api-map-outside"><span>OUTSIDE CLUSTER · HUMAN / AUTOMATION</span></div>
        <div class="api-map-boundary api-map-control"><span>CONTROL PLANE · SHARED API STATE</span></div>
        <div class="api-map-boundary api-map-workers"><span>WORKER NODES · EXECUTION / DATA PLANE</span></div>
        <div class="api-map-boundary api-map-external"><span>EXTERNAL / EXTENSIONS</span></div>
        <svg class="api-map-wires" viewBox="0 0 1200 740" aria-hidden="true" focusable="false">
          <defs>{(['api','watch','status','external','local','data','store','special'] as EdgeKind[]).map((kind) => <marker id={`${mapId}-${kind}-arrow`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" class={`marker-${kind}`} /></marker>)}</defs>
          {edges.map((edge) => <path d={edge.path} class:list={['api-map-path',`kind-${edge.kind}`,edge.baseline && 'is-baseline']} data-map-path={edge.key} marker-end={`url(#${mapId}-${edge.kind}-arrow)`} />)}
        </svg>
        {edges.map((edge) => <button type="button" class:list={['api-map-edge',`kind-${edge.kind}`,edge.baseline && 'is-baseline']} data-map-edge={edge.key} data-edge-from={edge.from} data-edge-to={edge.to} data-edge-kind={edge.kind} data-edge-label={edge.label} style={`--edge-x:${edge.midX}px;--edge-y:${edge.midY}px`} aria-label={`${actorById[edge.from]?.label} to ${actorById[edge.to]?.label}: ${edge.label}`}>{edgeTag(edge.kind,edge.from)}</button>)}
        {actors.map((actor) => <button type="button" class:list={['api-map-actor',`actor-${actor.id}`,`tier-${actor.tier}`]} data-map-actor={actor.id} data-actor-tier={actor.tier} style={`--actor-x:${positions[actor.id][0]}px;--actor-y:${positions[actor.id][1]}px`} aria-pressed="false" title={actor.role}><span>{actor.label}</span><small>{actor.short}</small></button>)}
      </div><div class="api-map-full-status" aria-live="polite" data-map-current>Selected path: clients → kube-apiserver</div></div>}
    </div>
  <div class="api-map-legend" aria-label="Connector meanings">
    <span><i class="kind-api"></i>API REQUEST / WRITE</span>
    <span><i class="kind-watch"></i>LIST / WATCH</span>
    <span><i class="kind-status"></i>STATUS / STORED STATE</span>
    {mode === 'full' && <><span><i class="kind-external"></i>EXTERNAL CALL</span><span><i class="kind-data"></i>DATA PLANE</span><span><i class="kind-special"></i>SPECIAL API CALL</span></>}
  </div>
  <p class="api-map-caption">{caption}</p>
</div>
