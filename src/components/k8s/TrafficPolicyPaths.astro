  article.preference-path { border-color: rgba(183,154,255,.25); }
  header { display: flex; justify-content: space-between; gap: 12px; }
  header code { color: var(--cyan); font-size: .65rem; }
  header span { color: var(--dim); font-size: .62rem; }
  .node-row { display: flex; align-items: center; gap: 8px; margin: 14px 0 10px; }
  .node-row b, .node-row del { flex: 1; padding: 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); font-size: .62rem; text-align: center; }
