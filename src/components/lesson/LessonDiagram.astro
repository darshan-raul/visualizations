---
import type { Diagram, Edge, Node, Pic } from './lesson-types';
interface Props { id: string; diagram: Diagram; pic?: Pic }
const { id, diagram, pic = {} } = Astro.props;

const SIZE: Record<Node['kind'], [number, number]> = {
  code: [150, 58], model: [150, 58], tool: [150, 58], kube: [150, 58], store: [150, 58], person: [150, 58],
  terminal: [78, 34], gate: [128, 54], part: [104, 44],
};
const round = (value: number) => Math.round(value * 10) / 10;
const box = (item: Node) => {
  const [w, h] = [item.w ?? SIZE[item.kind][0], item.h ?? SIZE[item.kind][1]];
  return { x: item.x, y: item.y, w, h, cx: item.x + w / 2, cy: item.y + h / 2 };
};
const all = [...diagram.nodes.map((item) => item.id), ...diagram.edges.map((item) => item.id), ...(diagram.zones ?? []).map((item) => item.id)];
const shown = new Set(pic.show ?? all);
const has = (list: string[] | undefined, key: string) => Boolean(list?.includes(key));
const byId = new Map(diagram.nodes.map((item) => [item.id, item]));

type Point = { x: number; y: number };
/** Where the line from a box's centre towards `to` leaves the box. */
const leave = (b: ReturnType<typeof box>, to: Point): Point => {
  const dx = to.x - b.cx;
  const dy = to.y - b.cy;
  const scale = Math.min(dx ? b.w / 2 / Math.abs(dx) : Infinity, dy ? b.h / 2 / Math.abs(dy) : Infinity);
  return { x: b.cx + dx * scale, y: b.cy + dy * scale };
};

const route = (item: Edge) => {
  const a = box(byId.get(item.from)!);
  const b = box(byId.get(item.to)!);
  const shift = item.shift ?? 0;
  let points: Point[];
  if (item.via) {
    const corners = item.via.map(([x, y]) => ({ x, y }));
    points = [leave(a, corners[0]), ...corners, leave(b, corners[corners.length - 1])];
  } else if (a.x < b.x + b.w && b.x < a.x + a.w) {
    // Stacked boxes: a vertical edge between the facing sides.
    const x = (Math.max(a.x, b.x) + Math.min(a.x + a.w, b.x + b.w)) / 2 + shift;
    points = a.cy < b.cy ? [{ x, y: a.y + a.h }, { x, y: b.y }] : [{ x, y: a.y }, { x, y: b.y + b.h }];
  } else if (a.y < b.y + b.h && b.y < a.y + a.h) {
    const y = (Math.max(a.y, b.y) + Math.min(a.y + a.h, b.y + b.h)) / 2 + shift;
    points = a.cx < b.cx ? [{ x: a.x + a.w, y }, { x: b.x, y }] : [{ x: a.x, y }, { x: b.x + b.w, y }];
  } else {
    points = [leave(a, { x: b.cx, y: b.cy }), leave(b, { x: a.cx, y: a.cy })];
  }
  // Stop short of the target so the arrowhead meets the box edge.
  const last = points[points.length - 1];
  const before = points[points.length - 2];
  const length = Math.hypot(last.x - before.x, last.y - before.y) || 1;
  const tip = { x: last.x - ((last.x - before.x) / length) * 5, y: last.y - ((last.y - before.y) / length) * 5 };
  const drawn = [...points.slice(0, -1), tip];
  // The label sits beside the longest segment.
  let best = 0;
  let longest = 0;
  for (let index = 0; index < points.length - 1; index += 1) {
    const span = Math.hypot(points[index + 1].x - points[index].x, points[index + 1].y - points[index].y);
    if (span > longest) { longest = span; best = index; }
  }
  const [p, q] = [points[best], points[best + 1]];
  const mid = { x: (p.x + q.x) / 2, y: (p.y + q.y) / 2 };
  const flat = Math.abs(q.y - p.y) < Math.abs(q.x - p.x);
  const label = flat
    ? { x: mid.x, y: mid.y + (shift > 0 ? 16 : -8), anchor: 'middle' }
    : { x: mid.x + (shift < 0 ? -9 : 9), y: mid.y + 4, anchor: shift < 0 ? 'end' : 'start' };
  return { d: `M${drawn.map((point) => `${round(point.x)} ${round(point.y)}`).join(' L')}`, label, mid };
};

const nodes = diagram.nodes.filter((item) => shown.has(item.id));
const edges = diagram.edges.filter((item) => shown.has(item.id) && shown.has(item.from) && shown.has(item.to)).map((item) => {
  const tone = has(pic.denied, item.id) ? 'denied' : item.kind === 'imagined' ? 'imagined' : has(pic.hot, item.id) ? 'hot' : 'idle';
  return { ...item, ...route(item), tone, text: pic.say?.[item.id] ?? item.label };
});
const zones = (diagram.zones ?? []).filter((item) => shown.has(item.id));
const name = (key: string) => byId.get(key)?.label ?? key;
const spoken = [
  `Shown: ${nodes.map((item) => item.label).join(', ')}.`,
  ...edges.filter((item) => item.tone !== 'idle').map((item) => `${name(item.from)} to ${name(item.to)}${item.text ? `: ${item.text}` : ''}${item.tone === 'denied' ? ' (stopped)' : item.tone === 'imagined' ? ' (no such path)' : ''}.`),
  ...Object.entries(pic.badge ?? {}).map(([key, text]) => `${name(key)}: ${text}.`),
].join(' ');
---
<svg class="lsn-diagram" viewBox={`0 0 ${diagram.width} ${diagram.height}`} style={`max-width:${Math.round(diagram.width * 1.4)}px`} role="img" aria-labelledby={`${id}-title ${id}-desc`}>
  <title id={`${id}-title`}>{diagram.title}</title>
  <desc id={`${id}-desc`}>{spoken}</desc>
  <defs>
    {['idle', 'hot', 'denied', 'imagined'].map((tone) => <marker id={`${id}-arrow-${tone}`} class={`lsn-arrow is-${tone}`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M1 1 L9 5 L1 9 Z" /></marker>)}
  </defs>
  <g aria-hidden="true">
    {zones.map((zone) => <g class:list={['lsn-zone', has(pic.denied, zone.id) && 'is-denied', has(pic.fresh, zone.id) && 'is-fresh']}>
      <rect x={zone.x} y={zone.y} width={zone.w} height={zone.h} rx="12" />
      <text x={zone.x + 10} y={zone.y + 15}>{zone.label}</text>
    </g>)}
    {edges.map((item) => <g class:list={['lsn-edge', `is-${item.tone}`, has(pic.fresh, item.id) && 'is-fresh']}>
      <path class="lsn-edge-line" d={item.d} marker-end={`url(#${id}-arrow-${item.tone})`} />
      {item.tone === 'hot' && <circle class="lsn-packet" r="4.5" style={`offset-path:path('${item.d}')`} />}
      {(item.tone === 'denied' || item.tone === 'imagined') && <text class="lsn-edge-stop" x={round(item.mid.x)} y={round(item.mid.y + 5)} text-anchor="middle">✕</text>}
      {item.text && <text class="lsn-edge-label" x={round(item.label.x)} y={round(item.label.y)} text-anchor={item.label.anchor}>{item.text}</text>}
    </g>)}
    {nodes.map((item) => {
      const b = box(item);
      const tag = pic.badge?.[item.id];
      const tagWidth = tag ? Math.round(tag.length * 6.1 + 14) : 0;
      return <g class:list={['lsn-node', `is-${item.kind}`, has(pic.hot, item.id) && 'is-hot', has(pic.fresh, item.id) && 'is-fresh', has(pic.denied, item.id) && 'is-denied']}>
        {item.kind === 'gate'
          ? <polygon points={`${b.cx},${b.y} ${b.x + b.w},${b.cy} ${b.cx},${b.y + b.h} ${b.x},${b.cy}`} />
          : <rect x={b.x} y={b.y} width={b.w} height={b.h} rx={item.kind === 'terminal' ? b.h / 2 : item.kind === 'model' ? 16 : 7} />}
        {item.kind === 'store' && <path class="lsn-node-shelf" d={`M${b.x + 1} ${b.y + 9} H${b.x + b.w - 1}`} />}
        <text class="lsn-node-label" x={b.cx} y={item.sub ? b.cy - 2 : b.cy + 4.5} text-anchor="middle">{item.label}</text>
        {item.sub && <text class="lsn-node-sub" x={b.cx} y={b.cy + 14} text-anchor="middle">{item.sub}</text>}
        {tag && <g class="lsn-node-tag"><rect x={b.x + b.w - tagWidth + 6} y={b.y - 10} width={tagWidth} height="18" rx="9" /><text x={b.x + b.w - tagWidth / 2 + 6} y={b.y + 3} text-anchor="middle">{tag}</text></g>}
      </g>;
    })}
  </g>
</svg>
