---
import { labs } from './labs';
import '../../styles/asg.css';

const chapters = [
  { id: 'fundamentals', number: '01', title: 'Build the system', short: 'Fundamentals', description: 'Begin with one application answering one customer. Add shared traffic, automatic replacement, startup states, timers, and health evidence in that order.', outcome: 'You can identify each component and explain what “ready” means at its boundary.', labIds: ['v01', 'v02', 'v03', 'v04'] },
  { id: 'demand', number: '02', title: 'Turn demand into a request', short: 'Demand', description: 'See how measurements, alarms, queue depth, schedules, and forecasts ask the group to change its size.', outcome: 'You can identify who asked for a capacity change and what evidence it used.', labIds: ['v05', 'v06', 'v07', 'v08'] },
  { id: 'supply', number: '03', title: 'Find capacity to launch', short: 'Capacity supply', description: 'Follow a request through prepared instances, zones, instance types, purchase choices, Spot supply, and reservations.', outcome: 'You can tell a policy decision from a launch destination or capacity shortage.', labIds: ['v09', 'v10', 'v11', 'v12', 'v13'] },
  { id: 'change', number: '04', title: 'Change the fleet safely', short: 'Fleet changes', description: 'Replace, refresh, protect, park, detach, or rebalance instances while the application continues to need capacity.', outcome: 'You can explain the constraint that lets a planned change proceed or makes it wait.', labIds: ['v14', 'v15', 'v16', 'v17', 'v18'] },
  { id: 'diagnose', number: '05', title: 'Read the incident', short: 'Diagnosis', description: 'Combine the same mechanisms when launches fail or several changes happen at once.', outcome: 'You can locate the first stalled stage and choose evidence that belongs to it.', labIds: ['v19', 'v20'] },
];

const orderedLabIds = chapters.flatMap((chapter) => chapter.labIds);
---

<div class="asg-course" data-asg-course>
  <nav class="asg-chapter-nav" aria-label="Sections in this Auto Scaling explanation">
    <p class="asg-course-kicker">Five visual groups</p>
    <ol>
      {chapters.map((chapter) => (
        <li><a href={`#asg-chapter-${chapter.id}`}><small>{chapter.number}</small><span>{chapter.short}</span></a></li>
      ))}
    </ol>
  </nav>

  {chapters.map((chapter) => (
    <section id={`asg-chapter-${chapter.id}`} class="asg-chapter" aria-labelledby={`${chapter.id}-title`}>
      <header class="asg-chapter-heading">
        <span>Visual group {chapter.number} of 05</span>
        <h3 id={`${chapter.id}-title`}>{chapter.title}</h3>
        <p>{chapter.description}</p>
        <strong>{chapter.outcome}</strong>
      </header>

      {chapter.id === 'fundamentals' && (
        <div class="asg-primer" aria-label="Five visual steps that introduce an Auto Scaling group">
          <article class="asg-primer-visual">
            <header><span>Foundation 01</span><h4>One computer runs the application</h4><p>A customer asks your application for a page. The application runs on an EC2 instance, which is a virtual computer in AWS.</p></header>
            <figure class="asg-primer-flow">
              <div><small>Person</small><strong>Customer</strong><span>Sends a request</span></div>
              <b aria-hidden="true">→</b>
              <div class="cyan"><small>Virtual computer</small><strong>EC2 instance</strong><span>Runs your application</span></div>
              <b aria-hidden="true">→</b>
              <div class="green"><small>Result</small><strong>Response</strong><span>The customer gets the page</span></div>
            </figure>
            <p class="asg-primer-caption">If this computer stops, there is no other application copy to answer the next request.</p>
          </article>

          <article class="asg-primer-visual">
            <header><span>Foundation 02</span><h4>Several copies can share the work</h4><p>Run the same application on several EC2 instances. An Application Load Balancer receives requests and chooses a healthy registered destination.</p></header>
            <figure class="asg-primer-balancer">
              <div class="asg-request-cloud"><span>Request A</span><span>Request B</span><span>Request C</span></div>
              <b aria-hidden="true">↓</b>
              <div class="asg-balancer"><small>Traffic distributor</small><strong>Application Load Balancer</strong></div>
              <b aria-hidden="true">↓</b>
              <div class="asg-app-copies"><span>Application copy 1</span><span>Application copy 2</span><span>Application copy 3</span></div>
            </figure>
            <p class="asg-primer-caption">The load balancer routes traffic. It does not create a new computer when one disappears.</p>
          </article>

          <article class="asg-primer-visual">
            <header><span>Foundation 03</span><h4>Ask an Auto Scaling group to maintain the fleet</h4><p>An Auto Scaling group, or ASG, manages EC2 instances. You give it a desired capacity: the number of instances you want it to maintain.</p></header>
            <figure class="asg-primer-group">
              <div class="asg-desired"><small>Your request</small><strong>Keep 6 instances running</strong><span>This number is desired capacity</span></div>
              <div class="asg-group-boundary">
                <span>Auto Scaling group</span>
                <div><i>EC2</i><i>EC2</i><i>EC2</i><i>EC2</i><i>EC2</i><i class="failed">failed</i></div>
              </div>
              <div class="asg-launch-template"><small>Saved launch instructions</small><strong>Launch template</strong><span>Image, instance type, networking and startup configuration</span></div>
            </figure>
            <p class="asg-primer-caption">The ASG sees five healthy members against a desired count of six, so it uses the launch template to request a replacement.</p>
          </article>

          <article class="asg-primer-visual">
            <header><span>Foundation 04</span><h4>A replacement exists before it is useful</h4><p>A launch request begins a sequence. The virtual computer must be created, boot, start the application, and pass the checks used by this workload.</p></header>
            <figure class="asg-primer-timeline">
              <ol>
                <li class="green"><strong>Five ready</strong><span>Existing copies keep serving</span></li>
                <li class="purple"><strong>Launch requested</strong><span>ASG works toward six</span></li>
                <li class="amber"><strong>Computer starting</strong><span>EC2 exists but the app is preparing</span></li>
                <li class="amber"><strong>Health checking</strong><span>Load balancer waits for a good response</span></li>
                <li class="green"><strong>Six ready</strong><span>The replacement can receive traffic</span></li>
              </ol>
            </figure>
            <p class="asg-primer-caption">Each milestone answers a different question. “EC2 is running” does not yet mean “the application can answer customers.”</p>
          </article>

          <article class="asg-primer-visual">
            <header><span>Foundation 05</span><h4>Now the capacity counts have a meaning</h4><p>Look at the moment when the replacement computer exists but its application is still starting.</p></header>
            <figure class="asg-primer-ledgers">
              <div><small>What did we ask for?</small><strong>Desired · 6</strong><span>The group’s target</span></div>
              <div><small>How many computers exist?</small><strong>Present · 6</strong><span>Five ready + one starting</span></div>
              <div><small>How many can answer now?</small><strong>Serving · 5</strong><span>Only the ready application copies</span></div>
            </figure>
            <p class="asg-primer-caption">The counts disagree because they describe different milestones. Serving becomes six only after the replacement application is ready.</p>
          </article>
        </div>
      )}

      <div class="asg-visual-list">
        {chapter.labIds.map((labId) => {
          const lab = labs.find((item) => item.id === labId)!;
          const absoluteIndex = orderedLabIds.indexOf(lab.id);
          return (
            <article id={lab.id} class:list={['asg-lesson', `asg-${lab.kind}`]} data-lesson={lab.id} data-scenario-index="0" aria-labelledby={`${lab.id}-title`}>
              <header class="asg-lesson-heading">
                <span class="asg-lesson-number">Visual {String(absoluteIndex + 1).padStart(2, '0')} of 20</span>
                <h4 id={`${lab.id}-title`}>{lab.title}</h4>
                <p>{lab.introduction}</p>
              </header>

              <fieldset class="asg-scenario-picker">
                <legend>Choose an example</legend>
                <div>
                  {lab.scenarios.map((scenario, index) => (
                    <button type="button" data-scenario-option={index} aria-pressed={index === 0 ? 'true' : 'false'}>
                      <small>{String(index + 1).padStart(2, '0')}</small>
                      <strong>{scenario.label}</strong>
                      <span>{scenario.summary}</span>
                    </button>
                  ))}
                </div>
              </fieldset>

              <div class="asg-visual" aria-label={`Steps in ${lab.title}`}>
                <p class="asg-scenario-summary" data-summary>{lab.scenarios[0].summary}</p>
                <ol class="asg-nodes" data-nodes>
                  {lab.scenarios[0].nodes.map((node, index) => (
                    <li class={`tone-${node.tone}`} data-node-index={index}>
                      <span>{String(index + 1).padStart(2, '0')}</span>
                      <strong>{node.label}</strong>
                      <small>{node.detail}</small>
                    </li>
                  ))}
                </ol>
                <p class="asg-connector-key"><span></span> Direct sequence <i></i> separate clock or conceptual relationship</p>
              </div>

              <section class="asg-event-explanation" aria-live="polite" aria-atomic="true">
                <header><span data-event-number>Step 1</span><strong data-event-heading>{lab.scenarios[0].nodes[0].label}</strong></header>
                <p data-event-body>{lab.scenarios[0].nodes[0].explanation}</p>
              </section>

              <div class="asg-playback" data-playback hidden>
                <div class="asg-playback-buttons">
                  <button type="button" data-reset>Restart</button>
                  <button type="button" data-previous>← Previous step</button>
                  <button type="button" data-play>Play</button>
                  <button type="button" data-next>Next step →</button>
                </div>
                <p data-status role="status">Step 1 of {lab.scenarios[0].nodes.length}</p>
              </div>

              <aside class="asg-takeaway"><span>Example outcome</span><p data-result>{lab.scenarios[0].result}</p></aside>

              <details class="asg-inspector">
                <summary>Inspect the evidence and effective setting</summary>
                <div>
                  <p><span>Evidence</span><strong data-evidence>{lab.scenarios[0].evidence}</strong></p>
                  <p><span>Setting in play</span><code data-setting>{lab.scenarios[0].setting}</code></p>
                </div>
              </details>

              <details class="asg-inspector asg-transcript">
                <summary>Read every step and alternate example</summary>
                {lab.scenarios.map((scenario) => (
                  <section>
                    <h5>{scenario.label}</h5>
                    <p>{scenario.summary}</p>
                    <ol>{scenario.nodes.map((node) => <li><strong>{node.label}</strong><p>{node.explanation}</p></li>)}</ol>
                  </section>
                ))}
              </details>
            </article>
          );
        })}
      </div>
    </section>
  ))}

  <script is:inline type="application/json" data-course-data set:html={JSON.stringify({ labs })}></script>
</div>

<script>
  type CourseData = { labs: typeof import('./labs').labs };

  for (const root of document.querySelectorAll<HTMLElement>('[data-asg-course]')) {
    const data = JSON.parse(root.querySelector<HTMLScriptElement>('[data-course-data]')!.textContent || '{}') as CourseData;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    root.classList.add('is-enhanced');

    for (const lesson of root.querySelectorAll<HTMLElement>('[data-lesson]')) {
      const lab = data.labs.find((item) => item.id === lesson.dataset.lesson)!;
      let step = 0;
      let timer: number | undefined;

      const scenarioIndex = () => Number(lesson.dataset.scenarioIndex || '0');
      const scenario = () => lab.scenarios[scenarioIndex()];
      const query = <T extends HTMLElement>(selector: string) => lesson.querySelector<T>(selector)!;

      function pause() {
        if (timer !== undefined) window.clearInterval(timer);
        timer = undefined;
        query<HTMLButtonElement>('[data-play]').textContent = 'Play';
      }

      function renderStep() {
        const nodes = [...lesson.querySelectorAll<HTMLElement>('[data-node-index]')];
        const current = scenario().nodes[step];
        nodes.forEach((node, index) => {
          node.classList.toggle('is-reached', index <= step);
          node.classList.toggle('is-current', index === step);
        });
        query('[data-event-number]').textContent = `Step ${step + 1} of ${nodes.length}`;
        query('[data-event-heading]').textContent = current.label;
        query('[data-event-body]').textContent = current.explanation!;
        query<HTMLElement>('.asg-takeaway').hidden = step !== nodes.length - 1;
        query<HTMLButtonElement>('[data-previous]').disabled = step === 0;
        query<HTMLButtonElement>('[data-next]').disabled = step >= nodes.length - 1;
        query<HTMLButtonElement>('[data-play]').disabled = step >= nodes.length - 1 || motion.matches;
        query('[data-status]').textContent = `Step ${step + 1} of ${nodes.length} · ${current.label}`;
        if (step >= nodes.length - 1) pause();
      }

      function renderScenario() {
        const selected = scenario();
        lesson.querySelectorAll<HTMLButtonElement>('[data-scenario-option]').forEach((option) => {
          option.setAttribute('aria-pressed', String(Number(option.dataset.scenarioOption) === scenarioIndex()));
        });
        query('[data-summary]').textContent = selected.summary;
        query('[data-result]').textContent = selected.result;
        query('[data-evidence]').textContent = selected.evidence;
        query('[data-setting]').textContent = selected.setting;
        query<HTMLOListElement>('[data-nodes]').replaceChildren(...selected.nodes.map((node, index) => {
          const item = document.createElement('li');
          item.className = `tone-${node.tone}`;
          item.dataset.nodeIndex = String(index);
          const number = document.createElement('span'); number.textContent = String(index + 1).padStart(2, '0');
          const label = document.createElement('strong'); label.textContent = node.label;
          const detail = document.createElement('small'); detail.textContent = node.detail;
          item.append(number, label, detail);
          return item;
        }));
        step = 0;
        renderStep();
      }

      lesson.querySelectorAll<HTMLButtonElement>('[data-scenario-option]').forEach((option) => {
        option.addEventListener('click', () => {
          pause();
          lesson.dataset.scenarioIndex = option.dataset.scenarioOption || '0';
          renderScenario();
        });
      });
      query<HTMLButtonElement>('[data-reset]').addEventListener('click', () => { pause(); step = 0; renderStep(); });
      query<HTMLButtonElement>('[data-previous]').addEventListener('click', () => { pause(); step = Math.max(0, step - 1); renderStep(); });
      query<HTMLButtonElement>('[data-next]').addEventListener('click', () => { pause(); step += 1; renderStep(); });
      query<HTMLButtonElement>('[data-play]').addEventListener('click', () => {
        if (timer !== undefined) { pause(); return; }
        if (motion.matches) return;
        query<HTMLButtonElement>('[data-play]').textContent = 'Pause';
        timer = window.setInterval(() => { step += 1; renderStep(); }, 4800);
      });

      query<HTMLElement>('[data-playback]').hidden = false;
      motion.addEventListener('change', () => { pause(); renderStep(); });
      document.addEventListener('visibilitychange', () => { if (document.hidden) pause(); });
      window.addEventListener('pagehide', pause);
      renderScenario();
    }
  }
</script>
