---
import IdentityFlow from './IdentityFlow.astro';
import IdentityNode from './IdentityNode.astro';
import { DEMO, crossResult, vendorResult, type IdentityState } from './identity-model';
interface Props { kind:string; state:IdentityState; index:number }
const {kind,state,index}=Astro.props;
const node=(label:string,title:string,detail?:string,tone='normal')=>({label,title,detail,tone});
const cross=crossResult(state.id as 'allowed'|'caller'|'trust'|'service');
---
{kind==='workforce' && <div class="ic-workforce">
  <ol class="ic-stations">{['Profile','Browser','SSO token','AWS credentials','S3 request'].map((label,i)=><li class:list={[i===index&&'is-current',i < index&&'is-done']}><b>{i+1}</b><span>{label}</span><small>{i===index?'CURRENT':i < index?'COMPLETE':'NEXT'}</small></li>)}</ol>
  <IdentityFlow items={[
    node(['LOCAL CONFIGURATION','HUMAN AUTHENTICATION','TOKEN CACHE','CREDENTIAL EXCHANGE','RESOURCE REQUEST'][index],['workforce profile','Maya + identity source','Identity Center token','GetRoleCredentials','CLI signer'][index]),
    node('RESULT',state.credential,undefined,state.tone??'identity'),
  ]} labels={['read','sign in','authorize API access','return credential set','HTTPS'][index] ? [[ 'read','sign in','authorize API access','return credential set','HTTPS'][index]]:[]} />
  {index===0 && <pre tabindex="0"><code>{'[profile workforce]\nsso_session = company\nsso_account_id = 111111111111\nsso_role_name = DeveloperAccess\n\n[sso-session company]\nsso_start_url = https://example.awsapps.com/start\nsso_region = ap-south-1\nsso_registration_scopes = sso:account:access'}</code></pre>}
</div>}
{kind==='provisioning' && <div class="ic-scopes"><section><h3>Identity Center configuration</h3><IdentityNode label="ASSIGNMENT" title="Maya · Engineering" detail="Account 111111111111 + DeveloperAccess" tone="identity"/><IdentityNode label="PERMISSION SET" title="DeveloperAccess" detail="Policies + session settings" tone="identity"/></section><span class="ic-configuration">⇢<small>provisions</small></span><section><h3>Workforce account · 111…</h3><IdentityNode label="IAM ROLE" title="AWSReservedSSO_DeveloperAccess…" detail="Trust + permissions, managed by Identity Center" tone="identity"/><p>Assigned users can request credentials for this account role.</p></section></div>}
{kind==='providers' && <><IdentityFlow items={[
  node('RUNS AS',['EC2 instance','ECS application','Lambda function','OIDC workload'][index]),
  node('OBTAINS CREDENTIALS VIA',['IMDS provider','Container provider','Runtime provider','Web identity → STS'][index],undefined,'identity'),
  node('USES','SDK → S3','Signs with role credentials'),
]}/><div class="ic-pair">{state.facts?.map(([label,value])=><IdentityNode label={label} title={value} tone="identity"/>)}</div></>}
{kind==='signing' && <div class="ic-signing"><section><h3>Local process</h3><dl><div><dt>Secret access key</dt><dd>Stays here</dd></div><div><dt>Request + signing key</dt><dd>Calculate signature</dd></div></dl><IdentityNode label="PROOF" title="Signature" detail="Derived from canonical request data"/></section><span class="ic-connector">→<small>HTTPS</small></span><section><h3>On the wire → S3</h3><pre tabindex="0"><code>{'GET /?list-type=2\nHost: amzn-s3-demo-bucket-reports.s3.amazonaws.com\nAuthorization: AWS4-HMAC-SHA256\n  Credential=ASIA…DEMO/…\n  SignedHeaders=…\n  Signature=[calculated value]\nX-Amz-Security-Token: [session token]'}</code></pre><p>Identify the session → evaluate s3:ListBucket.</p></section></div>}
{kind==='cross' && <div class="ic-cross"><div class="ic-account-row"><section><h3>Workforce · 111…</h3><IdentityNode label="CALLER SESSION" title="Maya / DeveloperAccess" tone="identity"/><div class={`ic-gate ${cross.caller?'is-ok':'is-stop'}`}><b>{cross.caller?'✓ ALLOW':'× DENY'}</b><span>sts:AssumeRole on SupportRead</span></div></section><section><h3>Production · 222…</h3><IdentityNode label="TARGET ROLE" title="SupportRead" tone="identity"/><div class={`ic-gate ${cross.trust?'is-ok':'is-stop'}`}><b>{cross.trust?'✓ TRUST':'× NO TRUST'}</b><span>Source role + request conditions</span></div></section></div><IdentityFlow items={[node('REQUEST 1','STS: AssumeRole',cross.issued?'Target credentials issued':'Denied · no target session',cross.issued?'ok':'stop'),node('REQUEST 2','S3: ListObjectsV2',!cross.issued?'Not reached':cross.resourceAllowed?'Allowed · reports listed':'Denied · valid credentials',!cross.issued?'warn':cross.resourceAllowed?'ok':'stop')]} labels={[cross.issued?'use new credentials':'path stopped']}/><p class="ic-result">First blocking boundary: <strong>{cross.boundary}</strong></p></div>}
{kind==='chaining' && <><IdentityFlow items={[node('SOURCE SESSION','DeveloperAccess','Existing role credentials','identity'),node('STS REQUEST',`DurationSeconds = ${index===0?'3600':'7200'}`,'Target role max: 4 hours (example)'),node('RESULT',index===0?'New SupportRead session':'Request rejected',index===0?'1 hour maximum':'Chaining limit exceeded',index===0?'ok':'stop')]}/><div class="ic-duration"><span>15 min</span><i style={`--requested:${index===0?'50%':'100%'}`}></i><span>1 hour cap</span><span>2 hours requested</span></div><p>Source permissions stay with the source session. They are not added to SupportRead.</p></>}
{kind==='passrole' && <IdentityFlow items={index===0?[
 node('CALLER','Maya’s CLI'),node('API','STS AssumeRole','Checks permission + trust','identity'),node('RECEIVER','Maya’s CLI','Receives temporary credentials','ok')
]:[node('CALLER','Maya configures Lambda','CreateFunction with execution role'),node('AUTHORIZATION','iam:PassRole check','Part of the service API decision','identity'),node('ROLE USER','Lambda service','Later assumes its execution role')]} labels={index===0?['signed request','credential response']:['service API','service execution']}/>}
{kind==='vendor' && <><div class="ic-pair"><IdentityNode label="AUTHENTICATED TENANT" title={index===0?'Reports customer':'Other customer'} detail={`Vendor selects: ${vendorResult(index===0?'reports':'other').externalId}`}/><IdentityNode label="REPORTS ROLE TRUST" title="Trusted vendor principal" detail="Requires ExternalId = tenant-reports-42" tone="identity"/></div><IdentityFlow items={[node('REQUEST','AssumeRole',`ExternalId: ${vendorResult(index===0?'reports':'other').externalId}`),node('RESULT',index===0?'Tenant binding matches':'Tenant binding fails',index===0?'Customer credentials issued':'STS denies this request',index===0?'ok':'stop')]}/></>}
{kind==='clocks' && <div class="ic-clocks"><p>Illustrative timing · each row has its own expiration</p><div><strong>Identity Center session</strong><span class:list={['ic-clock-bar',index===2&&'is-stop']}>{index===2?'Upstream session unusable':'Usable upstream authorization'}</span></div><div><strong>AWS credential set A</strong><span class="ic-clock-bar is-old">Issued ───────── expires</span></div><div><strong>AWS credential set B</strong><span class:list={['ic-clock-bar',index!==0&&'is-stop']}>{index===0?'Provider obtains a fresh set →':index===1?'No provider: copied snapshot':'Refresh needs sign-in'}</span></div></div>}
{kind==='audit' && <div class="ic-audit"><pre tabindex="0"><code>{JSON.stringify({userIdentity:{type:'AssumedRole',arn:DEMO.session,sessionContext:{sessionIssuer:{type:'Role',arn:DEMO.role},sourceIdentity:'maya@example.com'}}},null,2)}</code></pre><dl><div><dt>arn</dt><dd>The session making this request.</dd></div><div><dt>sessionIssuer.arn</dt><dd>The role that defines its permission context.</dd></div><div><dt>sourceIdentity</dt><dd>Optional origin, constrained at issuance. This field is illustrative.</dd></div></dl></div>}
{kind==='diagnosis' && <div class="ic-checks" data-ic-checks>{state.evidence?.map(([command,output,meaning],i)=><section data-ic-check><h4>Check {i+1}</h4><pre tabindex="0"><code>$ {command}</code></pre><pre tabindex="0">{output}</pre><p>{meaning}</p></section>)}<button type="button" data-ic-reveal hidden>Reveal next check →</button><p class="ic-operate">Verify provider → identify caller → locate failed request → narrow permissions → retest and inspect CloudTrail.</p></div>}
