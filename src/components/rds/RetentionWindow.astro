<div class="retention-lab" data-retention-lab>
  <div class="lab-head">
    <div><span>Interactive model</span><h3>A rolling recovery window</h3></div>
    <fieldset>
      <legend>Retention</legend>
      <button type="button" data-days="1">1 day</button>
      <button type="button" data-days="3">3 days</button>
      <button type="button" data-days="7" aria-pressed="true">7 days</button>
    </fieldset>
  </div>
  <div class="timeline-axis" aria-hidden="true"><span>Earlier</span><span>Illustrative “now”</span></div>
  <div class="retention-days" role="img" aria-label="Eight days of backup activity with the selected rolling retention window">
    {Array.from({ length: 8 }, (_, index) => (
      <div class="retention-day" data-day={index + 1}>
        <span class="day-label">Day {index + 1}</span>
        <span class="snapshot-mark"><i></i> snapshot</span>
        <span class="log-line" aria-hidden="true"></span>
        <small>logs</small>
      </div>
    ))}
  </div>
  <div class="window-summary">
    <div><span>Earliest conceptual point</span><strong data-earliest>Start of day 2</strong></div>
    <div><span>Latest conceptual point</span><strong>Near “now”</strong></div>
    <p data-window-copy>Days 2–8 form the seven-day recovery window. Day 1 has aged out.</p>
  </div>
</div>

<script>
  for (const lab of document.querySelectorAll<HTMLElement>('[data-retention-lab]')) {
    const buttons = [...lab.querySelectorAll<HTMLButtonElement>('[data-days]')];
    const days = [...lab.querySelectorAll<HTMLElement>('[data-day]')];
    const earliest = lab.querySelector<HTMLElement>('[data-earliest]');
    const copy = lab.querySelector<HTMLElement>('[data-window-copy]');

    function update(retention: number) {
      const firstIncluded = 9 - retention;
      for (const day of days) {
        const number = Number(day.dataset.day);
        day.classList.toggle('expired', number < firstIncluded);
        day.classList.toggle('included', number >= firstIncluded);
      }
      for (const button of buttons) button.setAttribute('aria-pressed', String(Number(button.dataset.days) === retention));
      if (earliest) earliest.textContent = retention === 1 ? 'Start of day 8' : `Start of day ${firstIncluded}`;
      if (copy) copy.textContent = retention === 1
        ? 'Only day 8 remains in this simplified one-day recovery window.'
        : `Days ${firstIncluded}–8 form the ${retention}-day recovery window. Earlier days have aged out.`;
    }

    for (const button of buttons) button.addEventListener('click', () => update(Number(button.dataset.days)));
    update(7);
  }
</script>
