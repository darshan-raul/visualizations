---
import LessonConsole from '../lesson/LessonConsole.astro';
import IamEvaluationFlowchart from './IamEvaluationFlowchart.astro';
import { iamLesson } from './iam-lesson';

interface Props {
  published: Date;
  reviewed?: Date;
}
---

<LessonConsole
  lesson={iamLesson}
  published={Astro.props.published}
  reviewed={Astro.props.reviewed}
  sourceAliases={['sources']}
>
  <IamEvaluationFlowchart slot="view-policy-evaluation" />
</LessonConsole>

<script>
  import { initIamFlowchart } from './iam-flowchart-client';

  // Initialize on page load
  initIamFlowchart();

  // Re-run if Astro does client navigation
  document.addEventListener('astro:page-load', () => initIamFlowchart());
  window.addEventListener('hashchange', () => setTimeout(initIamFlowchart, 60));
</script>
