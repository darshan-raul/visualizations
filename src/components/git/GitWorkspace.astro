---
import type { GitLab } from './git-data';
import { getStepInternals } from './git-data';

interface Props {
  lab: GitLab;
}

const { lab } = Astro.props;
const firstStep = lab.steps[0];
const initialInternals = getStepInternals(lab, 0);

const graphTitles: Record<string, string> = {
  'where-is-git': 'THE 4 DOORS OF .GIT (VAULT ANATOMY)',
  'what-git-add-does': 'STAGING PIPELINE & THE 3-LAYER MM STATE',
  'what-git-commit-creates': 'MERKLE TREE HIERARCHY & SUBTREE REUSE',
  'branches-are-references': '41-BYTE BRANCH POINTERS (refs/heads/)',
  'head-pointer-and-detached-head': 'SYMBOLIC REF VS DETACHED HEAD',
  'checkout-switch-rebuilding-workspace': '3-STEP ATOMIC WORKSPACE REBUILD',
  'merge-vs-rebase-graph-surgery': '2-PARENT MERGE VS REBASE COMMIT REPLAY',
  'reset-restore-revert': 'THE 3 PHYSICAL BOUNDARIES UNDO MATRIX',
  'merge-conflicts-three-stage-index': '3-STAGE CONFLICT RESOLUTION (BASE/OURS/THEIRS)',
  'worktrees-reflog-and-plumbing': 'MULTI-WORKTREE SHARED VAULT & PLUMBING'
};

const svgViewBoxes: Record<string, string> = {
  'where-is-git': '0 0 900 180',
  'what-git-add-does': '0 0 900 240',
  'what-git-commit-creates': '0 0 900 275',
  'branches-are-references': '0 0 900 180',
  'head-pointer-and-detached-head': '0 0 900 200',
  'checkout-switch-rebuilding-workspace': '0 0 900 210',
  'merge-vs-rebase-graph-surgery': '0 0 900 240',
  'reset-restore-revert': '0 0 900 220',
  'merge-conflicts-three-stage-index': '0 0 900 230',
  'worktrees-reflog-and-plumbing': '0 0 900 250'
};
---

<div class="git-workspace" data-git-workspace={lab.id} data-ws-mode="learn">
  <!-- Workspace Header Bar -->
  <header class="workspace-topbar">
    <div class="workspace-identity">
      <span class="workspace-badge">REPOSITORY</span>
      <span class="workspace-repo">infra-platform</span>
      <span class="workspace-path" data-ws-path>{lab.path}</span>
      <span class="workspace-branch" data-ws-branch>{lab.branch}</span>
    </div>

    <!-- 3-Mode Switcher: Learn, X-Ray, Plumbing -->
    <div class="workspace-mode-switcher" role="radiogroup" aria-label="Internals Mode Switcher">
      <span class="mode-label">MODE:</span>
      <button
        type="button"
        class="mode-btn is-active"
        data-ws-mode-btn="learn"
        role="radio"
        aria-checked="true"
        title="Everyday porcelain commands with intuitive mental model"
      >
        <span class="mode-icon">📖</span> Normal
      </button>
      <button
        type="button"
        class="mode-btn"
        data-ws-mode-btn="xray"
        role="radio"
        aria-checked="false"
        title="Turn on X-Ray mode: watch what Git actually does inside .git, index, and objects"
      >
        <span class="mode-icon">⚡</span> X-Ray
      </button>
      <button
        type="button"
        class="mode-btn"
        data-ws-mode-btn="plumbing"
        role="radio"
        aria-checked="false"
        title="Plumbing mode: expose raw engine primitives (hash-object, write-tree, commit-tree, update-ref)"
      >
        <span class="mode-icon">⚙</span> Plumbing
      </button>
    </div>

    {lab.id === 'worktrees-reflog-and-plumbing' && (
      <nav class="worktree-selector" aria-label="Select active worktree directory">
        <span class="wt-selector-label">ACTIVE WORKTREE:</span>
        <button type="button" class="wt-btn is-active" data-wt-target="main" aria-pressed="true">
          <span class="wt-tag">ROOT</span> /repos/infra-platform <small>[main]</small>
        </button>
        <button type="button" class="wt-btn" data-wt-target="networking" aria-pressed="false">
          <span class="wt-tag">WT 1</span> /wt/networking <small>[feature/networking]</small>
        </button>
        <button type="button" class="wt-btn" data-wt-target="iam" aria-pressed="false">
          <span class="wt-tag">WT 2</span> /wt/iam <small>[feature/iam]</small>
        </button>
        <button type="button" class="wt-btn" data-wt-target="hotfix" aria-pressed="false">
          <span class="wt-tag">WT 3</span> /wt/hotfix <small>[hotfix/alb-healthcheck]</small>
        </button>
      </nav>
    )}
  </header>

  <!-- Interactive Workspace Body (Persistent 3-Column View) -->
  <div class="workspace-body-3col">
    <!-- Column 1: Filesystem (Working Directory + Expandable .git/ in X-Ray) -->
    <section class="workspace-col-fs" aria-label="Filesystem Explorer">
      <div class="col-head">
        <div class="col-title-wrap">
          <span class="col-title">FILESYSTEM</span>
          <span class="fs-status-hint" data-ws-fs-hint>[.git/ hidden]</span>
        </div>
        <span class="col-count" data-ws-file-count>{firstStep.files.length} items</span>
      </div>

      <ul class="file-tree" data-ws-file-tree>
        {firstStep.files.map((file) => (
          <li
            class:list={[
              'file-tree-item',
              file.isDir && 'is-dir',
              file.highlight && 'is-highlighted',
              file.status && `status-${file.status.toLowerCase()}`,
              file.path.startsWith('.git') && 'is-git-internal'
            ]}
            style={`--depth: ${file.depth || 0}`}
            data-file-path={file.path}
            title={`Click to inspect ${file.path} in terminal`}
          >
            <span class="file-icon" aria-hidden="true">
              {file.isDir ? '📁' : file.status === 'UU' ? '⚠️' : file.path.startsWith('.git') ? '⚙️' : '📄'}
            </span>
            <span class="file-name">{file.name}</span>
            {file.status && (
              <span
                class:list={['file-badge', `badge-${file.status.toLowerCase()}`]}
                aria-label={`Status: ${file.status}`}
              >
                {file.status}
              </span>
            )}
          </li>
        ))}
      </ul>
      <div class="fs-xray-toggle-banner" data-ws-fs-banner>
        <span class="banner-icon">⚡</span>
        <button type="button" class="banner-toggle-btn" data-ws-trigger-xray>
          Toggle X-Ray to inspect hidden .git/
        </button>
      </div>
    </section>

    <!-- Column 2: Linux Terminal (Interactive Bash Shell) -->
    <section class="workspace-col-term" aria-label="Linux Interactive Terminal">
      <div class="terminal-bar">
        <div class="terminal-dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <span class="terminal-tab" data-ws-term-tab>bash · dev@lab:~/{lab.path}</span>
        <span class="terminal-bell" aria-hidden="true">UTF-8</span>
      </div>

      <div class="terminal-window" data-ws-terminal role="region" aria-label="Interactive Terminal Window">
        <div class="terminal-history" data-ws-term-history>
          <div class="terminal-line is-welcome">
            <span class="term-comment"># Git Internals Lab Interactive Terminal</span>
            <span class="term-comment"># Repository: ~/repos/infra-platform ({lab.branch})</span>
            <span class="term-comment"># Tip: Click buttons, cards, files, or quick chips below to run real Git commands!</span>
          </div>
          <div class="terminal-line is-prompt">
            <span class="term-prompt">dev@lab:~/repos/infra-platform ({lab.branch})$</span>
            <span class="term-cmd" data-ws-term-cmd>{firstStep.command}</span>
          </div>
          <div class="terminal-output" data-ws-term-output>
            {firstStep.output.map((line) => (
              <pre class="term-out-line">{line}</pre>
            ))}
          </div>
        </div>

        <form class="terminal-cli-form" data-ws-cli-form onsubmit="return false;">
          <span class="term-prompt" data-ws-active-prompt>dev@lab:~/repos/infra-platform ({lab.branch})$</span>
          <div class="term-cli-input-wrapper">
            <input
              type="text"
              class="term-cli-input"
              data-ws-cli-input
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              aria-label="Interactive Git Command Prompt"
              placeholder="type git command (e.g. git status, git add)..."
            />
          </div>
        </form>

        <!-- Interactive Quick Command Chips -->
        <div class="terminal-quick-chips" aria-label="Quick Command Suggestions">
          <span class="chips-label">QUICK:</span>
          <button type="button" class="term-chip is-next-step" data-chip-cmd={firstStep.command} title="Run current laboratory step command">
            ▶ Run Step
          </button>
          <button type="button" class="term-chip" data-chip-cmd="git status -s" title="Check short status">
            git status -s
          </button>
          <button type="button" class="term-chip" data-chip-cmd="cat .git/HEAD" title="Inspect active HEAD pointer">
            cat .git/HEAD
          </button>
          <button type="button" class="term-chip" data-chip-cmd="git ls-files --stage" title="Inspect binary staging index">
            ls-files --stage
          </button>
          <button type="button" class="term-chip" data-chip-cmd="git log --oneline -n 3" title="View latest commits">
            git log
          </button>
          <button type="button" class="term-chip" data-chip-cmd="clear" title="Clear terminal screen">
            clear
          </button>
        </div>
      </div>
    </section>

    <!-- Column 3: Git Internals (HEAD -> Branch -> Commit -> Tree -> Blob Hierarchy) -->
    <section class="workspace-col-internals" aria-label="Git Internals Merkle Chain">
      <div class="col-head">
        <span class="col-title">GIT INTERNALS</span>
        <span class="internals-mode-tag" data-ws-internals-mode-tag>PORCELAIN</span>
      </div>

      <div class="internals-chain" data-ws-internals-chain>
        <!-- HEAD Pointer Card -->
        <div class="internals-card card-head" data-inspect-card="head" title="Click to inspect HEAD in terminal" style="cursor:pointer;">
          <div class="card-tag">HEAD POINTER ↵</div>
          <strong class="card-val" data-ws-head-ref>{initialInternals.head}</strong>
          <small class="card-sub">Your "you are here" position in the repository</small>
        </div>

        <!-- Branch Reference Card -->
        <div class="internals-card card-ref" data-inspect-card="branch" title="Click to inspect branch in terminal" style="cursor:pointer;">
          <div class="card-tag">BRANCH REFERENCE ↵</div>
          <strong class="card-val" data-ws-branch-ref>{initialInternals.branchRef}</strong>
          <small class="card-sub">Movable 41-byte text file inside .git/refs/heads/</small>
        </div>

        <!-- Commit Envelope Card -->
        <div class="internals-card card-commit" data-inspect-card="commit" title="Click to cat-file commit envelope in terminal" style="cursor:pointer;">
          <div class="card-tag">COMMIT ENVELOPE ↵</div>
          <strong class="card-val" data-ws-commit-hash>{initialInternals.commitHash}</strong>
          <p class="card-msg" data-ws-commit-msg>{initialInternals.commitMsg}</p>
        </div>

        <!-- Root Tree Card -->
        <div class="internals-card card-tree" data-inspect-card="tree" title="Click to cat-file tree in terminal" style="cursor:pointer;">
          <div class="card-tag">ROOT TREE OBJECT ↵</div>
          <strong class="card-val" data-ws-tree-hash>{initialInternals.treeHash}</strong>
          <small class="card-sub" data-ws-tree-detail>{initialInternals.treeDetail}</small>
        </div>

        <!-- Leaf Blob Card -->
        <div class="internals-card card-blob" data-inspect-card="blob" title="Click to cat-file blob in terminal" style="cursor:pointer;">
          <div class="card-tag">LEAF BLOB OBJECT ↵</div>
          <strong class="card-val" data-ws-blob-hash>{initialInternals.blobHash}</strong>
          <small class="card-sub" data-ws-blob-detail>{initialInternals.blobDetail}</small>
        </div>
      </div>

      <!-- X-Ray Reveal Banner -->
      <div class="xray-insight-box" data-ws-xray-box>
        <span class="xray-box-tag">⚡ X-RAY REVEAL</span>
        <p class="xray-box-text" data-ws-xray-text>{firstStep.xrayNote || firstStep.internalChange}</p>
      </div>

      <!-- Plumbing Primitive Box -->
      <div class="plumbing-insight-box" data-ws-plumbing-box>
        <span class="plumbing-box-tag">⚙ PLUMBING PRIMITIVE</span>
        <code class="plumbing-box-cmd" data-ws-plumbing-cmd>{firstStep.plumbingCommand || 'git cat-file -p HEAD'}</code>
        <button type="button" class="plumbing-run-btn" data-ws-plumbing-run title="Execute in terminal">Run in Terminal ↵</button>
      </div>
    </section>
  </div>

  <!-- Action Rail: Real Git Vocabulary Buttons -->
  <nav class="workspace-actions" aria-label="Git lab actions">
    <div class="action-buttons" role="group" aria-label="Interactive steps">
      {lab.steps.map((step, stepIndex) => (
        <button
          type="button"
          class:list={['git-act-btn', stepIndex === 0 && 'is-active']}
          data-step-index={stepIndex}
          aria-pressed={stepIndex === 0 ? 'true' : 'false'}
        >
          <span class="act-num">{String(stepIndex + 1).padStart(2, '0')}</span>
          <span class="act-label">{step.label}</span>
        </button>
      ))}
    </div>

    <div class="action-stepper">
      <button type="button" class="stepper-btn" data-act-first title="First step">|&larr;</button>
      <button type="button" class="stepper-btn" data-act-prev title="Previous step">&larr;</button>
      <button type="button" class="stepper-btn is-play" data-act-play title="Play simulation">▶ Play</button>
      <button type="button" class="stepper-btn" data-act-next title="Next step">&rarr;</button>
      <button type="button" class="stepper-btn is-reset" data-act-reset title="Reset lab">↺ Reset</button>
    </div>
  </nav>

  <!-- 4-Stage Ledger Shelf (WORKING TREE -> INDEX -> OBJECT DB -> COMMIT GRAPH) -->
  <aside class="state-shelf" aria-label="Live 4-Stage Git Ledger State">
    <div class="shelf-header">
      <span class="shelf-tag">4-STAGE REPOSITORY LEDGER</span>
      <span class="shelf-hint">Track data mutations across the four boundaries of Git</span>
    </div>
    <div class="shelf-grid" data-ws-shelf-grid>
      {firstStep.shelf.map((item, cellIdx) => (
        <article class:list={['shelf-cell', item.badge && `badge-${item.badge}`]}>
          <span class="cell-stage-num">STAGE 0{cellIdx + 1}</span>
          <span class="cell-label">{item.label}</span>
          <strong class="cell-value">{item.value}</strong>
          {item.detail && <small class="cell-detail">{item.detail}</small>}
        </article>
      ))}
    </div>
  </aside>

  <!-- Supporting Topology & Graph Strip -->
  <section class="supporting-graph" aria-label="Supporting Git Topology Graph">
    <div class="graph-head">
      <span class="graph-tag">TOPOLOGY & GRAPH SNAPSHOT</span>
      <span class="graph-info" data-ws-graph-info>
        {graphTitles[lab.id] || 'COMMIT DAG TRAVERSAL'}
      </span>
    </div>
    <div class="graph-canvas" data-ws-graph-canvas>
      <svg
        viewBox={svgViewBoxes[lab.id] || "0 0 900 180"}
        class="graph-svg"
        aria-hidden="true"
        preserveAspectRatio="xMidYMid meet"
      >
        <defs>
          <marker id="arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#42d6e8" />
          </marker>
          <marker id="arrow-muted" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#6c879b" />
          </marker>
          <marker id="arrow-amber" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#f6c763" />
          </marker>
        </defs>

        {lab.id === 'where-is-git' ? (
          <g class="dag-where-is-git">
            <!-- Left: Working Directory -->
            <rect x="20" y="20" width="320" height="140" rx="8" fill="#0b1522" stroke="#2b4562" stroke-width="1.5" />
            <rect x="20" y="20" width="320" height="24" rx="8" fill="#122338" />
            <text x="180" y="36" text-anchor="middle" fill="#68a3ff" font-size="10.5" font-family="monospace" font-weight="bold">WORKING DIRECTORY (YOUR DESK)</text>
            <text x="35" y="62" fill="#f2f5fc" font-size="9.5" font-family="monospace">📁 infra-platform/</text>
            <text x="50" y="80" fill="#8592a8" font-size="9" font-family="monospace">├── 📁 app/ (deployment.yaml)</text>
            <text x="50" y="98" fill="#8592a8" font-size="9" font-family="monospace">├── 📁 environments/ &amp; 📁 modules/</text>
            <text x="50" y="116" fill="#8592a8" font-size="9" font-family="monospace">└── 📄 README.md &amp; .gitignore</text>
            <text x="35" y="145" fill="#f6c763" font-size="8.5" font-family="monospace">Ordinary OS hard drive files. Git tracks nothing yet.</text>

            <!-- Arrow: git init -->
            <path d="M 345 90 H 400" stroke="#42d6e8" stroke-width="2.5" marker-end="url(#arrow)" />
            <text x="372" y="80" text-anchor="middle" fill="#42d6e8" font-size="8.5" font-family="monospace" font-weight="bold">git init</text>

            <!-- Right: The 4 Doors of .git Vault -->
            <rect x="405" y="20" width="475" height="140" rx="8" fill="#081b28" stroke="#42d6e8" stroke-width="1.8" />
            <rect x="405" y="20" width="475" height="24" rx="8" fill="#0d2c42" />
            <text x="642" y="36" text-anchor="middle" fill="#42d6e8" font-size="10.5" font-family="monospace" font-weight="bold">THE HIDDEN REPOSITORY VAULT (.git/)</text>

            <!-- Door 1: HEAD -->
            <g class="door-card" data-git-inspect-cmd="cat .git/HEAD" style="cursor:pointer;">
              <rect x="415" y="52" width="105" height="98" rx="6" fill="#0d2233" stroke="#42d6e8" stroke-width="1.4" />
              <text x="467" y="68" text-anchor="middle" fill="#42d6e8" font-size="9" font-family="monospace" font-weight="bold">DOOR 1: HEAD</text>
              <text x="467" y="85" text-anchor="middle" fill="#f2f5fc" font-size="8" font-family="monospace">"You are here"</text>
              <text x="467" y="105" text-anchor="middle" fill="#49d6a3" font-size="7.5" font-family="monospace">ref: refs/heads/</text>
              <text x="467" y="120" text-anchor="middle" fill="#49d6a3" font-size="8" font-family="monospace">main</text>
              <text x="467" y="140" text-anchor="middle" fill="#6c879b" font-size="7" font-family="monospace">[Symbolic Ref]</text>
            </g>

            <!-- Door 2: INDEX -->
            <g class="door-card" data-git-inspect-cmd="git ls-files --stage" style="cursor:pointer;">
              <rect x="530" y="52" width="105" height="98" rx="6" fill="#0d2233" stroke="#68a3ff" stroke-width="1.4" />
              <text x="582" y="68" text-anchor="middle" fill="#68a3ff" font-size="9" font-family="monospace" font-weight="bold">DOOR 2: INDEX</text>
              <text x="582" y="85" text-anchor="middle" fill="#f2f5fc" font-size="8" font-family="monospace">Conveyor Belt</text>
              <text x="582" y="105" text-anchor="middle" fill="#97a3b8" font-size="7.5" font-family="monospace">Binary Staging</text>
              <text x="582" y="120" text-anchor="middle" fill="#97a3b8" font-size="8" font-family="monospace">Cache Ledger</text>
              <text x="582" y="140" text-anchor="middle" fill="#6c879b" font-size="7" font-family="monospace">[git add target]</text>
            </g>

            <!-- Door 3: OBJECTS -->
            <g class="door-card" data-git-inspect-cmd="git count-objects -v" style="cursor:pointer;">
              <rect x="645" y="52" width="115" height="98" rx="6" fill="#0d2233" stroke="#f6c763" stroke-width="1.4" />
              <text x="702" y="68" text-anchor="middle" fill="#f6c763" font-size="9" font-family="monospace" font-weight="bold">DOOR 3: OBJECTS/</text>
              <text x="702" y="85" text-anchor="middle" fill="#f2f5fc" font-size="8" font-family="monospace">Immutable Vault</text>
              <text x="702" y="105" text-anchor="middle" fill="#f6c763" font-size="7.5" font-family="monospace">blobs (files)</text>
              <text x="702" y="120" text-anchor="middle" fill="#42d6e8" font-size="7.5" font-family="monospace">trees (folders)</text>
              <text x="702" y="135" text-anchor="middle" fill="#49d6a3" font-size="7.5" font-family="monospace">commits (snapshots)</text>
            </g>

            <!-- Door 4: REFS -->
            <g class="door-card" data-git-inspect-cmd="cat .git/refs/heads/main" style="cursor:pointer;">
              <rect x="770" y="52" width="100" height="98" rx="6" fill="#0d2233" stroke="#49d6a3" stroke-width="1.4" />
              <text x="820" y="68" text-anchor="middle" fill="#49d6a3" font-size="9" font-family="monospace" font-weight="bold">DOOR 4: REFS/</text>
              <text x="820" y="85" text-anchor="middle" fill="#f2f5fc" font-size="8" font-family="monospace">Branch Tips</text>
              <text x="820" y="105" text-anchor="middle" fill="#49d6a3" font-size="7.5" font-family="monospace">refs/heads/main</text>
              <text x="820" y="120" text-anchor="middle" fill="#97a3b8" font-size="7.5" font-family="monospace">41-byte files</text>
              <text x="820" y="140" text-anchor="middle" fill="#6c879b" font-size="7" font-family="monospace">[Commit Pointers]</text>
            </g>
          </g>
        ) : lab.id === 'what-git-add-does' ? (
          <g class="dag-add-pipeline">
            <!-- Stage 1: Working Tree File on Desk -->
            <g class="pipeline-stage" data-svg-step="0" data-git-inspect-cmd="cat app/deployment.yaml" style="cursor:pointer;">
              <rect x="15" y="20" width="220" height="95" rx="7" fill="#141c28" stroke="#f6c763" stroke-width="1.8" />
              <rect x="15" y="20" width="220" height="22" rx="7" fill="#222b15" />
              <text x="125" y="35" text-anchor="middle" fill="#f6c763" font-size="9.5" font-family="monospace" font-weight="bold">STAGE 01: WORKING TREE</text>
              <text x="25" y="58" fill="#f2f5fc" font-size="9" font-family="monospace">📄 app/deployment.yaml</text>
              <text x="25" y="75" fill="#8592a8" font-size="8.5" font-family="monospace">Edits on disk: <tspan fill="#f6c763" font-weight="bold">replicas: 3</tspan></text>
              <text x="25" y="95" fill="#f6c763" font-size="8" font-family="monospace">Dirty byte buffer on OS disk</text>
            </g>

            <!-- Arrow: hash-object -->
            <path d="M 235 68 H 305" stroke="#f6c763" stroke-width="2.2" marker-end="url(#arrow-amber)" />
            <text x="270" y="58" text-anchor="middle" fill="#f6c763" font-size="7.5" font-family="monospace">hash-object -w</text>

            <!-- Stage 2: Object Storage Blob -->
            <g class="pipeline-stage" data-svg-step="1" data-git-inspect-cmd="git cat-file -p 7ab38f4" style="cursor:pointer;">
              <rect x="305" y="20" width="270" height="95" rx="7" fill="#081a26" stroke="#42d6e8" stroke-width="1.8" />
              <rect x="305" y="20" width="270" height="22" rx="7" fill="#0d2e42" />
