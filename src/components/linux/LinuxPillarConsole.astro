    </div>
    <aside slot="inspector" class="linux-inspector" aria-label="Context and command inspector"><span class="linux-kicker">SYSTEM INSPECTOR</span><h2 data-linux-inspector-title>{active.title}</h2><p data-linux-inspector-copy>{active.explanation}</p><div class="linux-inspector-facts"><div><span>OBJECT</span><strong data-linux-fact-object>{viewObject(active)}</strong></div><div><span>OWNER</span><strong data-linux-fact-owner>{ownerByPillar[pillar.id]}</strong></div><div><span>STATE</span><strong data-linux-fact-state>{viewStatus(active)}</strong></div><div><span>EVIDENCE</span><strong data-linux-fact-evidence>{viewEvidence(active)}</strong></div></div><div class="linux-command-panel"><div class="linux-command-head"><span>SIMULATED TERMINAL</span><span>LOCAL FIXTURE</span></div><div class="linux-command-actions"><button type="button" data-linux-command="primary">$ {active.command || 'No command for this view'}</button><button type="button" data-linux-command="probe">$ {active.probe || 'No probe for this view'}</button></div><pre data-linux-terminal-output aria-live="polite">{active.output || 'Select a command above.'}</pre><p data-linux-terminal-result>Command evidence highlights the first object in the active diagram.</p></div><div class="linux-inspector-caveat"><span>MODEL NOTE</span><p data-linux-caveat>{active.caveat}</p></div></aside>
    <div slot="bottom"><div class="linux-takeaway"><span>THE POINT TO KEEP</span><p data-linux-takeaway>{active.takeaway}</p></div><div class="linux-bridge"><span>IN CLOUD AND CONTAINERS</span><p>{pillar.bridge}</p></div><KnowledgeCheck pillar={pillar} /><div class="linux-pillar-pager"><a href={previous ? `/linux/${previous.id}` : '/linux'}>← {previous ? previous.short : 'Linux Map'}</a><a href="/linux">Linux Map</a><a href={next ? `/linux/${next.id}` : '/foundations'}>{next ? next.short : 'Foundations'} →</a></div><details id="linux-sources" class="linux-sources"><summary>Sources, scope & related visuals <span aria-hidden="true">↗</span></summary><div><h2>Primary references</h2><ul>{[...new Map(pillar.views.map((view) => [view.source, view.source])).values()].map((source) => <li><a href={source} target="_blank" rel="noopener noreferrer">{new URL(source).hostname} · {new URL(source).pathname.split('/').filter(Boolean).at(-1)} ↗</a></li>)}</ul><p>Linux examples use a generic modern host. systemd and package-tool behavior are labelled where applicable; exact commands and defaults vary by distribution, configuration, and installed utilities.</p><RelatedVisuals currentTopic={topic} topics={topics} /></div></details><div class="linux-sitefoot"><span>Infra, Illustrated. · One Linux machine through eight lenses.</span><a href="/visualizations">Browse all visuals ↗</a></div></div>
</TopicConsoleShell>

<script>
  const incidents: Record<string, { result: string; output: string; blocked: number; actors: [string, string][] }> = {
    loopback: { result: 'Service active; socket bound to 127.0.0.1:443. Remote connections cannot reach that bind address.', output: 'ss: LISTEN 127.0.0.1:443\nsystemctl: active', blocked: 2, actors: [['DNS', 'resolved'], ['service', 'active'], ['socket', '127.0.0.1:443'], ['client', 'remote timeout']] },
    stopped: { result: 'The service is inactive; no worker or listening socket exists. Inspect unit status and journal.', output: 'systemctl: inactive\nss: no TCP/443 listener', blocked: 1, actors: [['DNS', 'resolved'], ['service', 'stopped'], ['socket', 'absent'], ['client', 'connection fails']] },
    firewall: { result: 'The socket listens on eth0, but a local DROP fixture rejects the path. Inspect guest firewall policy.', output: 'ss: LISTEN 10.0.1.17:443\nnft: tcp dport 443 drop', blocked: 2, actors: [['service', 'active'], ['socket', '10.0.1.17:443'], ['guest firewall', 'DROP fixture'], ['client', 'timeout']] },
    dns: { result: 'Name lookup failed before a destination address was selected. Check resolver and name evidence.', output: 'getent hosts devbox-01: no result', blocked: 0, actors: [['DNS', 'no answer'], ['destination', 'not selected'], ['socket', 'not attempted'], ['client', 'lookup failure']] },
    disk: { result: 'Data blocks are full; a write can fail even while the process is alive. Compare df and application log.', output: 'df -h /srv: 100% used; 0 available', blocked: 2, actors: [['service', 'active'], ['filesystem', '/srv'], ['data blocks', '0 free'], ['application', 'write fails']] },
    inodes: { result: 'Data blocks remain, but no free inodes can create another file. Check df -i.', output: 'df -h /srv: 36% used\ndf -i /srv: 100% used', blocked: 2, actors: [['service', 'active'], ['filesystem', '/srv'], ['free inodes', '0 remaining'], ['new file', 'ENOSPC']] },
    oom: { result: 'The worker was killed under memory pressure. Check kernel messages and service restart evidence.', output: 'journalctl -k: Out of memory; killed process 421 (nginx)', blocked: 1, actors: [['memory', 'pressure'], ['worker PID 421', 'OOM killed'], ['socket', 'absent'], ['client', 'connection fails']] },
    permission: { result: 'The service cannot read configuration. Inspect process credentials, path traversal, file mode, and policy.', output: 'journalctl -u nginx: open config failed (EACCES)', blocked: 2, actors: [['worker', 'UID 33'], ['config path', '/etc/nginx'], ['access check', 'EACCES'], ['service', 'fails start']] },
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-console-id]')) {
    const views = [...root.querySelectorAll<HTMLElement>('[data-linux-view]')];
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-linux-view-link]')];
    const groups = [...root.querySelectorAll<HTMLDetailsElement>('[data-linux-group]')];
    const menu = root.querySelector<HTMLDetailsElement>('[data-linux-index-menu]')!;
    const get = (selector: string) => root.querySelector<HTMLElement>(selector)!;
    let stage = Math.max(0, views.findIndex((view) => view.id === location.hash.slice(1)));
    let alternative = false;
    let step = -1;
    let timer: number | undefined;

    function stopPlayback() {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
      root.querySelectorAll<HTMLButtonElement>('[data-linux-step="play"], [data-wt-step="play"], [data-rc-step="play"]').forEach((btn) => {
        if (btn.textContent?.includes('Pause')) btn.textContent = '▶ Auto-Play';
      });
    }

    function diagram(visual: HTMLElement) {
      const actors = [...visual.querySelectorAll<HTMLElement>('[data-linux-actor]')];
      actors.forEach((actor, index) => {
        actor.classList.toggle('is-current', index === step || (alternative && step < 0 && index === actors.length - 1));
        if (alternative && actor.dataset.blocked === 'true') actor.classList.remove('is-blocked');
        else actor.classList.toggle('is-blocked', actor.dataset.blocked === 'true');
      });
    }

    function render() {
      views.forEach((view, index) => { view.hidden = index !== stage; });
      links.forEach((link, index) => {
        if (index === stage) link.setAttribute('aria-current', 'step');
        else link.removeAttribute('aria-current');
      });
      groups.forEach((group) => {
        group.open = !!group.querySelector(`[data-linux-view-link="${views[stage].id}"]`);
      });

      const current = views[stage];
      const data = current.dataset;
      const title = current.querySelector('h2')!.textContent || '';
      const label = links[stage].querySelector('strong')!.textContent || '';

      get('[data-linux-count]').textContent = `${String(stage + 1).padStart(2, '0')} / ${String(views.length).padStart(2, '0')}`;
      get('[data-linux-menu-count]').textContent = `${String(stage + 1).padStart(2, '0')} / ${String(views.length).padStart(2, '0')}`;
      get('[data-linux-progress]').textContent = `${String(stage + 1).padStart(2, '0')} / ${label}`;
      get('[data-linux-view-title]').textContent = label;
      get('[data-linux-inspector-title]').textContent = title;
      get('[data-linux-inspector-copy]').textContent = data.viewExplanation || '';
      get('[data-linux-caveat]').textContent = data.viewCaveat || '';
      get('[data-linux-takeaway]').textContent = data.viewTakeaway || '';
      get('[data-linux-scenario-object]').textContent = data.viewObject || label;
      get('[data-linux-scenario-state]').textContent = data.viewStatus || 'ready to inspect';
      get('[data-linux-scenario-owner]').textContent = data.viewOwner || '';
      get('[data-linux-fact-object]').textContent = data.viewObject || label;
      get('[data-linux-fact-owner]').textContent = data.viewOwner || '';
      get('[data-linux-fact-state]').textContent = data.viewStatus || 'ready to inspect';
      get('[data-linux-fact-evidence]').textContent = data.viewEvidence || 'visual state';

      const cmdPrimary = data.viewCommand || '';
      const cmdProbe = data.viewProbe || '';
      const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-linux-command]')];
      buttons[0].textContent = cmdPrimary ? `$ ${cmdPrimary}` : '—';
      buttons[1].textContent = cmdProbe ? `$ ${cmdProbe}` : '—';
      get('[data-linux-terminal-output]').textContent = data.viewOutput || 'No terminal output for this view.';
      get('[data-linux-terminal-result]').textContent = 'Command evidence highlights the active object in the diagram.';

      alternative = false;
      step = -1;
      stopPlayback();

      if (current.querySelector('[data-linux-actors]')) {
        diagram(current);
      }
    }

    function select(index: number, history = true) {
      stage = Math.max(0, Math.min(views.length - 1, index));
      render();
      if (window.matchMedia('(max-width: 760px)').matches) menu.open = false;
      if (history) window.history.pushState(null, '', `#${views[stage].id}`);
    }

    links.forEach((link, index) => link.addEventListener('click', (event) => {
      event.preventDefault();
      select(index);
    }));

    window.addEventListener('popstate', () => select(Math.max(0, views.findIndex((view) => view.id === location.hash.slice(1))), false));
    window.addEventListener('hashchange', () => select(Math.max(0, views.findIndex((view) => view.id === location.hash.slice(1))), false));

    root.querySelector<HTMLButtonElement>('[data-linux-prev]')?.addEventListener('click', () => select(stage - 1));
    root.querySelector<HTMLButtonElement>('[data-linux-next]')?.addEventListener('click', () => select(stage + 1));

    // Inspector terminal toggle
    root.querySelectorAll<HTMLButtonElement>('[data-linux-command]').forEach((button) => button.addEventListener('click', () => {
      const current = views[stage];
      const data = current.dataset;
      const isProbe = button.dataset.linuxCommand === 'probe';
      get('[data-linux-terminal-output]').textContent = isProbe ? (data.viewProbeOutput || '') : (data.viewOutput || '');
      get('[data-linux-terminal-result]').textContent = isProbe ? 'The probe command inspects the target boundary in the system.' : 'The primary command inspects the core source state.';
      get('[data-linux-fact-evidence]').textContent = isProbe ? (data.viewProbe || 'probe result') : (data.viewCommand || 'command result');
      get('[data-linux-scenario-state]').textContent = isProbe ? 'probe inspected' : 'baseline inspected';
      get('[data-linux-fact-state]').textContent = get('[data-linux-scenario-state]').textContent || '';
      if (current.querySelector('[data-linux-actors]')) {
        step = isProbe ? Math.min(2, current.querySelectorAll('[data-linux-actor]').length - 1) : 0;
        diagram(current);
      }
    }));

    // Actor clicks
    root.querySelectorAll<HTMLButtonElement>('[data-linux-actor]').forEach((actor) => {
      actor.disabled = false;
      actor.addEventListener('click', () => {
        const current = views[stage];
        if (!current.contains(actor)) return;
        step = Number(actor.dataset.linuxActor ?? 0);
        diagram(current);
        const label = actor.querySelector('strong')?.textContent || '';
        const detail = actor.querySelector('small')?.textContent || '';
        get('[data-linux-inspector-copy]').textContent = `${label}: ${detail}. ${current.dataset.viewExplanation || ''}`;
        get('[data-linux-terminal-output]').textContent = step < 2 ? (current.dataset.viewOutput || '') : (current.dataset.viewProbeOutput || '');
        get('[data-linux-terminal-result]').textContent = `Inspecting ${label}.`;
        get('[data-linux-scenario-object]').textContent = label;
        get('[data-linux-scenario-state]').textContent = actor.dataset.blocked === 'true' ? 'blocked here' : detail;
        get('[data-linux-fact-object]').textContent = label;
        get('[data-linux-fact-state]').textContent = actor.dataset.blocked === 'true' ? 'blocked here' : detail;
      });
    });

    // Path Stepper (Actor views)
    root.querySelectorAll<HTMLElement>('[data-linux-path-controls]').forEach((controls) => {
      controls.querySelectorAll<HTMLButtonElement>('[data-linux-step]').forEach((btn) => btn.addEventListener('click', () => {
        const current = views[stage];
        if (controls.dataset.linuxPathControls !== current.id) return;
        const actors = [...current.querySelectorAll<HTMLElement>('[data-linux-actor]')];
        const action = btn.dataset.linuxStep;
        const report = controls.querySelector<HTMLElement>('[data-linux-step-result]')!;
        function advance() {
          step = Math.min(actors.length - 1, step + 1);
          diagram(current);
          report.textContent = `Step ${step + 1} / ${actors.length}: ${actors[step].querySelector('strong')?.textContent} — ${actors[step].querySelector('small')?.textContent}`;
          get('[data-linux-scenario-object]').textContent = actors[step].querySelector('strong')?.textContent || '';
          get('[data-linux-scenario-state]').textContent = `step ${step + 1} of ${actors.length}`;
          get('[data-linux-fact-object]').textContent = get('[data-linux-scenario-object]').textContent || '';
          get('[data-linux-fact-state]').textContent = get('[data-linux-scenario-state]').textContent || '';
        }
        if (action === 'prev') { stopPlayback(); step = Math.max(0, step - 1); diagram(current); report.textContent = `Step ${step + 1} / ${actors.length}: ${actors[step].querySelector('strong')?.textContent}`; }
        if (action === 'next') { stopPlayback(); advance(); }
        if (action === 'play') {
          if (timer !== undefined) { stopPlayback(); btn.textContent = '▶ Play flow'; return; }
          step = -1; advance();
          btn.textContent = '⏸ Pause';
          timer = window.setInterval(() => {
            if (step >= actors.length - 1) { stopPlayback(); btn.textContent = '▶ Play flow'; return; }
            advance();
          }, 1100);
        }
      }));
    });

    // Walkthrough Pipeline Stepper
    root.querySelectorAll<HTMLElement>('[data-walkthrough-root]').forEach((wtRoot) => {
      let wtIndex = 0;
      const stages = [...wtRoot.querySelectorAll<HTMLElement>('[data-pipeline-stage]')];
      const cards = [...wtRoot.querySelectorAll<HTMLElement>('[data-wt-card]')];
      const status = wtRoot.querySelector<HTMLElement>('[data-wt-status]');
      const report = wtRoot.querySelector<HTMLElement>('[data-wt-result]');

      function setWtStage(idx: number) {
        wtIndex = Math.max(0, Math.min(stages.length - 1, idx));
        stages.forEach((st, i) => st.classList.toggle('is-active', i === wtIndex));
        cards.forEach((cd, i) => cd.hidden = i !== wtIndex);
        if (status) status.textContent = `STAGE ${String(wtIndex + 1).padStart(2, '0')} / ${String(stages.length).padStart(2, '0')} ACTIVE`;
        const activeCard = cards[wtIndex];
        const annotation = activeCard?.querySelector('.linux-wt-annotation')?.textContent || '';
        if (report) report.textContent = `Stage ${wtIndex + 1}: ${annotation}`;
        const termOutput = activeCard?.querySelector('pre')?.textContent || '';
        get('[data-linux-terminal-output]').textContent = termOutput;
      }

      stages.forEach((st, i) => st.querySelector('button')?.addEventListener('click', () => {
        stopPlayback();
        setWtStage(i);
      }));

      wtRoot.querySelectorAll<HTMLButtonElement>('[data-wt-step]').forEach((btn) => btn.addEventListener('click', () => {
        const action = btn.dataset.wtStep;
        if (action === 'prev') { stopPlayback(); setWtStage(wtIndex - 1); }
        if (action === 'next') { stopPlayback(); setWtStage(wtIndex + 1); }
        if (action === 'play') {
          if (timer !== undefined) { stopPlayback(); btn.textContent = '▶ Auto-Play'; return; }
          setWtStage(0);
          btn.textContent = '⏸ Pause';
          timer = window.setInterval(() => {
            if (wtIndex >= stages.length - 1) { stopPlayback(); btn.textContent = '▶ Auto-Play'; return; }
            setWtStage(wtIndex + 1);
          }, 1400);
        }
      }));
    });

    // Recipe Stepper
    root.querySelectorAll<HTMLElement>('[data-recipe-root]').forEach((rcRoot) => {
      let rcIndex = 0;
      const nodes = [...rcRoot.querySelectorAll<HTMLElement>('[data-recipe-node]')];
      const details = [...rcRoot.querySelectorAll<HTMLElement>('[data-recipe-detail]')];
      const status = rcRoot.querySelector<HTMLElement>('[data-recipe-status]');
      const report = rcRoot.querySelector<HTMLElement>('[data-rc-result]');

      function setRcStep(idx: number) {
        rcIndex = Math.max(0, Math.min(nodes.length - 1, idx));
        nodes.forEach((n, i) => {
          n.classList.toggle('is-active', i === rcIndex);
          const badge = n.querySelector('.runbook-status-badge');
          if (badge) badge.textContent = i < rcIndex ? 'COMPLETED' : i === rcIndex ? 'EXECUTING' : 'PENDING';
        });
        details.forEach((d, i) => d.hidden = i !== rcIndex);
        if (status) status.textContent = `ACTION ${String(rcIndex + 1).padStart(2, '0')} / ${String(nodes.length).padStart(2, '0')} ACTIVE`;
        const title = nodes[rcIndex]?.querySelector('.runbook-title')?.textContent || '';
        if (report) report.textContent = `Action ${rcIndex + 1}: ${title}`;
        const termOutput = details[rcIndex]?.querySelector('pre')?.textContent || '';
        if (termOutput) get('[data-linux-terminal-output]').textContent = termOutput;
      }

      nodes.forEach((n, i) => n.querySelector('button')?.addEventListener('click', () => {
        stopPlayback();
        setRcStep(i);
      }));

      rcRoot.querySelectorAll<HTMLButtonElement>('[data-rc-step]').forEach((btn) => btn.addEventListener('click', () => {
        const action = btn.dataset.rcStep;
        if (action === 'prev') { stopPlayback(); setRcStep(rcIndex - 1); }
        if (action === 'next') { stopPlayback(); setRcStep(rcIndex + 1); }
        if (action === 'play') {
          if (timer !== undefined) { stopPlayback(); btn.textContent = '▶ Auto-Run'; return; }
          setRcStep(0);
          btn.textContent = '⏸ Pause';
          timer = window.setInterval(() => {
            if (rcIndex >= nodes.length - 1) { stopPlayback(); btn.textContent = '▶ Auto-Run'; return; }
            setRcStep(rcIndex + 1);
          }, 1400);
        }
      }));
    });

    // Gotcha Security Sandbox Toggle
    root.querySelectorAll<HTMLElement>('[data-gotcha-root]').forEach((gRoot) => {
      const switcher = gRoot.querySelectorAll<HTMLButtonElement>('[data-gotcha-mode]');
      const states = gRoot.querySelectorAll<HTMLElement>('[data-gotcha-state]');
      const status = gRoot.querySelector<HTMLElement>('[data-gotcha-status]');

      switcher.forEach((btn) => btn.addEventListener('click', () => {
        const mode = btn.dataset.gotchaMode || 'bad';
        switcher.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        states.forEach((st) => {
          st.hidden = st.dataset.gotchaState !== mode;
        });
        if (status) {
          status.className = mode === 'bad' ? 'gotcha-status-bad' : 'gotcha-status-good';
          status.textContent = mode === 'bad' ? 'SECURITY COMPROMISED (TRAP ACTIVE)' : 'SYSTEM HARDENED (LEAST PRIVILEGE)';
        }
        const activeTerminal = gRoot.querySelector<HTMLElement>(`.gotcha-state-${mode} .linux-gotcha-terminal pre`);
        if (activeTerminal) get('[data-linux-terminal-output]').textContent = activeTerminal.textContent || '';
      }));
    });

    // Kernel Signal Dispatcher Playground
    root.querySelectorAll<HTMLElement>('[data-signal-dispatcher]').forEach((disp) => {
      const proc = disp.querySelector<HTMLElement>('[data-dispatcher-proc]')!;
      const stateEl = disp.querySelector<HTMLElement>('[data-proc-state]')!;
      const logEl = disp.querySelector<HTMLElement>('[data-proc-log]')!;

      disp.querySelectorAll<HTMLButtonElement>('[data-signal]').forEach((btn) => btn.addEventListener('click', () => {
        const sig = btn.dataset.signal;
        proc.className = 'dispatcher-process';
        if (sig === 'SIGTERM') {
          proc.classList.add('proc-term');
          stateEl.textContent = 'State: SIGTERM delivered; application disposition decides what follows';
          logEl.textContent = '[kernel] Delivered signal 15 (SIGTERM) to PID 421.\n[fixture nginx:421] Handler begins graceful shutdown.\n[operator] Verify that the process exits; SIGTERM does not guarantee cleanup.';
          get('[data-linux-terminal-output]').textContent = 'kill -s SIGTERM 421\n# Signal sent. Inspect process state and logs to confirm the outcome.';
        } else if (sig === 'SIGKILL') {
          proc.classList.add('proc-kill');
          stateEl.textContent = 'State: SIGKILL delivered; no application handler can run';
          logEl.textContent = '[kernel] Delivered signal 9 (SIGKILL) to PID 421.\n[process] Cannot catch, block, or ignore SIGKILL.\n[parent] Must still reap the terminated child process.';
          get('[data-linux-terminal-output]').textContent = 'kill -s SIGKILL 421\n# No target cleanup handler runs. Verify termination and parent reaping.';
        } else if (sig === 'SIGHUP') {
          proc.classList.add('proc-hup');
          stateEl.textContent = 'State: Reloading /etc/nginx/nginx.conf';
          logEl.textContent = '[kernel] Delivered signal 1 (SIGHUP) to PID 421.\n[fixture nginx:421] Application-defined handler starts a configuration reload.\n[operator] Other programs may terminate or handle SIGHUP differently.';
          get('[data-linux-terminal-output]').textContent = 'kill -HUP 421\n# nginx defines reload behavior; SIGHUP is not a universal reload command.';
        } else if (sig === 'SIGSTOP') {
          proc.classList.add('proc-stop');
          stateEl.textContent = 'State: T (Stopped / Frozen by kernel)';
          logEl.textContent = '[kernel] Sent signal 19 (SIGSTOP) to PID 421.\n[scheduler] Process paused. Not scheduled for CPU slices.';
          get('[data-linux-terminal-output]').textContent = 'kill -STOP 421\n# PID 421 paused; send SIGCONT to resume';
        } else if (sig === 'SIGCONT') {
          proc.classList.add('proc-cont');
          stateEl.textContent = 'State: R (Running / Resumed)';
          logEl.textContent = '[kernel] Sent signal 18 (SIGCONT) to PID 421.\n[scheduler] Process resumed. Returning to active queue.';
          get('[data-linux-terminal-output]').textContent = 'kill -CONT 421\n# Process execution resumed';
        } else {
          stateEl.textContent = 'State: S (sleeping / listening on :443)';
          logEl.textContent = '[kernel scheduler] PID 421 active. Ready to receive signal...';
        }
      }));
    });

    // Stream Lab Tool Selector
    root.querySelectorAll<HTMLElement>('[data-stream-lab]').forEach((slab) => {
      const toolName = slab.querySelector<HTMLElement>('[data-stream-tool-name]')!;
      const outPre = slab.querySelector<HTMLElement>('[data-stream-output]')!;
      const toolButtons = slab.querySelectorAll<HTMLButtonElement>('[data-tool]');

      const toolConfigs: Record<string, { name: string; output: string }> = {
        grep: { name: 'grep "200"', output: '10.0.1.17 - 200 GET\n192.168.1.5 - 200 GET' },
        awk: { name: 'awk \'{print $1}\'', output: '10.0.1.17\n192.168.1.5\n10.0.1.17\n192.168.1.5' },
        sort: { name: 'sort | uniq -c', output: '  2 10.0.1.17\n  2 192.168.1.5' },
        wc: { name: 'wc -l', output: '4' }
      };

      toolButtons.forEach((btn) => btn.addEventListener('click', () => {
        const key = btn.dataset.tool || 'grep';
        toolButtons.forEach((b) => {
          b.classList.toggle('is-active', b === btn);
          b.setAttribute('aria-pressed', String(b === btn));
        });
        const conf = toolConfigs[key] || toolConfigs.grep;
        toolName.textContent = conf.name;
        outPre.textContent = conf.output;
      }));
    });

    // Decision Tree Flowchart Navigation
    root.querySelectorAll<HTMLElement>('[data-decision-root]').forEach((dRoot) => {
      const nodes = [...dRoot.querySelectorAll<HTMLElement>('[data-decision-node]')];
      const trail = dRoot.querySelector<HTMLElement>('[data-decision-trail]');

      function showNode(id: string) {
        const target = nodes.find((n) => n.dataset.decisionNode === id);
        if (!target) return;
        nodes.forEach((n) => n.classList.remove('is-active'));
        target.classList.add('is-active');
        target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        const label = target.querySelector('.decision-label')?.textContent || id;
        if (trail) trail.textContent = `Active: ${label}`;
      }

      dRoot.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((btn) => btn.addEventListener('click', () => {
        const nextId = btn.dataset.goto;
        if (nextId) showNode(nextId);
      }));

      dRoot.querySelector<HTMLButtonElement>('[data-reset-tree]')?.addEventListener('click', () => {
        if (nodes[0]) showNode(nodes[0].dataset.decisionNode || '');
      });
    });

    // Failure Toggle (Actor Views)
    root.querySelectorAll<HTMLButtonElement>('[data-linux-failure-toggle]').forEach((button) => button.addEventListener('click', () => {
      const current = views[stage];
      if (current.id !== button.dataset.linuxFailureToggle) return;
      alternative = !alternative;
      button.setAttribute('aria-pressed', String(alternative));
      const target = current.querySelector<HTMLElement>('[data-linux-failure-result]')!;
      const alternate = button.dataset.linuxAlternateResult || '';
      target.textContent = alternative ? alternate : `Default fixture: ${current.dataset.viewExplanation || ''}`;
      const afterActors = JSON.parse(button.dataset.linuxAfterActors || '[]') as { label: string; detail: string }[];
      current.querySelectorAll<HTMLElement>('[data-linux-actor]').forEach((actor, index) => {
        const label = alternative ? afterActors[index]?.label : actor.dataset.linuxOriginalLabel;
        const detail = alternative ? afterActors[index]?.detail : actor.dataset.linuxOriginalDetail;
        actor.querySelector('strong')!.textContent = label || '';
        actor.querySelector('small')!.textContent = detail || '';
      });
      const statusEl = current.querySelector<HTMLElement>('[data-linux-visual-status]');
      if (statusEl) statusEl.textContent = alternative ? 'ALTERNATE FIXTURE' : 'BLOCKED FIXTURE';
      if (alternative) get('[data-linux-terminal-output]').textContent = button.dataset.linuxAlternateOutput || '';
      else get('[data-linux-terminal-output]').textContent = current.dataset.viewOutput || '';
      get('[data-linux-inspector-copy]').textContent = alternative ? alternate : current.dataset.viewExplanation || '';
      get('[data-linux-scenario-state]').textContent = alternative ? 'alternate state applied' : (current.dataset.viewStatus || 'blocked fixture');
      get('[data-linux-fact-state]').textContent = get('[data-linux-scenario-state]').textContent || '';
      get('[data-linux-fact-evidence]').textContent = alternative ? (button.dataset.linuxAlternateOutput || 'alternate fixture') : (current.dataset.viewEvidence || 'baseline fixture');
      diagram(current);
    }));

    // Listener Bind Scope Toggle (Networking)
    const binding = root.querySelector<HTMLElement>('[data-linux-listener]');
    binding?.querySelectorAll<HTMLButtonElement>('[data-linux-bind]').forEach((button) => button.addEventListener('click', () => {
      binding.querySelectorAll<HTMLButtonElement>('[data-linux-bind]').forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
      const mode = button.dataset.linuxBind;
      const output = mode === 'loopback' ? 'Only clients in this network namespace can use the loopback listener.' : mode === 'wildcard' ? 'Potentially reachable via all local IPv4 addresses; firewall, routing, and cloud controls still apply.' : 'Potentially reachable via 10.0.1.17 only; firewall, routing, and cloud controls still apply.';
      binding.querySelector<HTMLElement>('[data-linux-bind-result]')!.textContent = output;
      const actorsEl = views[stage].querySelectorAll<HTMLElement>('[data-linux-actor]');
      if (actorsEl.length > 0) {
        step = mode === 'loopback' ? 0 : mode === 'wildcard' ? 1 : 2;
        diagram(views[stage]);
      }
      get('[data-linux-terminal-output]').textContent = `LISTEN 0 511 ${mode === 'loopback' ? '127.0.0.1' : mode === 'wildcard' ? '0.0.0.0' : '10.0.1.17'}:443`;
      get('[data-linux-inspector-copy]').textContent = output;
      get('[data-linux-scenario-object]').textContent = `${mode === 'loopback' ? '127.0.0.1' : mode === 'wildcard' ? '0.0.0.0' : '10.0.1.17'}:443`;
      get('[data-linux-scenario-state]').textContent = 'listener bound; reachability unproven';
      get('[data-linux-fact-object]').textContent = get('[data-linux-scenario-object]').textContent || '';
      get('[data-linux-fact-state]').textContent = get('[data-linux-scenario-state]').textContent || '';
    }));

    // Troubleshooting Incident Matrix Selector
    root.querySelector<HTMLSelectElement>('[data-linux-scenario]')?.addEventListener('change', (event) => {
      const key = (event.currentTarget as HTMLSelectElement).value;
      const incident = incidents[key];
      alternative = false;
      const recovery = views[stage].querySelector<HTMLButtonElement>('[data-linux-failure-toggle]');
      if (recovery) {
        recovery.disabled = key !== 'loopback';
        recovery.setAttribute('aria-pressed', 'false');
        views[stage].querySelector<HTMLElement>('[data-linux-failure-result]')!.textContent = key === 'loopback' ? 'Default fixture: socket bound only to loopback.' : 'Recovery control applies to the loopback fixture. Select Loopback-only listener to use it.';
      }
      get('[data-linux-scenario-result]').textContent = incident.result;
      get('[data-linux-terminal-output]').textContent = incident.output;
      get('[data-linux-inspector-copy]').textContent = incident.result;
      get('[data-linux-scenario-object]').textContent = incident.actors[incident.blocked][0];
      get('[data-linux-scenario-state]').textContent = incident.actors[incident.blocked][1];
      get('[data-linux-fact-object]').textContent = incident.actors[incident.blocked][0];
      get('[data-linux-fact-state]').textContent = incident.actors[incident.blocked][1];
      get('[data-linux-fact-evidence]').textContent = incident.output.split('\n')[0];
      const statusEl = views[stage].querySelector<HTMLElement>('[data-linux-visual-status]');
      if (statusEl) statusEl.textContent = key.toUpperCase() + ' FIXTURE';
      views[stage].querySelectorAll<HTMLElement>('[data-linux-actor]').forEach((actor, index) => {
        actor.querySelector('strong')!.textContent = incident.actors[index][0];
        actor.querySelector('small')!.textContent = incident.actors[index][1];
        actor.dataset.blocked = String(index === incident.blocked);
      });
      step = incident.blocked;
      diagram(views[stage]);
    });

    root.classList.add('is-enhanced');
    root.querySelectorAll<HTMLElement>('[data-linux-enhancement]').forEach((element) => element.hidden = false);
    if (window.matchMedia('(max-width: 760px)').matches) menu.open = false;
    render();
  }
</script>
