---
import { getEntry } from 'astro:content';
import { linuxPillars } from './linux-data';
import ConsoleMasthead from '../ConsoleMasthead.astro';
const topic = await getEntry('topics', 'linux');
if (!topic) throw new Error('Linux foundation topic metadata is missing.');
const date = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const curriculum = [
  { number: 'I', title: 'Build the machine model', summary: 'Learn how Linux names principals and data, then connect paths, permissions, mounts, inodes, and open files.', ids: ['identity', 'storage'] },
  { number: 'II', title: 'Run and connect software', summary: 'Follow programs as processes, services, sockets, packages, and shell pipelines without losing the kernel objects underneath.', ids: ['processes', 'networking', 'packages', 'shell'] },
  { number: 'III', title: 'Protect and operate the host', summary: 'Layer security controls, read operational evidence, and isolate failures before changing a live system.', ids: ['security', 'troubleshooting'] },
];
---

<article class="linux-hub" aria-labelledby="linux-hub-title" data-linux-hub>
  <ConsoleMasthead className="linux-topbar" brandClass="linux-brand" activeHref="/foundations" />
  <header class="linux-hub-head">
    <div>
      <nav class="linux-crumb" aria-label="Breadcrumb">
        <a href="/">Library</a><span>/</span><a href="/foundations">Foundations</a><span>/</span><span aria-current="page">Linux</span>
      </nav>
      <span class="linux-kicker">LINUX FOUNDATIONS · COMPLETE VISUAL TUTORIAL</span>
      <h1 id="linux-hub-title">Understand the Linux machine—not just its commands.</h1>
      <p>Eight chapters build from identity and files to processes, networking, security, and incident diagnosis. Follow them in order for a complete foundation, or open any chapter as a working reference.</p>
    </div>
    <div class="linux-head-context">
      <span>REFERENCE HOST · devbox-01</span>
      <span>8 CHAPTERS · 64 VISUAL LESSONS · APPLIED CHECKS</span>
      <span>Published {date.format(topic.data.published)} · Reviewed {date.format(topic.data.reviewed ?? topic.data.published)}</span>
    </div>
  </header>

  <section class="linux-learning-contract" aria-labelledby="linux-learning-title">
    <div>
      <span class="linux-kicker">HOW TO USE THIS TUTORIAL</span>
      <h2 id="linux-learning-title">Learn the objects, watch the mechanism, then prove it.</h2>
    </div>
    <ol>
      <li><strong>Model</strong><span>Name the kernel objects and boundaries involved.</span></li>
      <li><strong>Mechanism</strong><span>Work through a concrete state change or decision.</span></li>
      <li><strong>Evidence</strong><span>Connect commands and output to the state they expose.</span></li>
      <li><strong>Practice</strong><span>Resolve a failure and answer a mechanism check.</span></li>
    </ol>
  </section>

  <!-- Foundational architecture lesson -->
  <section class="linux-map-section" aria-labelledby="linux-canvas-title">
    <div class="linux-map-heading">
      <div>
        <span class="linux-kicker">LESSON 0 · MACHINE ORIENTATION</span>
        <h2 id="linux-canvas-title">Place every later chapter inside one machine</h2>
      </div>
      <div class="linux-map-mode" role="group" aria-label="Simulate system scenarios">
        <button type="button" data-hub-trace="http" aria-pressed="true">Network request</button>
        <button type="button" data-hub-trace="file" aria-pressed="false">File read</button>
        <button type="button" data-hub-trace="container" aria-pressed="false">Container limits</button>
      </div>
    </div>

    <div class="linux-arch-canvas" aria-label="Interactive Linux Architecture Canvas">
      <!-- User Space Layer -->
      <div class="arch-layer arch-layer-userspace">
        <div class="arch-layer-head">
          <strong>USER SPACE (Ring 3 — Unprivileged Processes)</strong>
          <span>Isolated memory spaces · Cannot access hardware directly</span>
        </div>
        <div class="arch-components">
          <div class="arch-node" data-node-id="nginx-master">
            <span>PID 418 · root</span>
            <strong>nginx: master</strong>
            <small>Binds privileged TCP/443</small>
          </div>
          <div class="arch-node is-active" data-node-id="nginx-worker">
            <span>PID 421 · UID 33 (www-data)</span>
            <strong>nginx: worker</strong>
            <small>Handles HTTP/TLS traffic</small>
          </div>
          <div class="arch-node" data-node-id="bash">
            <span>PID 1024 · dev</span>
            <strong>bash shell</strong>
            <small>Interactive CLI session</small>
          </div>
          <div class="arch-node" data-node-id="container-app">
            <span>PID 2048 (namespaced)</span>
            <strong>containerized workload</strong>
            <small>Private PID & Net namespace</small>
          </div>
        </div>
      </div>

      <!-- Syscall Gateway Trap -->
      <div class="arch-layer-syscall">
        <span class="syscall-tag">CPU PRIVILEGE SWITCH</span>
        <strong>↕ SYSTEM CALL INTERFACE (Ring 3 Trap → Ring 0 Kernel Entry: socket(), epoll_wait(), openat(), read(), clone()) ↕</strong>
      </div>

      <!-- Kernel Space Layer -->
      <div class="arch-layer arch-layer-kernel">
        <div class="arch-layer-head">
          <strong>KERNEL SPACE (Ring 0 — Mediates All Hardware & Resources)</strong>
          <span>Full hardware privilege · Memory protection · Process scheduling</span>
        </div>
        <div class="arch-components">
          <div class="arch-node" data-node-id="vfs">
            <span>Filesystem Subsystem</span>
            <strong>VFS & Page Cache</strong>
            <small>Dentries, Inodes, ext4</small>
          </div>
          <div class="arch-node" data-node-id="sched">
            <span>Process Subsystem</span>
            <strong>CFS Scheduler & task_struct</strong>
            <small>Runqueues, Context switches</small>
          </div>
          <div class="arch-node is-active" data-node-id="netstack">
            <span>Networking Subsystem</span>
            <strong>TCP/IP Stack & Netfilter</strong>
            <small>Socket queues, Routing (FIB)</small>
          </div>
          <div class="arch-node" data-node-id="mm">
            <span>Memory Subsystem</span>
            <strong>Virtual Memory & MMU</strong>
            <small>Page tables, Copy-on-Write</small>
          </div>
          <div class="arch-node" data-node-id="cgroups">
            <span>Resource & Isolation</span>
            <strong>Namespaces & Cgroups v2</strong>
            <small>PID/Net/Mount, CPU/RAM limits</small>
          </div>
        </div>
      </div>

      <!-- Hardware & Drivers Layer -->
      <div class="arch-layer arch-layer-hardware">
        <div class="arch-layer-head">
          <strong>HARDWARE & DEVICE CONTROLLERS</strong>
          <span>Physical bare-metal or hypervisor-virtualized devices</span>
        </div>
        <div class="arch-components">
          <div class="arch-node" data-node-id="cpu">
            <span>Compute</span>
            <strong>CPU Cores & MMU</strong>
            <small>8 vCPUs · Ring 0 / Ring 3</small>
          </div>
          <div class="arch-node" data-node-id="ram">
            <span>Main Memory</span>
            <strong>Physical RAM</strong>
            <small>16 GB · 4KB Page Frames</small>
          </div>
          <div class="arch-node" data-node-id="disk">
            <span>Block Storage</span>
            <strong>NVMe /dev/vdb1</strong>
            <small>Mounted at /srv (ext4)</small>
          </div>
          <div class="arch-node is-active" data-node-id="nic">
            <span>Network Controller</span>
            <strong>eth0 (10.0.1.17)</strong>
            <small>RX/TX DMA Ring Buffers</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive Trace Explanation Box -->
    <div class="flow-trace-explainer" id="hub-explainer">
      <div>
        <p id="hub-trace-copy"><strong>HTTPS Ingress Flow:</strong> An Ethernet frame arrives on <code>eth0</code>. The NIC driver uses DMA to write to the RX ring buffer and triggers NAPI. Kernel Netfilter evaluates <code>PREROUTING</code>, the routing table confirms destination <code>10.0.1.17</code>, and the TCP payload is queued in the socket buffer. <code>epoll_wait()</code> wakes up <strong>nginx worker PID 421</strong> to read the HTTP request.</p>
      </div>
      <span class="step-badge" id="hub-step-badge">TRACE: PACKET → WORKER</span>
    </div>
  </section>

  <!-- Complete tutorial curriculum -->
  <section class="linux-curriculum" aria-labelledby="subsystem-grid-title">
    <div class="linux-map-heading">
      <div>
        <span class="linux-kicker">COMPLETE CURRICULUM</span>
        <h2 id="subsystem-grid-title">Eight chapters, in dependency order</h2>
      </div>
      <p>Each chapter stands alone, but later chapters deliberately reuse the objects established earlier.</p>
    </div>

    <div class="linux-curriculum-phases">
      {curriculum.map((phase) => (
        <section class="linux-curriculum-phase" aria-labelledby={`phase-${phase.number}`}>
          <header><span>PHASE {phase.number}</span><h3 id={`phase-${phase.number}`}>{phase.title}</h3><p>{phase.summary}</p></header>
          <div class="linux-chapter-list">
            {phase.ids.map((id) => {
              const pillar = linuxPillars.find((item) => item.id === id)!;
              return <a href={`/linux/${pillar.id}`} class="linux-chapter-card">
                <span class="linux-chapter-number">CHAPTER {String(pillar.chapter.number).padStart(2, '0')}</span>
                <strong>{pillar.name}</strong>
                <p>{pillar.chapter.foundation}</p>
                <dl><div><dt>Lessons</dt><dd>{pillar.views.length}</dd></div><div><dt>Applied task</dt><dd>{pillar.chapter.practice}</dd></div></dl>
                <b>Open chapter <span aria-hidden="true">→</span></b>
              </a>;
            })}
          </div>
        </section>
      ))}
    </div>
  </section>

  <!-- Machine Basics & Orientation -->
  <section class="linux-machine-basics" id="linux-machine" aria-labelledby="linux-machine-title">
    <div class="linux-basics-head">
      <span class="linux-kicker">ORIENTATION · DEVBOX-01</span>
      <h2 id="linux-machine-title">The Foundation of Cloud & Containers</h2>
      <p>Modern cloud infrastructure rests on these exact primitives. Containers do not run separate kernels; they are regular Linux processes running under namespaces and cgroups on this shared host.</p>
    </div>
    <div class="linux-orientation-pair">
      <div>
        <h3>From Boot to a Running Service</h3>
        <ol>
          <li><strong>Firmware & Bootloader:</strong> Initializes hardware and loads kernel image + initramfs into RAM.</li>
          <li><strong>Kernel Initialization:</strong> Mounts root filesystem, initializes device drivers, and starts PID 1.</li>
          <li><strong>Init System (systemd):</strong> Reads unit files, manages dependency trees, and starts services.</li>
          <li><strong>Application Worker:</strong> Master process forks unprivileged worker processes and binds sockets.</li>
        </ol>
        <p>Containers skip steps 1–3: the host kernel directly executes the container entrypoint inside isolated namespaces.</p>
      </div>
      <div>
        <h3>From / to a Resource</h3>
        <div class="linux-root-path">
          <code>/</code>
          <span>etc · system configuration</span>
          <span>home · user workspaces</span>
          <span>var · dynamic logs & databases</span>
          <span>proc · virtual kernel state & PIDs</span>
          <span>sys · hardware & device attributes</span>
          <span>dev · device node special files</span>
        </div>
        <p>“Everything is a file” is a useful shorthand, not a literal rule: many resources can be operated through file descriptors, while pathnames, sockets, devices, and kernel objects still have distinct semantics.</p>
      </div>
    </div>
  </section>

  <footer class="linux-hub-bottom">
    <div>
      <span class="linux-kicker">FOLLOW END TO END OR USE AS A REFERENCE</span>
      <p>Start with identity if Linux is new to you. If you are debugging a live host, open the relevant chapter and use its grouped lesson index, evidence panels, and applied check.</p>
    </div>
    <a href="/linux/identity">Start with Identity & Access →</a>
    <div class="linux-sitefoot">
      <span>Infra, Illustrated. · Linux foundations for cloud systems.</span>
      <a href="/visualizations">Browse all visuals ↗</a>
    </div>
  </footer>
</article>

<script>
  // Scenario Switcher for Host Architecture Canvas
  const traces: Record<string, { activeNodes: string[]; copy: string; badge: string }> = {
    http: {
      activeNodes: ['nic', 'netstack', 'nginx-worker'],
      copy: '<strong>HTTPS Ingress Flow:</strong> An Ethernet frame arrives on <code>eth0</code>. The NIC driver uses DMA to write to the RX ring buffer and triggers NAPI. Kernel Netfilter evaluates <code>PREROUTING</code>, the routing table confirms destination <code>10.0.1.17</code>, and the TCP payload is queued in the socket buffer. <code>epoll_wait()</code> wakes up <strong>nginx worker PID 421</strong> to read the HTTP request.',
      badge: 'TRACE: PACKET → WORKER'
    },
    file: {
      activeNodes: ['nginx-worker', 'vfs', 'disk', 'ram'],
      copy: '<strong>Static Asset Read Flow:</strong> Worker calls <code>openat("/srv/site/index.html", O_RDONLY)</code>. The CPU transitions to Ring 0 via syscall trap. VFS validates process UID 33 against directory traversal gates, locates the Inode, and checks Page Cache in RAM (Cache Hit = instant memory copy; Cache Miss = ext4 DMA read from NVMe <code>/dev/vdb1</code>).',
      badge: 'TRACE: WORKER → VFS → NVMe'
    },
    container: {
      activeNodes: ['container-app', 'cgroups', 'sched', 'mm'],
      copy: '<strong>Container Isolation Boundary:</strong> The container process is an ordinary Linux task, but the kernel restricts it using <strong>Namespaces</strong> (private PID 1, private Mount table, private virtual <code>veth</code> network) and throttles it using <strong>Cgroups v2</strong> (hard limits: 512MB RAM, 1 CPU quota).',
      badge: 'TRACE: NAMESPACES & CGROUPS'
    }
  };

  const hub = document.querySelector<HTMLElement>('[data-linux-hub]');
  if (hub) {
    const traceButtons = [...hub.querySelectorAll<HTMLButtonElement>('[data-hub-trace]')];
    const nodes = [...hub.querySelectorAll<HTMLElement>('.arch-node')];
    const copyEl = hub.querySelector<HTMLElement>('#hub-trace-copy');
    const badgeEl = hub.querySelector<HTMLElement>('#hub-step-badge');

    traceButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.dataset.hubTrace || 'http';
        const trace = traces[key];
        if (!trace) return;

        traceButtons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn === button)));
        nodes.forEach((node) => {
          node.classList.toggle('is-active', trace.activeNodes.includes(node.dataset.nodeId || ''));
        });

        if (copyEl) copyEl.innerHTML = trace.copy;
        if (badgeEl) badgeEl.textContent = trace.badge;
      });
    });
  }
</script>
