---
/**
 * HelmWorkbench.astro - View 1 & Persistent Visual Anchor
 * Interactive Three-Zone Workbench:
 * Zone 1: Workstation / CI (Compiler & local disk)
 * Boundary 1: Registry Boundary (Network only)
 * Zone 2: OCI / HTTP Registry (Immutable Packages)
 * Boundary 2: Cluster API Boundary (Kubernetes Auth / Mutation)
 * Zone 3: Kubernetes Cluster (Release Secrets vs Live Objects)
 */
---
<div class="helm-wb-container" data-helm-workbench>
  <div class="helm-wb-top-bar">
    <div class="helm-wb-hats-picker" role="radiogroup" aria-label="Select Helm Hat or Operation">
      <span class="helm-wb-label">THREE HATS:</span>
      <button type="button" class="helm-hat-btn is-active" data-hat="all" aria-pressed="true">
        <span class="dot"></span> All Zones Overview
      </button>
      <button type="button" class="helm-hat-btn" data-hat="template" aria-pressed="false">
        <span class="dot template"></span> 1. Template Compiler
      </button>
      <button type="button" class="helm-hat-btn" data-hat="package" aria-pressed="false">
        <span class="dot package"></span> 2. Package Manager
      </button>
      <button type="button" class="helm-hat-btn" data-hat="release" aria-pressed="false">
        <span class="dot release"></span> 3. Release Manager
      </button>
    </div>

    <div class="helm-wb-cmds-picker" role="group" aria-label="Quick command selector">
      <span class="helm-wb-label">HIGHLIGHT COMMAND:</span>
      <button type="button" class="helm-cmd-chip" data-cmd="template">helm template</button>
      <button type="button" class="helm-cmd-chip" data-cmd="lint">helm lint</button>
      <button type="button" class="helm-cmd-chip" data-cmd="pull">helm pull</button>
      <button type="button" class="helm-cmd-chip" data-cmd="package">helm package</button>
      <button type="button" class="helm-cmd-chip" data-cmd="push">helm push</button>
      <button type="button" class="helm-cmd-chip" data-cmd="upgrade">helm upgrade -i</button>
      <button type="button" class="helm-cmd-chip" data-cmd="rollback">helm rollback</button>
      <button type="button" class="helm-cmd-chip" data-cmd="status">helm status</button>
    </div>
  </div>

  <!-- Interactive 3-Zone Canvas -->
  <div class="helm-zones-grid">
    <!-- Zone 1: Workstation / CI -->
    <div class="helm-zone-panel is-zone-1" data-zone="1">
      <div class="zone-head">
        <span class="zone-badge">ZONE 01</span>
        <h4>Workstation / CI Runner</h4>
        <span class="zone-tag">LOCAL / OFFLINE</span>
      </div>
      <div class="zone-body">
        <div class="zone-box is-source">
          <div class="box-title">Chart Source Tree</div>
          <div class="box-items">
            <code>Chart.yaml (v1.2.0)</code>
            <code>Chart.lock (pinned)</code>
            <code>values.yaml + prod.yaml</code>
            <code>templates/ & charts/*.tgz</code>
          </div>
        </div>
        <div class="zone-arrow">↓ offline input</div>
        <div class="zone-box is-engine">
          <div class="box-title">Go Template Compiler</div>
          <p>Merges values layers, evaluates subchart scopes, compiles raw YAML.</p>
          <span class="box-stat">Zero K8s API calls</span>
        </div>
      </div>
    </div>

    <!-- Boundary 1: Registry -->
    <div class="helm-boundary-gate" data-gate="registry">
      <div class="gate-line"></div>
      <div class="gate-pill">
        <span class="gate-icon">⇄</span>
        <strong>Registry Gate</strong>
        <small class="gate-status">Network Only</small>
      </div>
      <div class="gate-line"></div>
    </div>

    <!-- Zone 2: OCI Registry -->
    <div class="helm-zone-panel is-zone-2" data-zone="2">
      <div class="zone-head">
        <span class="zone-badge">ZONE 02</span>
        <h4>OCI / HTTP Registry</h4>
        <span class="zone-tag">ARTIFACT STORE</span>
      </div>
      <div class="zone-body">
        <div class="zone-box is-repo">
          <div class="box-title">oci://registry.example.com</div>
          <div class="artifact-card">
            <span class="art-tag">OCI ARTIFACT</span>
            <strong>payment-api-1.2.0.tgz</strong>
            <small>Immutable Digest: sha256:7b4f...</small>
          </div>
          <div class="artifact-card prov">
            <span class="art-tag">PROVENANCE</span>
            <strong>payment-api-1.2.0.tgz.prov</strong>
            <small>GPG Cryptographic Signature</small>
          </div>
        </div>
        <div class="zone-summary">
          <span>Treats charts like container images (GHCR, ECR, Harbor).</span>
        </div>
      </div>
    </div>

    <!-- Boundary 2: Cluster API -->
    <div class="helm-boundary-gate" data-gate="cluster">
      <div class="gate-line"></div>
      <div class="gate-pill is-cluster">
        <span class="gate-icon">⚡</span>
        <strong>Cluster API Gate</strong>
        <small class="gate-status">K8s RBAC Required</small>
      </div>
      <div class="gate-line"></div>
    </div>

    <!-- Zone 3: Cluster -->
    <div class="helm-zone-panel is-zone-3" data-zone="3">
      <div class="zone-head">
        <span class="zone-badge">ZONE 03</span>
        <h4>Kubernetes Cluster (payments)</h4>
        <span class="zone-tag">STATE & RUNTIME</span>
      </div>
      <div class="zone-body">
        <!-- Shelf A: Helm Secret Ledger -->
        <div class="zone-box is-ledger">
          <div class="box-title">Helm Memory (Secret Ledger)</div>
          <div class="ledger-pills">
            <span class="rev superseded">v1</span>
            <span class="rev superseded">v2</span>
            <span class="rev deployed">v3 (deployed)</span>
          </div>
          <small>sh.helm.release.v1.payment-api.v*</small>
        </div>
        <div class="zone-arrow">↓ coordinates & observes</div>
        <!-- Shelf B: Live Cluster Objects -->
        <div class="zone-box is-runtime">
          <div class="box-title">Cluster Reality (Live Objects)</div>
          <div class="runtime-items">
            <span class="obj ok">Deployment: payment-api</span>
            <span class="obj ok">StatefulSet: postgresql</span>
            <span class="obj ok">StatefulSet: cache</span>
            <span class="obj ok">Service & ConfigMaps</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Readout Banner -->
  <div class="helm-wb-readout" data-helm-readout>
    <div class="readout-col main">
      <span class="readout-role-tag" data-r-role>ALL-IN-ONE OVERVIEW</span>
      <h3 data-r-title>Helm Wears Three Distinct Hats</h3>
      <p data-r-desc>Select any hat or command above to trace exactly which boundaries it crosses, what state it mutates, and where its memory lives.</p>
    </div>
    <div class="readout-col matrix">
      <div class="m-item"><span>RUNS ON:</span><strong data-r-host>Workstation / CI</strong></div>
      <div class="m-item"><span>NETWORK BOUNDARY:</span><strong data-r-net>Local / Offline by default</strong></div>
      <div class="m-item"><span>K8S MUTATION:</span><strong data-r-k8s>None (unless release commands)</strong></div>
      <div class="m-item"><span>STATE CREATED:</span><strong data-r-state>None (or Secret Ledger v1..vN)</strong></div>
    </div>
  </div>
</div>

<style>
.helm-wb-container {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  background: var(--surface-bg, #161a22);
  border: 1px solid var(--border-subtle, #30363d);
  border-radius: 8px;
  padding: 1.25rem;
}
.helm-wb-top-bar {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  border-bottom: 1px solid #21262d;
  padding-bottom: 1rem;
}
.helm-wb-label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #8b949e;
  margin-right: 0.4rem;
}
.helm-wb-hats-picker, .helm-wb-cmds-picker {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.45rem;
}
.helm-hat-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: #21262d;
  border: 1px solid #30363d;
  color: #c9d1d9;
  padding: 0.35rem 0.75rem;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.8rem;
  font-weight: 600;
  transition: all 0.15s ease;
}
.helm-hat-btn:hover { background: #30363d; }
.helm-hat-btn.is-active {
  background: #1f6feb;
  color: #fff;
  border-color: #58a6ff;
}
.helm-hat-btn .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #58a6ff;
}
.helm-hat-btn .dot.template { background: #388bfd; }
.helm-hat-btn .dot.package { background: #d29922; }
.helm-hat-btn .dot.release { background: #7ee787; }

.helm-cmd-chip {
  background: #0d1117;
  border: 1px solid #30363d;
  color: #79c0ff;
  font-family: monospace;
  font-size: 0.75rem;
  padding: 0.2rem 0.55rem;
  border-radius: 4px;
  cursor: pointer;
}
.helm-cmd-chip:hover { border-color: #58a6ff; }
.helm-cmd-chip.is-active {
  background: #1f242c;
  border-color: #7ee787;
  color: #7ee787;
  font-weight: bold;
}

/* 3-Zone Grid */
.helm-zones-grid {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1.25fr;
  align-items: stretch;
  gap: 0.5rem;
}
@media (max-width: 960px) {
  .helm-zones-grid {
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
}
.helm-zone-panel {
  background: #0d1117;
  border: 1px solid #30363d;
  border-radius: 6px;
  display: flex;
  flex-direction: column;
  padding: 0.85rem;
  gap: 0.75rem;
  transition: opacity 0.2s ease, border-color 0.2s ease;
}
.helm-zone-panel.is-dimmed {
  opacity: 0.35;
}
.helm-zone-panel.is-highlighted {
  border-color: #58a6ff;
  box-shadow: 0 0 12px rgba(88, 166, 255, 0.15);
}
.zone-head {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  border-bottom: 1px solid #21262d;
  padding-bottom: 0.4rem;
}
.zone-badge {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #8b949e;
}
.zone-head h4 {
  margin: 0;
  font-size: 0.95rem;
  color: #f0f6fc;
}
.zone-tag {
  font-size: 0.65rem;
  color: #58a6ff;
  font-weight: 600;
}
.zone-body {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  font-size: 0.78rem;
}
.zone-box {
  background: #161b22;
  border: 1px solid #30363d;
  border-radius: 4px;
  padding: 0.55rem;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.zone-box .box-title {
  font-size: 0.7rem;
  font-weight: 700;
  color: #8b949e;
  text-transform: uppercase;
}
.box-items code {
  display: block;
  font-size: 0.7rem;
  color: #c9d1d9;
}
.zone-arrow {
  text-align: center;
  font-size: 0.7rem;
  color: #8b949e;
}
.zone-box.is-engine p {
  margin: 0;
  font-size: 0.75rem;
  color: #8b949e;
}
.box-stat {
  font-size: 0.65rem;
  font-weight: 700;
  color: #7ee787;
}

/* Gate */
.helm-boundary-gate {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.25rem;
  min-width: 80px;
}
@media (max-width: 960px) {
  .helm-boundary-gate {
    flex-direction: row;
    padding: 0.5rem 0;
  }
}
.gate-line {
  flex: 1;
  width: 1px;
  background: #30363d;
}
@media (max-width: 960px) {
  .gate-line {
    width: auto;
    height: 1px;
    flex: 1;
  }
}
.gate-pill {
  background: #21262d;
  border: 1px solid #30363d;
  border-radius: 6px;
  padding: 0.4rem 0.5rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  font-size: 0.7rem;
  transition: all 0.2s ease;
}
.gate-pill.is-active {
  border-color: #58a6ff;
  background: #1c2d42;
  box-shadow: 0 0 10px rgba(88, 166, 255, 0.25);
}
.gate-pill.is-cluster.is-active {
  border-color: #7ee787;
  background: #173224;
  box-shadow: 0 0 10px rgba(126, 231, 135, 0.25);
}
.gate-icon { font-size: 0.8rem; }
.gate-pill strong { color: #f0f6fc; font-size: 0.7rem; white-space: nowrap; }
.gate-status { color: #8b949e; font-size: 0.625rem; white-space: nowrap; }

/* Zone 2 artifacts */
.artifact-card {
  background: #0d1117;
  border: 1px solid #30363d;
  border-radius: 4px;
  padding: 0.4rem 0.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}
.art-tag {
  font-size: 0.6rem;
  font-weight: 700;
  color: #d29922;
}
.artifact-card strong { font-size: 0.75rem; color: #e6edf3; }
.artifact-card small { font-size: 0.65rem; color: #8b949e; }
.zone-summary {
  font-size: 0.725rem;
  color: #8b949e;
  line-height: 1.35;
}

/* Zone 3 cluster */
.ledger-pills {
  display: flex;
  gap: 0.35rem;
}
.rev {
  padding: 0.1rem 0.4rem;
  border-radius: 3px;
  font-size: 0.65rem;
  font-family: monospace;
}
.rev.superseded {
  background: #21262d;
  color: #8b949e;
  text-decoration: line-through;
}
.rev.deployed {
  background: #238636;
  color: #fff;
  font-weight: bold;
}
.runtime-items {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}
.obj {
  font-size: 0.7rem;
  padding: 0.15rem 0.4rem;
  background: #0d1117;
  border-radius: 3px;
  border: 1px solid #30363d;
  color: #c9d1d9;
}
.obj.ok { border-left: 3px solid #7ee787; }

/* Readout */
.helm-wb-readout {
  background: #0d1117;
  border: 1px solid #30363d;
  border-radius: 6px;
  padding: 1rem;
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 1.5rem;
}
@media (max-width: 800px) {
  .helm-wb-readout {
    grid-template-columns: 1fr;
  }
}
.readout-role-tag {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #58a6ff;
  display: inline-block;
  margin-bottom: 0.2rem;
}
.readout-col.main h3 {
  margin: 0 0 0.35rem 0;
  font-size: 1.1rem;
  color: #f0f6fc;
}
.readout-col.main p {
  margin: 0;
  font-size: 0.825rem;
  color: #8b949e;
  line-height: 1.4;
}
.readout-col.matrix {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.6rem;
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 6px;
  padding: 0.75rem;
}
.m-item {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}
.m-item span {
  font-size: 0.625rem;
  font-weight: 700;
  color: #8b949e;
}
.m-item strong {
  font-size: 0.75rem;
  color: #e6edf3;
}
</style>
