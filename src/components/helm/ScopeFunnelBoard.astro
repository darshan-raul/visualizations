---
/**
 * ScopeFunnelBoard.astro - Lab 1: The Values & Subchart Scope Funnel
 * Shows the full compile pipeline in one view:
 * 1. Layered values merge (Chart defaults, -f values-prod.yaml, --set)
 * 2. Umbrella subchart declaration (with condition, alias, and the alias trap)
 * 3. Scoped values passing down to subcharts vs global
 * 4. Library chart (common-templates) define & include
 * 5. Live compiled multi-document Kubernetes YAML
 */
---
<div class="helm-funnel-board" data-helm-funnel-board>
  <div class="funnel-toolbar">
    <div class="funnel-controls-group">
      <span class="funnel-lbl">INTERACTIVE PRESETS:</span>
      <button type="button" class="funnel-btn is-active" data-funnel-preset="all">1. All Subcharts Enabled</button>
      <button type="button" class="funnel-btn" data-funnel-preset="cache-off">2. Toggle Cache Off (condition: cache.enabled)</button>
      <button type="button" class="funnel-btn is-warn" data-funnel-preset="alias-trap">3. The Alias Mismatch Trap</button>
      <button type="button" class="funnel-btn" data-funnel-preset="lib-only">4. Library Chart (type: library)</button>
    </div>
  </div>

  <div class="funnel-grid">
    <!-- Col 1: Inputs & Umbrella Declaration -->
    <div class="funnel-col col-inputs">
      <div class="panel-section">
        <div class="panel-title">1. Parent Chart.yaml (dependencies:)</div>
        <pre><code data-f-chart>dependencies:
  - name: postgresql
    version: "~16.2.0"
    repository: "https://charts.example.com"
    condition: postgresql.enabled
  - name: redis
    version: "20.1.4"
    repository: "oci://registry.example.com"
    alias: cache
    condition: cache.enabled
  - name: common-templates
    version: "1.0.0"
    repository: "file://../common-templates"</code></pre>
      </div>

      <div class="panel-section">
        <div class="panel-title">2. Parent values-production.yaml</div>
        <pre><code data-f-values>replicaCount: 5
image:
  repository: "payments/api"
  tag: "4.7.2"

# 1. Scoped to PostgreSQL subchart
postgresql:
  enabled: true
  auth:
    database: "payments"

# 2. Scoped to aliased Redis cache
cache:
  enabled: true
  architecture: "standalone"

# 3. Global (passed to ALL subcharts)
global:
  environment: "production"
  imagePullSecrets:
    - name: "reg-cred"</code></pre>
      </div>
    </div>

    <!-- Col 2: The Scope Router -->
    <div class="funnel-col col-router">
      <div class="panel-title">3. Helm Value Scope Router</div>
      
      <div class="scope-pipe-card is-parent">
        <div class="pipe-header">
          <span class="p-tag">PARENT APP</span>
          <strong>payment-api</strong>
        </div>
        <div class="pipe-data">
          <span>Sees: root keys (replicaCount, image) + global</span>
          <small class="pipe-status ok">✓ Compiles Deployment</small>
        </div>
      </div>

      <div class="scope-pipe-card is-subchart" data-pipe="pg">
        <div class="pipe-header">
          <span class="p-tag">SUBCHART</span>
          <strong>postgresql</strong>
        </div>
        <div class="pipe-data">
          <span>Receives: postgresql.* → .Values.* + global</span>
          <small class="pipe-status ok" data-pg-status>✓ Evaluates postgresql.enabled=true</small>
        </div>
      </div>

      <div class="scope-pipe-card is-subchart" data-pipe="cache">
        <div class="pipe-header">
          <span class="p-tag">ALIASED SUBCHART</span>
          <strong>cache (from redis)</strong>
        </div>
        <div class="pipe-data">
          <span>Receives: cache.* → .Values.* (NOT redis.*) + global</span>
          <small class="pipe-status ok" data-cache-status>✓ Evaluates cache.enabled=true</small>
        </div>
      </div>

      <div class="scope-pipe-card is-library">
        <div class="pipe-header">
          <span class="p-tag">SHARED LIBRARY</span>
          <strong>common-templates</strong>
        </div>
        <div class="pipe-data">
          <span>type: library (produces zero manifests)</span>
          <small class="pipe-status lib">Injects standard deployment helpers</small>
        </div>
      </div>

      <div class="scope-callout" data-f-callout>
        <strong>Scope Rule:</strong> Subcharts cannot see parent application keys. They only receive their dedicated section and <code>global:</code>.
      </div>
    </div>

    <!-- Col 3: Rendered YAML -->
    <div class="funnel-col col-output">
      <div class="panel-title">4. Compiled Multi-Document YAML</div>
      <div class="manifest-output-wrap">
        <pre><code data-f-output># Source: payment-api/charts/postgresql/templates/statefulset.yaml
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: payment-api-postgresql
spec:
  serviceName: payment-api-postgresql
---
# Source: payment-api/charts/cache/templates/statefulset.yaml
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: payment-api-cache
spec:
  replicas: 1
---
# Source: payment-api/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: payment-api
spec:
  replicas: 5
  template:
    spec:
      containers:
        - name: api
          image: "payments/api:4.7.2"</code></pre>
      </div>
    </div>
  </div>
</div>

<style>
.helm-funnel-board {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  background: var(--surface-bg, #161a22);
  border: 1px solid var(--border-subtle, #30363d);
  border-radius: 8px;
  padding: 1rem;
  font-size: 0.85rem;
}
.funnel-toolbar {
  border-bottom: 1px solid #21262d;
  padding-bottom: 0.75rem;
}
.funnel-controls-group {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.45rem;
}
.funnel-lbl {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #8b949e;
}
.funnel-btn {
  background: #21262d;
  border: 1px solid #30363d;
  color: #c9d1d9;
  padding: 0.3rem 0.65rem;
  border-radius: 4px;
  font-size: 0.78rem;
  cursor: pointer;
  transition: all 0.15s ease;
}
.funnel-btn:hover { background: #30363d; }
.funnel-btn.is-active {
  background: #1f6feb;
  color: #fff;
  border-color: #58a6ff;
  font-weight: 600;
}
.funnel-btn.is-warn.is-active {
  background: #d29922;
  border-color: #f1e05a;
  color: #000;
  font-weight: bold;
}

.funnel-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr 1.25fr;
  gap: 1rem;
}
@media (max-width: 980px) {
  .funnel-grid {
    grid-template-columns: 1fr;
  }
}
.funnel-col {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}
.panel-section {
  background: #0d1117;
  border: 1px solid #30363d;
  border-radius: 6px;
  overflow: hidden;
}
.panel-title {
  font-size: 0.725rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: #8b949e;
  text-transform: uppercase;
  background: #161b22;
  padding: 0.35rem 0.6rem;
  border-bottom: 1px solid #21262d;
}
.panel-section pre, .manifest-output-wrap pre {
  margin: 0;
  padding: 0.6rem;
  font-size: 0.75rem;
  color: #c9d1d9;
  line-height: 1.35;
}

.scope-pipe-card {
  background: #0d1117;
  border: 1px solid #30363d;
  border-radius: 5px;
  padding: 0.55rem;
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  border-left: 3px solid #58a6ff;
}
.scope-pipe-card.is-library { border-left-color: #d29922; }
.pipe-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.p-tag {
  font-size: 0.6rem;
  font-weight: 700;
  color: #8b949e;
}
.pipe-header strong { font-size: 0.78rem; color: #f0f6fc; }
.pipe-data {
  display: flex;
  flex-direction: column;
  font-size: 0.725rem;
  color: #8b949e;
}
.pipe-status.ok { color: #7ee787; font-weight: 600; }
.pipe-status.disabled { color: #8b949e; text-decoration: line-through; }
.pipe-status.trap { color: #f85149; font-weight: bold; }
.pipe-status.lib { color: #d29922; font-style: italic; }

.scope-callout {
  background: #1c2128;
  border-left: 3px solid #58a6ff;
  padding: 0.6rem;
  border-radius: 0 4px 4px 0;
  font-size: 0.75rem;
  color: #c9d1d9;
}
.manifest-output-wrap {
  background: #0d1117;
  border: 1px solid #30363d;
  border-radius: 6px;
  height: 100%;
}
</style>
