---
interface Props { eyebrow: string; title: string; description?: string; takeaway: string; class?: string; }
const { eyebrow, title, description, takeaway, class: className = '' } = Astro.props;
---
<figure class={`eni-visual ${className}`}>
  <figcaption class="eni-cap">
    <span>{eyebrow}</span>
    <h3>{title}</h3>
    {description && <p>{description}</p>}
  </figcaption>
  <div class="eni-canvas"><slot /></div>
  <p class="eni-takeaway"><strong>Keep this model:</strong> {takeaway}</p>
</figure>
