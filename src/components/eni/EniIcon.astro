---
interface Props {
  kind?: 'eni' | 'ec2' | 'route' | 'subnet' | 'shield' | 'service' | 'database' | 'gateway';
  label?: string;
}

const { kind = 'eni', label } = Astro.props;
const paths = {
  eni: '<rect x="7" y="10" width="34" height="28" rx="5"/><path d="M14 17h20M14 24h20M14 31h12M3 17h4M41 17h4M3 31h4M41 31h4"/>',
  ec2: '<path d="M12 8h24l7 7v18l-7 7H12l-7-7V15z"/><path d="M17 18h14v12H17zM20 14v4M28 14v4M20 30v4M28 30v4"/>',
  route: '<path d="M7 12h22M23 7l6 5-6 5M41 36H19M25 31l-6 5 6 5M29 12c8 0 12 4 12 12v12M19 36C11 36 7 32 7 24V12"/>',
  subnet: '<rect x="5" y="8" width="38" height="32" rx="4"/><path d="M13 16h8v8h-8zM27 16h8v8h-8zM13 28h8v5h-8zM27 28h8v5h-8z"/>',
  shield: '<path d="M24 5 40 11v12c0 10-6 16-16 21C14 39 8 33 8 23V11z"/><path d="m17 24 5 5 10-11"/>',
  service: '<path d="M24 5 42 15v18L24 43 6 33V15z"/><path d="m6 15 18 10 18-10M24 25v18"/>',
  database: '<ellipse cx="24" cy="11" rx="16" ry="6"/><path d="M8 11v26c0 3 7 6 16 6s16-3 16-6V11M8 24c0 3 7 6 16 6s16-3 16-6"/>',
  gateway: '<path d="M7 39V16l17-9 17 9v23M14 39V21h20v18M19 21v18M29 21v18"/>',
};
---
<span class={`eni-icon eni-icon--${kind}`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <svg viewBox="0 0 48 48" focusable="false" set:html={`<g>${paths[kind]}</g>`} />
</span>
