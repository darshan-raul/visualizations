---
import { promChallenges, promCheatsheet, type PromLab } from './prometheus-data';

interface Props {
  lab: PromLab;
}

const { lab } = Astro.props;
---

<div class="prom-lab-canvas" data-prom-canvas={lab.id}>
  {/* VIEW 1: MENTAL MODEL & ACME SHOP */}
  {lab.id === 'mental-model' && (
    <div class="canvas-panel model-panel">
      <div class="canvas-header-bar">
        <div class="arch-legend">
          <span class="legend-item"><i class="dot user"></i> User Traffic</span>
          <span class="legend-item"><i class="dot app"></i> ACME Microservices</span>
          <span class="legend-item"><i class="dot scrape"></i> HTTP Scrapes (15s)</span>
          <span class="legend-item"><i class="dot prom"></i> Prometheus Core</span>
        </div>
        <div class="arch-meta-chips">
          <span class="meta-chip">MONITORED TARGETS: <strong>11 ACTIVE</strong></span>
          <span class="meta-chip">INTERVAL: <strong>15s</strong></span>
          <span class="meta-chip">MODE: <strong>PULL TELEMETRY</strong></span>
        </div>
      </div>

      <div class="arch-svg-wrapper">
        <svg viewBox="0 0 1000 520" class="arch-svg" aria-label="ACME Shop Living Prometheus Architecture Diagram">
          <defs>
            <linearGradient id="promGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ea580c" />
              <stop offset="100%" stop-color="#c2410c" />
            </linearGradient>
            <linearGradient id="nodeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#1e293b" />
              <stop offset="100%" stop-color="#0f172a" />
            </linearGradient>
            <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="3" result="blur" />
              <feComposite in="SourceGraphic" in2="blur" operator="over" />
            </filter>
            <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M 0 1 L 8 5 L 0 9 z" fill="#64748b" />
            </marker>
            <marker id="arrowOrange" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M 0 1 L 8 5 L 0 9 z" fill="#f97316" />
            </marker>
          </defs>

          {/* User Traffic Ingress */}
          <rect x="420" y="15" width="160" height="40" rx="8" class="arch-box user-box" />
          <text x="500" y="35" class="box-title" text-anchor="middle">USER TRAFFIC</text>
          <text x="500" y="48" class="box-sub" text-anchor="middle" data-metric-user-traffic>340 req/s · 0.8% err</text>

          <path d="M 500 55 L 500 85" class="traffic-line" marker-end="url(#arrow)" />

          {/* ACME Shop Cluster Boundary */}
          <rect x="30" y="85" width="940" height="215" rx="12" class="cluster-boundary" />
          <text x="45" y="105" class="cluster-title">KUBERNETES CLUSTER (ACME SHOP — 3 WORKER NODES)</text>

          {/* Frontend & API Gateway */}
          <g class="clickable-node" data-node-id="api-gateway">
            <rect x="420" y="115" width="160" height="50" rx="6" class="node-box" />
            <text x="500" y="136" class="node-title" text-anchor="middle">API Gateway (2)</text>
            <text x="500" y="153" class="node-sub" text-anchor="middle" data-node-traffic="api-gateway">340 req/s · 38ms</text>
          </g>

          {/* Downstream Microservices */}
          <path d="M 460 165 L 200 205" class="traffic-line" marker-end="url(#arrow)" />
          <path d="M 500 165 L 500 205" class="traffic-line" marker-end="url(#arrow)" />
          <path d="M 540 165 L 800 205" class="traffic-line" marker-end="url(#arrow)" />

          {/* Checkout Service */}
          <g class="clickable-node" data-node-id="checkout">
            <rect x="110" y="205" width="180" height="60" rx="6" class="node-box service-box" />
            <text x="200" y="226" class="node-title" text-anchor="middle">Checkout (3)</text>
            <text x="200" y="242" class="node-sub" text-anchor="middle">checkout-1, 2, 3</text>
            <text x="200" y="256" class="node-metric" text-anchor="middle" data-node-traffic="checkout">140 req/s · 85ms</text>
          </g>

          {/* Catalog Service */}
          <g class="clickable-node" data-node-id="catalog">
            <rect x="410" y="205" width="180" height="60" rx="6" class="node-box service-box" />
            <text x="500" y="226" class="node-title" text-anchor="middle">Catalog (3)</text>
            <text x="500" y="242" class="node-sub" text-anchor="middle">catalog-1, 2, 3</text>
            <text x="500" y="256" class="node-metric" text-anchor="middle" data-node-traffic="catalog">210 req/s · 22ms</text>
          </g>

          {/* Payment Service */}
          <g class="clickable-node" data-node-id="payment">
            <rect x="710" y="205" width="180" height="60" rx="6" class="node-box service-box" />
            <text x="800" y="226" class="node-title" text-anchor="middle">Payment (2)</text>
            <text x="800" y="242" class="node-sub" text-anchor="middle">payment-1, 2</text>
            <text x="800" y="256" class="node-metric" text-anchor="middle" data-node-traffic="payment">85 req/s · 120ms</text>
          </g>

          {/* Databases */}
          <g class="clickable-node" data-node-id="postgres">
            <rect x="730" y="275" width="140" height="20" rx="4" class="db-box" />
            <text x="800" y="289" class="db-text" text-anchor="middle">PostgreSQL (1)</text>
          </g>
          <g class="clickable-node" data-node-id="redis">
            <rect x="130" y="275" width="140" height="20" rx="4" class="db-box" />
            <text x="200" y="289" class="db-text" text-anchor="middle">Redis Cache (1)</text>
          </g>

          {/* Scrape Lines Down to Prometheus */}
          <path d="M 200 265 L 200 320 L 320 360" class="scrape-pull-line" marker-end="url(#arrowOrange)" />
          <path d="M 500 265 L 500 360" class="scrape-pull-line" marker-end="url(#arrowOrange)" />
          <path d="M 800 265 L 800 320 L 680 360" class="scrape-pull-line" marker-end="url(#arrowOrange)" />
          <text x="360" y="335" class="scrape-label">HTTP GET /metrics (Pull)</text>

          {/* Dynamic Metric Sample Particles Container */}
          <g class="metric-particle-layer" data-particle-layer></g>

          {/* PROMETHEUS CORE SERVER */}
          <rect x="220" y="360" width="560" height="145" rx="12" class="prom-server-box" />
          <text x="240" y="385" class="prom-server-title">PROMETHEUS SERVER</text>
          <text x="760" y="385" class="prom-server-status" text-anchor="end">READY · PULL ENGINE</text>

          {/* Prometheus Subsystems */}
          <g class="clickable-node" data-node-id="scrape-manager">
            <rect x="240" y="400" width="120" height="90" rx="6" class="subsystem-box" />
            <text x="300" y="422" class="sub-title" text-anchor="middle">Scrape Mgr</text>
            <text x="300" y="440" class="sub-detail" text-anchor="middle">11 Targets</text>
            <text x="300" y="458" class="sub-detail" text-anchor="middle">15s Scrape</text>
            <text x="300" y="476" class="sub-metric" text-anchor="middle">100% Up</text>
          </g>

          <path d="M 360 445 L 380 445" class="internal-flow" marker-end="url(#arrow)" />

          <g class="clickable-node" data-node-id="tsdb">
            <rect x="380" y="400" width="120" height="90" rx="6" class="subsystem-box highlight" />
            <text x="440" y="422" class="sub-title" text-anchor="middle">TSDB</text>
            <text x="440" y="440" class="sub-detail" text-anchor="middle">Head + WAL</text>
            <text x="440" y="458" class="sub-detail" text-anchor="middle" data-prom-head-series>480 Series</text>
            <text x="440" y="476" class="sub-metric" text-anchor="middle">Gorilla Enc</text>
          </g>

          <path d="M 500 445 L 520 445" class="internal-flow" marker-end="url(#arrow)" />

          <g class="clickable-node" data-node-id="promql-engine">
            <rect x="520" y="400" width="120" height="90" rx="6" class="subsystem-box" />
            <text x="580" y="422" class="sub-title" text-anchor="middle">PromQL Engine</text>
            <text x="580" y="440" class="sub-detail" text-anchor="middle">Instant/Range</text>
            <text x="580" y="458" class="sub-detail" text-anchor="middle">AST Evaluator</text>
            <text x="580" y="476" class="sub-metric" text-anchor="middle">&lt; 4ms avg</text>
          </g>

          <path d="M 640 445 L 660 445" class="internal-flow" marker-end="url(#arrow)" />

          <g class="clickable-node" data-node-id="rule-engine">
            <rect x="660" y="400" width="105" height="90" rx="6" class="subsystem-box" />
            <text x="712" y="422" class="sub-title" text-anchor="middle">Rule Mgr</text>
            <text x="712" y="440" class="sub-detail" text-anchor="middle">Recording</text>
            <text x="712" y="458" class="sub-detail" text-anchor="middle">Alerting</text>
            <text x="712" y="476" class="sub-metric" text-anchor="middle">1m Eval</text>
          </g>

          {/* Outgoing to Alertmanager and Grafana */}
          <path d="M 765 430 L 870 415" class="external-flow" marker-end="url(#arrowOrange)" />
          <path d="M 640 470 L 870 470" class="external-flow" marker-end="url(#arrow)" />

          <g class="clickable-node" data-node-id="alertmanager">
            <rect x="870" y="395" width="110" height="42" rx="6" class="out-box alert-out" />
            <text x="925" y="415" class="out-title" text-anchor="middle">Alertmanager</text>
            <text x="925" y="428" class="out-sub" text-anchor="middle" data-alert-state>0 Firing</text>
          </g>

          <g class="clickable-node" data-node-id="grafana">
            <rect x="870" y="450" width="110" height="42" rx="6" class="out-box ui-out" />
            <text x="925" y="470" class="out-title" text-anchor="middle">Grafana UI</text>
            <text x="925" y="483" class="out-sub" text-anchor="middle">Dashboards</text>
          </g>
        </svg>
      </div>

      <div class="interactive-prompt-bar">
        <span>INTERACTIVE EXPLORATION: Click any component above (Services, Scrape Manager, TSDB, PromQL, Alertmanager) to inspect its runtime internals.</span>
        <button type="button" class="action-btn small" data-trigger-node="scrape-manager">Inspect Scrape Loop</button>
        <button type="button" class="action-btn small" data-trigger-node="tsdb">Inspect TSDB</button>
      </div>
    </div>
  )}

  {/* VIEW 2: METRIC ANATOMY */}
  {lab.id === 'metric-anatomy' && (
    <div class="canvas-panel anatomy-panel">
      <div class="anatomy-banner" aria-label="Dissected Prometheus metric string">
        <span class="anatomy-part metric-name active" data-part="name">
          <label>METRIC NAME</label>
          <strong>http_requests_total</strong>
        </span>
        <span class="anatomy-brace">&#123;</span>
        <span class="anatomy-part label-dim" data-part="label-service">
          <label>LABEL DIMENSION</label>
          <span>service="<strong>checkout</strong>"</span>
        </span>
        <span class="anatomy-comma">,</span>
        <span class="anatomy-part label-dim" data-part="label-method">
          <label>LABEL DIMENSION</label>
          <span>method="<strong>POST</strong>"</span>
        </span>
        <span class="anatomy-comma">,</span>
        <span class="anatomy-part label-dim" data-part="label-status">
          <label>LABEL DIMENSION</label>
          <span>status="<strong>500</strong>"</span>
        </span>
        <span class="anatomy-comma">,</span>
        <span class="anatomy-part label-dim" data-part="label-instance">
          <label>TARGET INSTANCE</label>
          <span>instance="<strong>checkout-2</strong>"</span>
        </span>
        <span class="anatomy-brace">&#125;</span>
        <span class="anatomy-part sample-value" data-part="value">
          <label>FLOAT64 VALUE</label>
          <strong data-sample-live-val>18421</strong>
        </span>
      </div>

      <div class="anatomy-explanation-card" data-anatomy-card>
        <h4 data-part-title>METRIC NAME: http_requests_total</h4>
        <p data-part-desc>Specifies the general feature of a system that is measured (e.g. <code>http_requests_total</code> for cumulative HTTP requests). By Prometheus convention, counter names end in <code>_total</code> and units like <code>_seconds</code> or <code>_bytes</code> are included in the base name.</p>
        <div class="anatomy-meta">
          <span>CHARACTER SET: <code>[a-zA-Z_:][a-zA-Z0-9_:]*</code></span>
          <span>RESERVED PREFIX: <code>__</code> (internal Prometheus use only)</span>
        </div>
      </div>

      <div class="sample-timeline-box">
        <h5>CONSECUTIVE SCRAPES TIMELINE (15s SCRAPE INTERVAL)</h5>
        <div class="timeline-rows">
          <div class="t-row"><span>12:00:00.000</span><div class="bar-fill" style="width: 72%;"></div><strong>18,201</strong></div>
          <div class="t-row"><span>12:00:15.000</span><div class="bar-fill" style="width: 76%;"></div><strong>18,234</strong><em class="delta">+33</em></div>
          <div class="t-row"><span>12:00:30.000</span><div class="bar-fill" style="width: 82%;"></div><strong>18,291</strong><em class="delta">+57</em></div>
          <div class="t-row"><span>12:00:45.000</span><div class="bar-fill" style="width: 88%;"></div><strong>18,340</strong><em class="delta">+49</em></div>
          <div class="t-row active"><span>12:01:00.000</span><div class="bar-fill active" style="width: 95%;"></div><strong data-sample-timeline-now>18,421</strong><em class="delta">+81</em></div>
        </div>
      </div>

      <div class="series-identity-callout">
        <strong>THE GOLDEN RULE OF PROMETHEUS TIME SERIES:</strong>
        <p>Metric Name + Exact Set of Key-Value Labels = <em>Unique Time Series ID</em>. Altering, adding, or deleting a single label creates a completely new time series with its own independent memory allocation in TSDB.</p>
      </div>
    </div>
  )}

  {/* VIEW 3: METRIC TYPES LABORATORY */}
  {lab.id === 'metric-types' && (
    <div class="canvas-panel types-panel">
      <div class="types-nav" role="tablist">
        <button type="button" class="type-tab is-active" data-type-tab="counter">Counter</button>
        <button type="button" class="type-tab" data-type-tab="gauge">Gauge</button>
        <button type="button" class="type-tab" data-type-tab="histogram">Histogram</button>
        <button type="button" class="type-tab" data-type-tab="summary">Summary</button>
      </div>

      <div class="type-tab-content is-active" data-type-view="counter">
        <div class="type-control-bar">
          <div>
            <span class="badge">COUNTER PRIMITIVE</span>
            <strong>http_requests_total</strong> — Monotonically increasing cumulative total
          </div>
          <div class="button-group">
            <button type="button" class="action-btn" data-counter-add="1">+1 Request</button>
            <button type="button" class="action-btn" data-counter-add="100">+100 Requests</button>
            <button type="button" class="action-btn warning" data-counter-reset>Restart Process (Reset to 0)</button>
          </div>
        </div>

        <div class="chart-dual-grid">
          <div class="chart-box">
            <h6>RAW COUNTER VALUE: <code>http_requests_total</code></h6>
            <svg viewBox="0 0 450 180" class="mini-chart" id="chart-raw-counter">
              <path class="chart-grid" d="M 40 20 L 430 20 M 40 60 L 430 60 M 40 100 L 430 100 M 40 140 L 430 140" />
              <path class="chart-line-orange" d="M 40 140 L 140 110 L 240 70 L 300 40 L 300 140 L 430 100" />
              <circle cx="300" cy="140" r="4" class="chart-dot reset" />
              <text x="305" y="130" class="chart-label reset">Process Restart (Reset to 0)</text>
            </svg>
            <p class="chart-caption">Raw counter drops to 0 when an application restarts. Never graph raw counters directly!</p>
          </div>

          <div class="chart-box">
            <h6>DERIVED RATE: <code>rate(http_requests_total[5m])</code></h6>
            <svg viewBox="0 0 450 180" class="mini-chart" id="chart-rate-counter">
              <path class="chart-grid" d="M 40 20 L 430 20 M 40 60 L 430 60 M 40 100 L 430 100 M 40 140 L 430 140" />
              <path class="chart-line-green" d="M 40 90 L 140 85 L 240 88 L 300 86 L 360 87 L 430 85" />
              <text x="240" y="70" class="chart-label">Steady ~25.4 req/sec (Reset smoothly handled)</text>
            </svg>
            <p class="chart-caption"><code>rate()</code> automatically detects counter resets and compensates by adding the pre-reset value.</p>
          </div>
        </div>
      </div>

      <div class="type-tab-content" data-type-view="gauge">
        <div class="type-control-bar">
          <div>
            <span class="badge">GAUGE PRIMITIVE</span>
            <strong>active_connections</strong> — Snapshot value that can freely increase or decrease
          </div>
          <div class="button-group">
            <button type="button" class="action-btn" data-gauge-delta="-5">-5 Connections</button>
            <button type="button" class="action-btn" data-gauge-delta="5">+5 Connections</button>
            <button type="button" class="action-btn" data-gauge-delta="25">+25 Surge</button>
          </div>
        </div>

        <div class="gauge-display-grid">
          <div class="gauge-metric-card">
            <span class="gauge-val" data-gauge-val>42</span>
            <label>CURRENT CONNECTIONS</label>
          </div>
          <div class="gauge-queries">
            <h6>AVAILABLE OVER-TIME OPERATORS (NEVER USE rate() ON A GAUGE):</h6>
            <div class="op-grid">
              <div class="op-item"><code>avg_over_time(active_connections[1h])</code><span>Mean connection level</span></div>
              <div class="op-item"><code>max_over_time(active_connections[1h])</code><span>Peak concurrency spike</span></div>
              <div class="op-item"><code>min_over_time(active_connections[1h])</code><span>Lowest trough</span></div>
              <div class="op-item"><code>predict_linear(disk_free[4h], 86400)</code><span>Linear exhaustion extrapolation</span></div>
            </div>
          </div>
        </div>
      </div>

      <div class="type-tab-content" data-type-view="histogram">
        <div class="type-control-bar">
          <div>
            <span class="badge">HISTOGRAM PRIMITIVE</span>
            <strong>http_request_duration_seconds</strong> — Cumulative latency buckets
          </div>
          <div class="slider-control">
            <label>Simulated Latency: <strong data-latency-display>185ms</strong></label>
            <input type="range" min="20" max="1200" value="185" class="prom-slider" data-latency-slider />
          </div>
        </div>

        <div class="buckets-visual">
          <div class="bucket-bar-row"><span>le="0.05" (50ms)</span><div class="b-bar"><div class="b-fill" style="width: 20%;"></div></div><strong>210</strong></div>
          <div class="bucket-bar-row"><span>le="0.1" (100ms)</span><div class="b-bar"><div class="b-fill" style="width: 45%;"></div></div><strong>480</strong></div>
          <div class="bucket-bar-row active"><span>le="0.25" (250ms)</span><div class="b-bar"><div class="b-fill active" style="width: 78%;"></div></div><strong>820</strong><em>&larr; Contains P95</em></div>
          <div class="bucket-bar-row"><span>le="0.5" (500ms)</span><div class="b-bar"><div class="b-fill" style="width: 92%;"></div></div><strong>960</strong></div>
          <div class="bucket-bar-row"><span>le="1.0" (1.0s)</span><div class="b-bar"><div class="b-fill" style="width: 98%;"></div></div><strong>1,020</strong></div>
          <div class="bucket-bar-row"><span>le="+Inf"</span><div class="b-bar"><div class="b-fill" style="width: 100%;"></div></div><strong>1,045</strong></div>
        </div>

        <div class="quantiles-formula-box">
          <code>histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))</code>
          <p>Calculates the 95th percentile across all instances by linearly interpolating between bucket boundaries <code>le="0.1"</code> and <code>le="0.25"</code>.</p>
        </div>
      </div>

      <div class="type-tab-content" data-type-view="summary">
        <div class="summary-comparison-box">
          <div class="compare-col">
            <h5>HISTOGRAM (PROMETHEUS WAY)</h5>
            <ul>
              <li>Buckets recorded independently per instance.</li>
              <li>Quantiles mathematically aggregatable across 100 instances via <code>histogram_quantile()</code>.</li>
              <li>High-cardinality overhead (10–20 series per metric).</li>
              <li>Bucket boundaries must be configured ahead of time.</li>
            </ul>
          </div>
          <div class="compare-col">
            <h5>SUMMARY (CLIENT-SIDE)</h5>
            <ul>
              <li>Quantiles (P50, P90, P99) calculated directly inside application RAM.</li>
              <li><strong>CANNOT BE AGGREGATED:</strong> You cannot average two P95 percentiles together mathematically!</li>
              <li>Low time-series footprint (only 3–4 series per instance).</li>
              <li>Extremely high CPU and memory overhead on client JVM/Go runtime.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  )}

  {/* VIEW 4: NATIVE HISTOGRAMS */}
  {lab.id === 'native-histograms' && (
    <div class="canvas-panel native-hist-panel">
      <div class="toggle-mode-bar">
        <span>HISTOGRAM FORMAT:</span>
        <div class="button-group">
          <button type="button" class="action-btn is-active" data-hist-mode="classic">Classic Buckets</button>
          <button type="button" class="action-btn" data-hist-mode="native">Native Histograms (Prometheus 3.8+)</button>
        </div>
      </div>

      <div class="hist-compare-display">
        <div class="hist-side classic-side is-active" data-hist-view="classic">
          <div class="hist-badge">CLASSIC CUMULATIVE MODEL</div>
          <h4>17 INDEPENDENT TIME SERIES CREATED</h4>
          <div class="series-list-preview">
            <code>http_request_duration_seconds_bucket&#123;le="0.005"&#125;</code>
            <code>http_request_duration_seconds_bucket&#123;le="0.01"&#125;</code>
            <code>http_request_duration_seconds_bucket&#123;le="0.025"&#125;</code>
            <code>http_request_duration_seconds_bucket&#123;le="0.05"&#125;</code>
            <code>... 12 more le bucket series ...</code>
            <code>http_request_duration_seconds_sum</code>
            <code>http_request_duration_seconds_count</code>
          </div>
          <div class="hist-tradeoff-box negative">
            <strong>Drawbacks:</strong> High TSDB memory overhead (17 series per pod x 20 pods = 340 series). Coarse resolution if latency lands between widely spaced bucket bounds.
          </div>
        </div>

        <div class="hist-side native-side" data-hist-view="native">
          <div class="hist-badge native">NATIVE HISTOGRAM SAMPLE</div>
          <h4>1 SINGLE COMPACT TIME SERIES</h4>
          <div class="native-sample-structure">
            <div class="struct-field"><span>count:</span><strong>18,420</strong></div>
            <div class="struct-field"><span>sum:</span><strong>1,245.82s</strong></div>
            <div class="struct-field"><span>schema:</span><strong>3 (Exponential factor 2^(2^-3))</strong></div>
            <div class="struct-field"><span>zero_threshold:</span><strong>0.001s</strong></div>
            <div class="struct-field"><span>positive_buckets:</span><strong>Sparse index array [0, 4, 12, 18, 45, 92, 114]</strong></div>
          </div>
          <div class="hist-tradeoff-box positive">
            <strong>Advantages:</strong> Up to 80% reduction in TSDB series churn, dynamic high-resolution quantile estimation, automatic handling of multi-modal latency distributions. Stable in Prometheus 3.8+.
          </div>
        </div>
      </div>
    </div>
  )}

