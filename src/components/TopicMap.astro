---
import { collections } from '../lib/catalog';
import type { TopicEdge, TopicNode } from '../lib/topic-graph';

interface Props { graph: { nodes: TopicNode[]; edges: TopicEdge[] }; immersive?: boolean }
const { graph, immersive = false } = Astro.props;
const degree = new Map(graph.nodes.map((node) => [node.id, graph.edges.filter((edge) => edge.source === node.id || edge.target === node.id).length]));
const ordered = graph.nodes.slice().sort((a, b) => (degree.get(b.id) || 0) - (degree.get(a.id) || 0) || a.id.localeCompare(b.id));
const positions = new Map<string, { x: number; y: number; size: number }>();
ordered.forEach((node, index) => {
  const angle = index * 2.399963;
  const radius = index === 0 ? 0 : 88 + Math.sqrt(index) * 98;
  const size = Math.min(118, 58 + (degree.get(node.id) || 0) * 4.2);
  const rawX = 600 + Math.cos(angle) * radius * 1.26 - size / 2;
  const rawY = 400 + Math.sin(angle) * radius * .82 - size / 2;
  positions.set(node.id, { x: Math.max(48, Math.min(1152 - size, rawX)), y: Math.max(64, Math.min(736 - size, rawY)), size });
});
---

<section class:list={["topic-map", { immersive }]} data-topic-map hidden aria-label="Interactive topic mesh">
  <div class="map-topbar">
    <label>
      <span>Find a node</span>
      <select data-map-select>
        <option value="">Choose a matching topic…</option>
        {graph.nodes.slice().sort((a, b) => a.title.localeCompare(b.title)).map((node) => <option value={node.id}>{node.title}</option>)}
      </select>
    </label>
    <div class="map-camera" aria-label="Map controls">
      <button type="button" data-camera="out" aria-label="Zoom out">−</button>
      <output data-map-scale aria-live="off">100%</output>
      <button type="button" data-camera="in" aria-label="Zoom in">+</button>
      <button type="button" data-camera="fit">Fit</button>
      <button type="button" data-camera="reset">Reset</button>
    </div>
  </div>

  <div class="map-stage">
    <div class="map-viewport" data-map-viewport tabindex="0" aria-label={immersive ? '3D topic map. Drag or use arrow keys to rotate. Select a topic for its summary.' : 'Pannable mesh of related infrastructure topics'}>
      <div class="map-world" data-map-world>
        <svg class="map-connectors" viewBox="0 0 1200 800" aria-hidden="true">
          {graph.edges.map((edge) => {
            const source = positions.get(edge.source)!;
            const target = positions.get(edge.target)!;
            return <line data-edge={edge.id} data-source={edge.source} data-target={edge.target} data-overview={String(edge.overview)} x1={source.x + source.size / 2} y1={source.y + source.size / 2} x2={target.x + target.size / 2} y2={target.y + target.size / 2} style={!edge.overview ? 'display:none' : undefined} />;
          })}
        </svg>
        {graph.nodes.map((node) => {
          const position = positions.get(node.id)!;
          return (
            <button
              class={`map-node collection-${node.collection}`}
              type="button"
              data-map-node={node.id}
              data-collection={node.collection}
              data-x={position.x}
              data-y={position.y}
              data-size={position.size}
              style={`--node-x:${position.x}px;--node-y:${position.y}px;--node-size:${position.size}px`}
              aria-pressed="false"
              aria-label={node.title}
            >
              <strong>{node.title}</strong>
              <span aria-hidden="true"></span>
              <small>{collections[node.collection].label}</small>
            </button>
          );
        })}
      </div>
      <div class="mesh-key" aria-label="Node collections">
        {Object.entries(collections).map(([slug, collection]) => <span class={`collection-${slug}`}><i></i>{collection.label}</span>)}
      </div>
      <div class="map-empty" data-map-empty hidden>
        <strong>No matching topics</strong>
        <span>Clear a filter or try a broader search.</span>
        <button type="button" data-map-clear>Clear filters</button>
      </div>
    </div>

    <aside class="map-inspector" data-map-inspector hidden aria-live="polite"></aside>
  </div>
  <p class="map-note">{immersive ? 'Drag to rotate · Select a topic to explore · Dashed lines connect related references' : 'Dashed lines connect related references. Select a topic for its summary. Drag to explore.'}</p>
</section>

<style>
  .topic-map[hidden] { display: none; }
  .topic-map { position: relative; margin-top: 14px; }
  .map-topbar { position: absolute; z-index: 8; top: 16px; right: 16px; left: 16px; display: flex; align-items: end; justify-content: space-between; gap: 14px; pointer-events: none; }
  .map-topbar > * { pointer-events: auto; }
  .map-topbar label { display: grid; width: min(350px, 56%); min-width: 0; gap: 5px; }
  .map-topbar label span { color: var(--dim); font: .55rem/1.2 var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  .map-topbar select { width: 100%; min-width: 0; height: 42px; padding: 0 36px 0 11px; border: 1px solid var(--border-strong); border-radius: 999px; background: rgba(9,14,23,.9); color: var(--text); backdrop-filter: blur(12px); }
  .map-camera { display: flex; gap: 5px; align-items: center; padding: 4px; border: 1px solid var(--border); border-radius: 999px; background: rgba(9,14,23,.88); backdrop-filter: blur(12px); }
  .map-camera button, .map-empty button { min-height: 36px; padding: 0 11px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); cursor: pointer; }
  .map-camera button:hover { background: rgba(255,255,255,.06); color: var(--text); }
  .map-camera button:first-child, .map-camera button:nth-of-type(2) { width: 36px; padding: 0; color: var(--cyan); font-size: 1.05rem; }
  .map-camera output { min-width: 40px; color: var(--dim); font: .58rem var(--mono); text-align: center; }
  .map-stage { position: relative; }
  .map-viewport { position: relative; min-height: 650px; overflow: hidden; border: 1px solid var(--border); border-radius: 16px; background: var(--bg); cursor: grab; touch-action: pan-y; }
  .immersive .map-viewport { min-height: clamp(560px, calc(100svh - 300px), 900px); }
  .map-viewport::after { position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(151,163,184,.17) .8px, transparent 1px); background-size: 17px 17px; content: ''; opacity: .28; pointer-events: none; mask-image: radial-gradient(circle at center, #000 15%, transparent 80%); }
  .map-viewport:active { cursor: grabbing; }
  .map-world { position: absolute; z-index: 2; width: 1200px; height: 800px; transform-origin: 0 0; will-change: transform; }
  .map-connectors { position: absolute; inset: 0; width: 1200px; height: 800px; overflow: visible; pointer-events: none; }
  .map-connectors line { stroke: rgba(151,163,184,.2); stroke-width: 1; stroke-dasharray: 3 6; vector-effect: non-scaling-stroke; }
  .map-connectors line.is-active { stroke: var(--cyan); stroke-opacity: .65; stroke-width: 1.4; }
  .map-node { position: absolute; left: var(--node-x); top: var(--node-y); width: var(--node-size); height: var(--node-size); padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--text); cursor: pointer; transition: opacity .2s ease, filter .2s ease; }
  .map-node > span { position: absolute; inset: 34%; border: 1px solid var(--collection-accent); border-radius: 50%; background: color-mix(in srgb, var(--collection-accent) 18%, var(--bg)); box-shadow: 0 0 0 6px color-mix(in srgb, var(--collection-accent) 4%, transparent); transition: border-color .2s ease, box-shadow .2s ease; }
  .map-node strong { position: absolute; z-index: 2; bottom: calc(66% + 10px); left: 50%; width: max-content; max-width: 175px; transform: translateX(-50%); color: #c6d1e3; font: 500 .9rem/1.35 var(--sans); letter-spacing: -.015em; text-align: center; text-shadow: 0 2px 8px var(--bg), 0 0 12px var(--bg); }
  .map-node small { position: absolute; z-index: 2; top: calc(80% + 3px); left: 50%; transform: translateX(-50%); color: var(--collection-accent); font: .45rem var(--mono); letter-spacing: .08em; opacity: 0; text-transform: uppercase; transition: opacity .2s ease; white-space: nowrap; }
  .map-node:hover > span, .map-node:focus-visible > span { inset: 34%; border-color: var(--collection-accent); box-shadow: 0 0 0 6px color-mix(in srgb, var(--collection-accent) 8%, transparent), 0 12px 32px rgba(0,0,0,.5); }
  .map-node:hover strong, .map-node:focus-visible strong { color: var(--text); }
  .map-node:hover small, .map-node:focus-visible small { opacity: 1; }
  .map-node[aria-pressed="true"] > span { inset: 30%; border: 2px solid var(--collection-accent); background: var(--collection-accent); box-shadow: 0 0 0 8px color-mix(in srgb, var(--collection-accent) 10%, transparent); }
  .map-node[aria-pressed="true"] strong { color: var(--text); font-size: .9rem; }
  .map-node[aria-pressed="true"] small { opacity: 1; }
  .map-node.is-neighbor > span { border-color: color-mix(in srgb, var(--collection-accent) 85%, white 5%); }
  .map-node.is-muted { opacity: .55; }
  .map-node.is-muted:hover, .map-node.is-muted:focus-visible { opacity: 1; }
  .map-node[hidden] { display: none; }
  .mesh-key { position: absolute; z-index: 4; bottom: 18px; left: 20px; right: 20px; display: flex; flex-wrap: wrap; gap: 14px; color: var(--muted); font: .58rem var(--mono); pointer-events: none; }
  .mesh-key span { display: inline-flex; align-items: center; gap: 7px; }
  .mesh-key i { width: 6px; height: 6px; border-radius: 50%; background: var(--collection-accent); box-shadow: 0 0 10px color-mix(in srgb, var(--collection-accent) 30%, transparent); }
  .map-inspector { position: absolute; z-index: 10; top: 84px; right: 16px; width: min(370px, calc(100% - 32px)); height: calc(100% - 100px); overflow: auto; padding: 27px; border: 1px solid var(--border-strong); border-radius: 14px; background: rgba(12,17,26,.96); box-shadow: 0 16px 60px rgba(0,0,0,.3); backdrop-filter: blur(18px); }
  .map-inspector[hidden] { display: none; }
  .map-inspector :global(.inspector-close) { position: sticky; z-index: 2; top: 0; float: right; width: 38px; height: 38px; border: 1px solid var(--border-strong); border-radius: 50%; background: var(--surface); color: var(--muted); cursor: pointer; }
  .map-inspector :global(.inspector-kicker) { display: block; padding-top: 8px; color: var(--cyan); font: .58rem var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  .map-inspector :global(h2) { clear: both; margin: 42px 0 13px; font-size: clamp(1.8rem, 4vw, 2.5rem); line-height: 1.02; letter-spacing: -.04em; }
  .map-inspector :global(p) { color: var(--muted); font-size: .95rem; line-height: 1.65; }
  .map-inspector :global(.inspector-meta) { display: flex; flex-wrap: wrap; gap: 6px; margin: 18px 0; padding: 0; list-style: none; }
  .map-inspector :global(.inspector-meta li) { padding: 5px 8px; border: 1px solid var(--border); border-radius: 999px; color: var(--dim); font: .55rem var(--mono); text-transform: capitalize; }
  .map-inspector :global(.inspector-open) { display: inline-flex; min-height: 44px; align-items: center; margin: 4px 0 24px; padding: 0 18px; border: 1px solid #42d6e850; border-radius: 10px; background: #42d6e815; color: var(--cyan); font-size: .78rem; font-weight: 600; text-decoration: none; }
  .map-inspector :global(.inspector-open:hover) { background: #42d6e825; }
  .map-inspector :global(.inspector-related) { margin-top: 8px; padding-top: 21px; border-top: 1px solid var(--border); }
  .map-inspector :global(.inspector-related h3) { margin: 0 0 12px; color: var(--dim); font: .58rem var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .map-inspector :global(.inspector-related ul) { display: flex; flex-wrap: wrap; gap: 7px; margin: 0; padding: 0; list-style: none; }
  .map-inspector :global(.inspector-related li) { width: 100%; }
  .map-inspector :global(.inspector-related button) { width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; background: #ffffff03; color: var(--text); text-align: left; cursor: pointer; }
  .map-inspector :global(.inspector-related button:hover) { border-color: #42d6e850; background: #42d6e809; }
  .map-inspector :global(.inspector-related button strong) { font-size: .67rem; font-weight: 500; }
  .map-inspector :global(.inspector-related button span) { display: block; margin-top: 5px; color: var(--muted); font: .6rem/1.5 var(--mono); }
  .map-inspector :global(.inspector-reason) { margin: 16px 0 0; padding: 13px; border-radius: 8px; background: rgba(66,214,232,.055); color: var(--muted); font: .58rem/1.55 var(--mono); }
  .map-inspector :global(.inspector-more) { width: 100%; margin-top: 7px; }
  .map-inspector :global(.inspector-more summary) { padding: 8px 0; color: var(--cyan); font: .6rem var(--mono); cursor: pointer; }
  .map-empty { position: absolute; z-index: 12; inset: 0; display: grid; place-content: center; gap: 8px; background: rgba(8,13,21,.94); text-align: center; }
  .map-empty[hidden] { display: none; }
  .map-empty span { color: var(--muted); font-size: .75rem; }
  .map-empty button { margin-top: 7px; border: 1px solid var(--border); color: var(--cyan); }
  .map-note { margin: 9px 2px 0; color: var(--dim); font: .56rem/1.5 var(--mono); }
  @media (max-width: 700px) { .map-topbar { align-items: stretch; flex-direction: column; } .map-topbar label { width: 100%; } .map-camera { align-self: flex-start; } .map-viewport, .immersive .map-viewport { min-height: 590px; } .map-inspector { position: relative; top: auto; right: auto; width: 100%; min-height: 0; height: auto; margin-top: 10px; border-radius: 14px; } }
  @media (prefers-reduced-motion: reduce) { .map-node, .map-node > span, .map-node small { transition: none; } }
</style>
