---
import '../../styles/iam.css';
import WorkflowDiagram from '../WorkflowDiagram.astro';

const scenarios = [
  {
    id: 'human-assume-role',
    number: '01',
    title: 'Human-operated AssumeRole',
    summary: 'A person uses an already authenticated IAM principal to request a different role session.',
    lanes: ['Human + CLI', 'Caller identity', 'AWS STS', 'Target account'],
    steps: [
      ['Human + CLI', 'Select starting credentials', '--profile engineer', 'The person operates the CLI, but an IAM user or existing federated session is the AWS principal that signs the request. STS does not authenticate a human body directly.'],
      ['Human + CLI', 'Request the target role', 'aws sts assume-role --role-arn … --role-session-name darshan', 'The signed AssumeRole request names the role and supplies session parameters.'],
      ['Caller identity', 'Authorize sts:AssumeRole', 'Identity policy → target role ARN', 'For cross-account access, the caller side must delegate permission to request this role.'],
      ['Target account', 'Check who may assume', 'Role trust policy → caller principal', 'The target role trust policy accepts the caller and evaluates conditions such as MFA, tags, source identity, or external ID when configured.'],
      ['AWS STS', 'Create the session', 'AssumeRole', 'STS returns a new temporary credential set. The starting credentials still exist; the result is a separate credential context.'],
      ['Target account', 'Identify the new principal', 'arn:aws:sts::222222222222:assumed-role/AppSupportRole/darshan', 'Requests signed with the new credentials are made by the role session, not by the human or original caller ARN.'],
      ['Human + CLI', 'Call an AWS service', 'SigV4 + session token', 'The service authorizes the action using the target role session and its request context.'],
    ],
  },
  {
    id: 'role-chaining',
    number: '02',
    title: 'Role assumes another role',
    summary: 'A workload or existing role session uses its temporary credentials to request a second role session.',
    lanes: ['Workload', 'Source role session', 'AWS STS', 'Target role'],
    steps: [
      ['Workload', 'Receive source-role credentials', 'RoleA session credentials', 'A compute credential provider or earlier federation step supplies temporary credentials for RoleA.'],
      ['Source role session', 'Sign another request', 'sts:AssumeRole → RoleB', 'The principal making this request is the RoleA session. This is role chaining.'],
      ['Source role session', 'Permit the target', 'RoleA policy allows sts:AssumeRole', 'RoleA’s effective permissions must allow the request to RoleB. Permissions held before RoleA are not carried forward automatically.'],
      ['Target role', 'Trust the source', 'RoleB trust policy accepts RoleA', 'The target trust policy identifies the source role or its account and evaluates any conditions.'],
      ['AWS STS', 'Create a second session', 'RoleB session credentials', 'STS issues another access key, secret key, session token, and expiration. Role chaining limits this session to one hour.'],
      ['Target role', 'Apply target permissions', 'RoleB policies ∩ optional session policy', 'The new session is based on RoleB. It does not accumulate the permissions of RoleA and RoleB.'],
      ['Workload', 'Use the RoleB session', 'SigV4 request', 'The workload selects the second credential set to call the destination service.'],
    ],
  },
  {
    id: 'identity-center',
    number: '03',
    title: 'CLI + Identity Center',
    summary: 'A browser sign-in becomes a cached Identity Center session, then short-lived AWS role credentials.',
    lanes: ['Local machine', 'Identity provider', 'AWS identity plane', 'AWS service'],
    steps: [
      ['Local machine', 'Read profile', '~/.aws/config', 'The profile names an SSO session, AWS account, and role name. It contains routing information, not AWS secret keys.'],
      ['Local machine', 'Start login', 'aws sso login --profile prod', 'The CLI starts an OAuth 2.0 authorization flow. Current AWS CLI v2 uses PKCE by default; device authorization is optional.'],
      ['Identity provider', 'Authenticate the human', 'Browser sign-in', 'The configured identity source authenticates the person. IAM Identity Center then applies the user or group account assignment.'],
      ['Local machine', 'Cache the SSO session', '~/.aws/sso/cache', 'The CLI caches the Identity Center access and refresh tokens. This cache is not a store of permanent IAM access keys.'],
      ['AWS identity plane', 'Request role credentials', 'GetRoleCredentials(account, role)', 'For an AWS command, the credential provider exchanges the valid access token for credentials associated with the selected account and role.'],
      ['Local machine', 'Receive temporary credentials', 'Access key + secret key + session token + expiration', 'The credential set represents a session of the IAM Identity Center-managed AWSReservedSSO role.'],
      ['AWS service', 'Authorize a signed request', 'SigV4 request + session token', 'The CLI signs the service request. The receiving AWS service evaluates the role session and the request context against applicable policies.'],
    ],
  },
  {
    id: 'vendor',
    number: '04',
    title: 'Vendor access + ExternalId',
    summary: 'The vendor binds each AssumeRole request to the customer tenant that caused it.',
    lanes: ['Customer request', 'Vendor account', 'Customer AWS account', 'AWS STS'],
    steps: [
      ['Customer request', 'Identify the tenant', 'Tenant = darshan', 'The vendor authenticates its customer and looks up that customer’s configured role ARN and vendor-generated external ID.'],
      ['Vendor account', 'Construct the request', 'RoleArn + ExternalId=darshan-789', 'The external ID is supplied by the vendor. It is a tenant-binding value, not a password or replacement for the trusted principal.'],
      ['Customer AWS account', 'Check the role trust', 'Principal=vendor; sts:ExternalId=darshan-789', 'The trust policy requires both the vendor principal and the expected external ID.'],
      ['AWS STS', 'Issue the vendor session', 'AssumeRole succeeds', 'A matching request receives temporary credentials for the customer role.'],
      ['Customer request', 'Try the confused deputy path', 'Attacker supplies Darshan’s role ARN', 'Role ARNs are identifiers, not secrets. Another vendor customer may learn or guess a role ARN.'],
      ['Vendor account', 'Bind the attacker’s tenant', 'ExternalId=attacker-123', 'A correctly designed vendor chooses the external ID from its authenticated tenant record; the attacker cannot select Darshan’s value.'],
      ['Customer AWS account', 'Reject the mismatch', 'Expected darshan-789 ≠ attacker-123', 'The trust-policy condition fails, so STS does not issue a session for the attacker-triggered request.'],
    ],
  },
];
---

<div class="identity-explorer" data-identity-explorer>
  <div class="iam-scenario-picker" hidden>
    <span id="identity-scenario-label">Choose a credential journey</span>
    <div role="group" aria-labelledby="identity-scenario-label">
      {scenarios.map((scenario, index) => (
        <button type="button" aria-pressed={index === 0} data-identity-option={scenario.id}>
          <small>{scenario.number}</small><strong>{scenario.title}</strong><span>{scenario.summary}</span>
        </button>
      ))}
    </div>
  </div>

  {scenarios.map((scenario) => (
    <section class="identity-scenario" data-identity-scenario={scenario.id} aria-labelledby={`identity-${scenario.id}`}>
      <header>
        <span class="content-kicker">Credential journey {scenario.number}</span>
        <h3 id={`identity-${scenario.id}`}>{scenario.title}</h3>
        <p>{scenario.summary}</p>
      </header>
      <WorkflowDiagram id={`identity-flow-${scenario.id}`} lanes={scenario.lanes} steps={scenario.steps} />
    </section>
  ))}
</div>

<script>
  for (const explorer of document.querySelectorAll<HTMLElement>('[data-identity-explorer]')) {
    const options = [...explorer.querySelectorAll<HTMLButtonElement>('[data-identity-option]')];
    const scenarios = [...explorer.querySelectorAll<HTMLElement>('[data-identity-scenario]')];
    let active = scenarios[0];

    options.forEach((option) => option.addEventListener('click', () => {
      active = scenarios.find((scenario) => scenario.dataset.identityScenario === option.dataset.identityOption)!;
      options.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === option)));
      scenarios.forEach((scenario) => { scenario.hidden = scenario !== active; });
      active.querySelector('[data-workflow]')!.dispatchEvent(new Event('workflow-reset'));
    }));

    explorer.querySelector<HTMLElement>('.iam-scenario-picker')!.hidden = false;
    scenarios.forEach((scenario) => { scenario.hidden = scenario !== active; });
  }
</script>
