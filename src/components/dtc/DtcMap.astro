---
import { MAP, NODES, RINGS, point, type NodeId, type Route } from './dtc-lesson';
import { RATES, rate } from './rates';
interface Props { id: string; rings: number; routes: Route[]; context?: NodeId[]; fresh?: boolean }
const { id, rings, routes, context = [], fresh = false } = Astro.props;
const { cx, cy, radii } = MAP;
const DEVICES = new Set<NodeId>(['natA', 'natB', 'gwe', 'ife', 'alb', 'tgw', 'cf', 'vpn', 'dx']);
const round = (value: number) => Math.round(value * 10) / 10;
const heat = (value: number) => value === 0 ? 'free' : value >= 0.05 ? 'top' : value >= 0.02 ? 'high' : 'low';

const bands = RINGS.slice(0, rings).map((ring, index) => ({
  ...ring, index, r: radii[index],
  // The core's name sits at its foot so routes can cross the top; outer names sit at the top of their band.
  labelY: index === 0 ? cy + radii[0] - 9 : cy - (radii[index - 1] + radii[index]) / 2 + 4,
})).reverse();

const drawn = routes.map((route, slot) => {
  const raw = route.path.map(point);
  const whole = { x: raw[raw.length - 1].x - raw[0].x, y: raw[raw.length - 1].y - raw[0].y };
  const span = Math.hypot(whole.x, whole.y) || 1;
  const shift = route.shift ?? 0;
  const points = raw.map((p) => ({ x: p.x + (-whole.y / span) * shift, y: p.y + (whole.x / span) * shift }));
  const hops = points.slice(1).map((to, hop) => {
    const from = points[hop];
    const length = Math.hypot(to.x - from.x, to.y - from.y) || 1;
    const ux = (to.x - from.x) / length;
    const uy = (to.y - from.y) / length;
    // One chip per charge on this hop; a hop with nothing to pay gets a single "free".
    const onHop = route.charges.filter((charge) => charge.hop === hop);
    const billed = onHop.filter((charge) => charge.rate > 0);
    const charges = billed.length ? billed : onHop.slice(0, 1);
    // Chips sit beside the hop, on the side facing away from the map's centre.
    const mid = { x: (from.x + to.x) / 2, y: (from.y + to.y) / 2 };
    const outward = (-uy * (mid.x - cx) + ux * (mid.y - cy)) >= 0 ? 1 : -1;
    const side = shift ? Math.sign(shift) : outward;
    const chips = charges.map((charge, row) => {
      const text = charge.rate === 0 ? 'free' : `+${rate(charge.rate)}`;
      const width = Math.round(text.length * 6.4 + 12);
      const away = 15 + row * 17;
      return { text, width, tone: heat(charge.rate), x: round(mid.x + -uy * side * away), y: round(mid.y + ux * side * away) };
    });
    return { hop, length, chips, d: `M${round(from.x + ux * 11)} ${round(from.y + uy * 11)} L${round(to.x - ux * 14)} ${round(to.y - uy * 14)}` };
  });
  const total = hops.reduce((sum, hop) => sum + hop.length, 0);
  let travelled = 0;
  const stops = [0, ...hops.map((hop) => { travelled += hop.length; return round((travelled / total) * 100); })];
  const paid = route.charges.some((charge) => charge.rate > 0);
  const badge = route.mark && { text: route.mark, x: round(points[0].x + (points[1].x - points[0].x) * 0.5), y: round(points[0].y + (points[1].y - points[0].y) * 0.5) };
  return { route, slot, hops, stops, paid, badge: shift ? undefined : badge, track: `M${points.map((p) => `${round(p.x)} ${round(p.y)}`).join(' L')}` };
});

const onRoute = new Set(routes.flatMap((route) => route.path));
const shown = [...new Set<NodeId>([...context, ...onRoute])];
const labelAt = (node: NodeId) => {
  const { x, y } = point(node);
  const side = NODES[node].side;
  if (side === 'right') return { x: x + 12, y: y + 4, anchor: 'start' };
  if (side === 'left') return { x: x - 12, y: y + 4, anchor: 'end' };
  if (side === 'above') return { x, y: y - 12, anchor: 'middle' };
  return { x, y: y + 20, anchor: 'middle' };
};
const spoken = routes.length
  ? routes.map((route) => `${route.path.map((node) => NODES[node].label).join(' to ')}: ${route.charges.map((charge) => `${charge.what}, ${charge.rate === 0 ? 'free' : `${rate(charge.rate)} per gigabyte`}`).join('; ')}.`).join(' ')
  : `The instance at the centre with ${shown.length - 1} destinations and devices around it.`;
---
<svg class="dtc-map" viewBox={`0 0 ${MAP.width} ${MAP.height}`} role="img" aria-labelledby={`${id}-map-title ${id}-map-desc`}>
  <title id={`${id}-map-title`}>Distance rings around app in {RATES.homeAz}</title>
  <desc id={`${id}-map-desc`}>{bands.length} of 4 rings shown: {bands.slice().reverse().map((band) => `${band.name}, ${band.price}`).join('; ')}. {spoken}</desc>
  <defs>
    {['free', 'paid'].map((tone) => <marker id={`${id}-arrow-${tone}`} class={`dtc-arrow is-${tone}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M1 1 L9 5 L1 9 Z" /></marker>)}
  </defs>
  <g aria-hidden="true">
    {bands.map((band) => <circle class:list={['dtc-ring', `is-${band.tone}`, band.index === 1 && 'is-loud', fresh && band.index === rings - 1 && 'is-new']} cx={cx} cy={cy} r={band.r} />)}
    {bands.map((band) => <text class={`dtc-ring-label is-${band.tone}`} x={cx} y={band.labelY} text-anchor="middle">{band.name} · {band.price}</text>)}
    {drawn.map((item) => <g class:list={['dtc-route', item.paid ? 'is-paid' : 'is-free']} data-dtc-route={item.slot} data-stops={item.stops.join(',')}>
      {item.hops.map((hop) => <path class="dtc-hop" data-hop={hop.hop} d={hop.d} marker-end={`url(#${id}-arrow-${item.paid ? 'paid' : 'free'})`} />)}
      <circle class="dtc-packet" r="5" style={`offset-path:path('${item.track}')`} />
    </g>)}
    {shown.map((node) => {
      const { x, y } = point(node);
      const label = labelAt(node);
      const faint = !onRoute.has(node) && !context.includes(node);
      return <g class:list={['dtc-node', node === 'app' && 'is-app', DEVICES.has(node) && 'is-device', faint && 'is-faint']}>
        {DEVICES.has(node) ? <rect x={x - 7} y={y - 7} width="14" height="14" rx="3" transform={`rotate(45 ${x} ${y})`} /> : <circle cx={x} cy={y} r={node === 'app' ? 9 : 7} />}
        <text x={label.x} y={label.y} text-anchor={label.anchor}>{NODES[node].label}</text>
      </g>;
    })}
    {drawn.map((item) => <g class="dtc-chips" data-dtc-route={item.slot}>
      {item.hops.flatMap((hop) => hop.chips.map((chip) => <g class={`dtc-chip is-${chip.tone}`} data-hop={hop.hop}>
        <rect x={chip.x - chip.width / 2} y={chip.y - 8} width={chip.width} height="16" rx="8" />
        <text x={chip.x} y={chip.y + 3.6} text-anchor="middle">{chip.text}</text>
      </g>))}
      {item.badge && <g class="dtc-badge"><circle cx={item.badge.x} cy={item.badge.y} r="8" /><text x={item.badge.x} y={item.badge.y + 3.6} text-anchor="middle">{item.badge.text}</text></g>}
    </g>)}
  </g>
</svg>
