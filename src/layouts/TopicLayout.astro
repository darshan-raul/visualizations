---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';
import TopicHeader from '../components/TopicHeader.astro';
import SectionNav from '../components/SectionNav.astro';
import SourcesList from '../components/SourcesList.astro';
import RelatedVisuals from '../components/RelatedVisuals.astro';
import '../styles/topic.css';

const { topic, sections } = Astro.props;
const data = topic.data;
const topics = await getCollection('topics');
---

<BaseLayout title={data.title} description={data.summary}>
  <div class="topic-shell shell">
    <TopicHeader topic={topic} />

    <div class="topic-layout">
      <SectionNav sections={sections} />
      <article class="topic-content">
        <slot />
        {data.sources?.length > 0 && <SourcesList sources={data.sources} />}
        <RelatedVisuals currentTopic={topic} topics={topics} />
      </article>
    </div>
  </div>
</BaseLayout>
