---
import '../styles/global.css';
import SiteConsoleFrame from '../components/SiteConsoleFrame.astro';

interface Props {
  title?: string;
  description?: string;
  chrome?: boolean;
}

const {
  title = 'Infra Illustrated',
  description = 'Visual deep dives into cloud infrastructure.',
  chrome = true,
} = Astro.props;

const pageTitle = title === 'Infra Illustrated' ? title : `${title} · Infra Illustrated`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090c13" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="ambient" aria-hidden="true"></div>
    {chrome ? <SiteConsoleFrame><slot /></SiteConsoleFrame> : <main id="main-content"><slot /></main>}
  </body>
</html>
