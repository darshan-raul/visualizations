---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LibraryExplorer from '../components/LibraryExplorer.astro';
import '../styles/spatial-home.css';

const topics = (await getCollection('topics')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title));
---

<BaseLayout>
  <section class="spatial-home" id="library">
    <h1 class="sr-only">Infra Illustrated — explore cloud infrastructure by topic</h1>
    <LibraryExplorer topics={topics} enableMap defaultView="map" immersive />
    <a class="spatial-catalogue" href="/visualizations?view=list">Browse the library <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
