---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/linux.css';
const topic = await getEntry('topics', 'linux');
if (!topic) throw new Error('Linux foundation content is missing.');
const { Content } = await render(topic);
---
<BaseLayout title={topic.data.title} description={topic.data.summary} chrome={false}><Content /></BaseLayout>
