---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../components/eni/eni-shared.css';
import '../../../styles/rds-workbench.css';
import '../../../styles/eni-workbench.css';

const topic = await getEntry('topics', 'aws-eni');
if (!topic) throw new Error('AWS ENI topic content was not found.');
const { Content } = await render(topic);
---

<BaseLayout title={topic.data.title} description={topic.data.summary} chrome={false}>
  <Content />
</BaseLayout>
