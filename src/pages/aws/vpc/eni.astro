---
import { getEntry, render } from 'astro:content';
import TopicLayout from '../../../layouts/TopicLayout.astro';

const topic = await getEntry('topics', 'aws-eni');
if (!topic) throw new Error('AWS ENI topic content was not found.');
const { Content, headings } = await render(topic);
const sections = headings.filter((heading) => heading.depth === 2).map(({ slug, text }) => ({ id: slug, label: text }));
---

<TopicLayout topic={topic} sections={sections}>
  <Content />
</TopicLayout>
