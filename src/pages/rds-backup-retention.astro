---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/rds-workbench.css';

const topic = await getEntry('topics', 'rds-backup-retention');
if (!topic) throw new Error('RDS Backup Retention content is missing');
const { Content } = await render(topic);
---

<BaseLayout title={topic.data.title} description={topic.data.summary} chrome={false}>
  <Content />
</BaseLayout>
