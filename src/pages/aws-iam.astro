---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/lesson-console.css';
import '../styles/aws-iam.css';
const topic = await getEntry('topics', 'aws-iam');
if (!topic) throw new Error('AWS IAM content is missing');
const { Content } = await render(topic);
---
<BaseLayout title={topic.data.title} description={topic.data.summary} chrome={false}>
  <Content published={topic.data.published} reviewed={topic.data.reviewed} />
</BaseLayout>
