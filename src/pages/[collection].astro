---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LibraryExplorer from '../components/LibraryExplorer.astro';
import { collectionGroups, collections, type CollectionSlug } from '../lib/catalog';

export function getStaticPaths() {
  return Object.keys(collections).map((collection) => ({ params: { collection } }));
}

const slug = Astro.params.collection as CollectionSlug;
const collection = collections[slug];
const topics = (await getCollection('topics', ({ data }) => data.collection === slug))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const groups = collectionGroups[slug]?.map((group) => ({
  ...group,
  topics: topics.filter((topic) => topic.data.group === group.id).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)),
}));
const ungrouped = groups ? topics.filter((topic) => !groups.some((group) => group.id === topic.data.group) || !topic.data.order) : [];
if (ungrouped.length) throw new Error(`${slug} topics need a known group and an order: ${ungrouped.map((topic) => topic.data.slug).join(', ')}`);
---

<BaseLayout title={collection.label} description={collection.description}>
  <section class={`page-intro collection-intro collection-${slug} shell`}>
    <div>
      <nav class="discovery-crumb" aria-label="Breadcrumb"><a href="/">Library</a><span aria-hidden="true">/</span><span aria-current="page">{collection.label}</span></nav>
      <span class="eyebrow"><i></i> {collection.eyebrow}</span>
      <h1>{collection.label}</h1>
      <p>{collection.description}</p>
      <div class="intro-meta"><span>{topics.length} visualizations</span><span>Open any topic directly</span><a href={`/visualizations?view=map&collection=${slug}`}>View in topic map ↗</a></div>
    </div>
    <aside class="page-intro-context" aria-label="Collection details">
      <span>COLLECTION</span>
      <strong>{collection.label}</strong>
      <span>{String(topics.length).padStart(2, '0')} REFERENCES · LIVE INDEX</span>
    </aside>
  </section>
  <section class="catalogue-section shell">
    <LibraryExplorer topics={groups ? groups.flatMap((group) => group.topics) : topics} groups={groups} compact />
  </section>
</BaseLayout>
