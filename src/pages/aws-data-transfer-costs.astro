---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/dtc-console.css';

const entry = await getEntry('topics', 'aws-data-transfer-costs');
if (!entry) throw new Error('AWS data transfer costs topic content is missing.');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} chrome={false}>
  <Content published={entry.data.published} reviewed={entry.data.reviewed} />
</BaseLayout>
