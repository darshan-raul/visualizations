---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/lesson-console.css';
import '../styles/secops.css';

const entry = await getEntry('topics', 'secopspipeline');
if (!entry) throw new Error('DevSecOps pipeline content is missing.');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} chrome={false}>
  <Content published={entry.data.published} reviewed={entry.data.reviewed} />
</BaseLayout>
