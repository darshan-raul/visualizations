---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/lesson-console.css';
import '../styles/identity.css';
import '../styles/identity-pipeline.css';
import '../styles/iam-pillars.css';

const entry = await getEntry('topics', 'aws-identity-credential-flows');
if (!entry) throw new Error('The identity topic content is missing.');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} chrome={false}>
  <Content published={entry.data.published} reviewed={entry.data.reviewed} />
</BaseLayout>
