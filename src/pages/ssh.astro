---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/protocol-console.css';
const entry = await getEntry('topics', 'ssh');
if (!entry) throw new Error('SSH topic metadata is missing.');
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.summary} chrome={false}><Content published={entry.data.published} reviewed={entry.data.reviewed} /></BaseLayout>
