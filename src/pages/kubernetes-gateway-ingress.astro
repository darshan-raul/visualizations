---
import { getEntry, render } from 'astro:content';
import TopicLayout from '../layouts/TopicLayout.astro';
import '../styles/k8s.css';
const topic = await getEntry('topics', 'kubernetes-gateway-ingress');
if (!topic) throw new Error('Kubernetes Gateway API and Ingress content is missing');
const { Content, headings } = await render(topic);
const sections = headings.filter(({ depth }) => depth === 2).map(({ slug, text }) => ({ id: slug, label: text }));
---
<TopicLayout topic={topic} sections={sections}><Content /></TopicLayout>
